<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.andr36oid.usbmode"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.UPDATE_LOCK_TASK_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <uses-permission android:name="android.permission.NETWORK_STACK" />

    <application
        android:name=".UsbDriveApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_usb_mode"
        android:label="@string/usb_mode_title"
        android:supportsRtl="true">

        <activity
            android:name=".UsbDriveActivity"
            android:exported="false"
            android:label="@string/usb_device_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings" />

        <activity
            android:name=".ControllerActivity"
            android:exported="false"
            android:label="@string/usb_device_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings" />
        <activity
            android:name=".ControllerSessionActivity"
            android:exported="false"
            android:label="@string/usb_device_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings" />

        <!-- Injected into the top level of the Settings app, right below CPU overclock.
             Also opened by a long press on the tile. -->
        <activity
            android:name=".UsbModeActivity"
            android:exported="true"
            android:label="@string/usb_mode_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-64" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="top_level_usb_mode" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/usb_mode_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_usb_mode" />
            <meta-data
                android:name="com.android.settings.bg.hint"
                android:resource="@color/usb_mode_icon_background" />
        </activity>

        <!-- "What did I plug in?": every USB device with a plain name and whether it
             works. In Network & internet (Wi-Fi and Ethernet adapters) and, through the
             alias, in Connected devices (pads, sound cards, drives). -->
        <activity
            android:name=".UsbCheckActivity"
            android:exported="true"
            android:label="@string/usb_check_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.wireless" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-20" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="usb_check_network" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/usb_check_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_usb_mode" />
        </activity>
        <activity-alias
            android:name=".UsbCheckConnectedDevices"
            android:targetActivity=".UsbCheckActivity"
            android:exported="true"
            android:label="@string/usb_check_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.connect" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-20" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="usb_check_connected" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/usb_check_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_usb_mode" />
        </activity-alias>

        <!-- Runs while the port is a device, switches it back when a charger is plugged in -->
        <service
            android:name=".UsbModeService"
            android:exported="false" />

        <service android:name=".UsbLinkService" android:exported="false" />
        <receiver android:name=".UsbLinkService$Receiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </receiver>

        <!-- Off until the USB mode is changed for the first time, see UsbMode.showTile() -->
        <service
            android:name=".UsbModeTileService"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_usb_mode"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
