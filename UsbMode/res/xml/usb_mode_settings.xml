<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <SwitchPreference
        android:key="device"
        android:persistent="false"
        android:title="@string/usb_mode_switch" />

    <ListPreference
        android:key="functions"
        android:title="@string/usb_mode_functions"
        android:dialogTitle="@string/usb_mode_functions"
        android:entries="@array/usb_mode_functions_entries"
        android:entryValues="@array/usb_mode_functions_values"
        android:defaultValue="mtp"
        android:summary="%s" />

    <Preference
        android:key="usb_drive"
        android:title="@string/usb_drive_title">
        <intent
            android:targetPackage="org.andr36oid.usbmode"
            android:targetClass="org.andr36oid.usbmode.UsbDriveActivity" />
    </Preference>

    <Preference
        android:key="usb_check"
        android:title="@string/usb_check_title"
        android:summary="@string/usb_check_link_summary">
        <intent
            android:targetPackage="org.andr36oid.usbmode"
            android:targetClass="org.andr36oid.usbmode.UsbCheckActivity" />
    </Preference>

    <Preference
        android:key="flipper"
        android:title="@string/flipper_title"
        android:summary="@string/flipper_summary">
        <intent
            android:targetPackage="org.andr36oid.flipper.r36s"
            android:targetClass="org.andr36oid.flipper.MainActivity" />
    </Preference>

    <Preference
        android:key="about"
        android:selectable="false"
        android:summary="@string/usb_mode_about" />
</PreferenceScreen>
