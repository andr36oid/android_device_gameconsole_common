// Settings > USB mode and its Quick Settings tile. Runs as the system user,
// which init gives the usb2 phy's otg_mode file to.
android_app {
    name: "UsbMode",
    static_libs: ["andr36oid-hint-bar"],
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}

cc_binary {
    name: "andr36oid-controller",
    srcs: ["controller/main.cpp", "controller/Controller.cpp", "controller/Keyboard.cpp"],
    static_libs: ["libjoymouse"],
    shared_libs: ["liblog"],
    cpp_std: "c++17",
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
