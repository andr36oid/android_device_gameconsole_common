<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape><solid android:color="@android:color/transparent" /><corners android:radius="8dp" /><stroke android:width="2dp" android:color="?android:attr/colorAccent" /></shape></item>
            <item android:left="4dp" android:right="4dp" android:top="4dp" android:bottom="4dp"><shape><solid android:color="?android:attr/colorAccent" /><corners android:radius="4dp" /></shape></item>
        </layer-list>
    </item>
    <item><inset android:inset="4dp"><shape><solid android:color="?android:attr/colorAccent" /><corners android:radius="4dp" /></shape></inset></item>
</selector>
