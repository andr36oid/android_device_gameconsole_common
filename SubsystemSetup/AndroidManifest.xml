<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.andr36oid.subsystemsetup"
    android:versionCode="34"
    android:versionName="11"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_MEDIA_STORAGE" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_subsystem"
        android:label="@string/subsystem_title"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true">

        <!-- Injected into Settings > System. The root broker handles the handoff. -->
        <activity
            android:name=".SubsystemSetupActivity"
            android:exported="true"
            android:label="@string/subsystem_title"
            android:theme="@style/SubsystemTheme">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/subsystem_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_subsystem" />
        </activity>

        <activity android:name=".LaunchPortActivity" android:exported="true"
            android:excludeFromRecents="true" android:noHistory="true"
            android:theme="@style/SubsystemTheme">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name=".RetroArchActivity" android:exported="true" android:theme="@style/SubsystemTheme" />
        <activity android:name=".EmulationStationActivity" android:exported="false" android:theme="@style/SubsystemTheme" />
        <!-- The one launcher entry. Daijishou 1.5.0 checks MAIN/LAUNCHER package
             membership even when launching an explicit activity, so this must
             be enabled whenever an image exists or Ports/cores stop launching.
             SubsystemSetupActivity.updateLauncher hides it only after a scan
             found no image, and decides again at every start. It shows as
             EmulationStation and opens ES when the image is ready. -->
        <activity-alias
            android:name=".DaijishouPlayerLauncher"
            android:targetActivity=".EmulationStationActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_emulationstation"
            android:label="@string/asl_es">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Shown by BootReceiver after the broker finds an image. -->
        <activity
            android:name=".SubsystemBootActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/subsystem_boot_default"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/subsystem_boot_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_subsystem" />
        </activity>

        <service android:name=".PrestageJob" android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
