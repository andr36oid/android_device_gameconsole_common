<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="app_title">Emülatör dosyaları</string>
    <string name="app_summary">Oyun açılmıyor mu? Bazı sistemlerin gerektirdiği BIOS dosyalarını kontrol edin</string>

    <!-- The main page -->
    <string name="intro">Bazı sistemlerin oyunları, orijinal konsoldan alınmış bir dosya (BIOS) olmadan açılmaz. Bu dosyaları EASYROMS\'taki bios klasörüne koyun.</string>
    <!-- The same, for a card set up without EASYROMS (.noroms) -->
    <string name="intro_internal">Bazı sistemlerin oyunları, orijinal konsoldan alınmış bir dosya (BIOS) olmadan açılmaz. Bu dosyaları dahili depolamadaki bios klasörüne koyun.</string>
    <string name="checking">Kontrol ediliyor…</string>
    <string name="check_failed">Kontrol yapılamadı. Konsolu yeniden başlatıp tekrar deneyin.</string>
    <string name="no_easyroms_title">EASYROMS şu anda kullanılamıyor</string>
    <string name="no_easyroms_summary">EASYROMS bölümünün olduğu SD kartı geri takın, sonra bu sayfayı yeniden açın.</string>
    <string name="systems_category">Sistemler</string>

    <string name="fix_title">Dosya adlarını düzelt</string>
    <!-- %1$d: number of files -->
    <plurals name="fix_summary">
        <item quantity="one">%1$d dosyanın adı yanlış, bu yüzden emülatörler onu bulamıyor</item>
        <item quantity="other">%1$d dosyanın adı yanlış, bu yüzden emülatörler onları bulamıyor</item>
    </plurals>
    <string name="fix_dialog_title">Dosya adları düzeltilsin mi?</string>
    <!-- %1$s: one line per file, made of fix_line -->
    <string name="fix_dialog_message">EASYROMS\'taki bios klasöründe:\n\n%1$s</string>
    <string name="fix_dialog_message_internal">Dahili depolamadaki bios klasöründe:\n\n%1$s</string>
    <!-- %1$s: the file's name now, %2$s: the right name -->
    <string name="fix_line">%1$s → %2$s\n</string>
    <string name="fix_button">Yeniden adlandır</string>
    <plurals name="fix_done">
        <item quantity="one">%1$d dosya yeniden adlandırıldı.</item>
        <item quantity="other">%1$d dosya yeniden adlandırıldı.</item>
    </plurals>
    <plurals name="fix_failed">
        <item quantity="one">%1$d dosya yeniden adlandırılamadı.</item>
        <item quantity="other">%1$d dosya yeniden adlandırılamadı.</item>
    </plurals>

    <!-- A system's summary. %1$s: file names -->
