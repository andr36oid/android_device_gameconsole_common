    <string name="state_missing_one_of">Eksik. Bunlardan biri yeterli</string>
    <string name="state_missing_optional">Eksik, isteğe bağlı</string>
    <string name="state_wrong_version">Yanlış sürüm: oyunlar açılmayabilir</string>
