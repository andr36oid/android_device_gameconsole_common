    <string name="level_missing_one_of">Eksik: %1$s veya benzeri</string>
    <string name="level_wrong_version">Yanlış sürüm: %1$s. Oyunlar açılmayabilir</string>
    <string name="level_wrong_name">Bir dosyanın adı yanlış. Dosya adlarını düzelt\'i kullanın</string>

