<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_title">Emulator files</string>
    <string name="app_summary">Game won\'t start? Check the BIOS files some systems need</string>

    <!-- The main page -->
    <string name="intro">Some systems need a file from the original console (a BIOS) before their games start. Put these files in the bios folder on EASYROMS.</string>
    <string name="checking">Checking…</string>
    <string name="check_failed">The check couldn\'t run. Restart the console and try again.</string>
    <string name="no_easyroms_title">EASYROMS isn\'t available right now</string>
    <string name="no_easyroms_summary">Put the SD card with the EASYROMS partition back in, then open this page again.</string>
    <string name="systems_category">Systems</string>

    <string name="fix_title">Fix file names</string>
    <!-- %1$d: number of files -->
    <plurals name="fix_summary">
        <item quantity="one">%1$d file has the wrong name, so the emulators can\'t find it</item>
        <item quantity="other">%1$d files have the wrong name, so the emulators can\'t find them</item>
    </plurals>
    <string name="fix_dialog_title">Rename these files?</string>
    <!-- %1$s: one line per file, made of fix_line -->
    <string name="fix_dialog_message">In the bios folder on EASYROMS:\n\n%1$s</string>
    <!-- %1$s: the file\'s name now, %2$s: the right name -->
    <string name="fix_line">%1$s → %2$s\n</string>
    <string name="fix_button">Rename</string>
    <plurals name="fix_done">
        <item quantity="one">Renamed %1$d file.</item>
        <item quantity="other">Renamed %1$d files.</item>
    </plurals>
    <plurals name="fix_failed">
        <item quantity="one">%1$d file couldn\'t be renamed.</item>
        <item quantity="other">%1$d files couldn\'t be renamed.</item>
    </plurals>

    <!-- A system\'s summary. %1$s: file names -->
    <string name="level_ready">Ready</string>
    <string name="level_not_needed">Optional: not needed to play</string>
    <string name="level_missing">Missing: %1$s</string>
    <string name="level_missing_one_of">Missing: %1$s or similar</string>
    <string name="level_wrong_version">Wrong version: %1$s. Games may not start</string>
    <string name="level_wrong_name">A file has the wrong name. Use Fix file names</string>

    <!-- A file on the system page -->
    <string name="state_found">Found</string>
    <string name="state_missing_needed">Missing, needed</string>
    <string name="state_missing_one_of">Missing. One of these is enough</string>
    <string name="state_missing_optional">Missing, optional</string>
    <string name="state_wrong_version">Wrong version: games may not start</string>
    <!-- %1$s: what the file really is -->
    <string name="state_wrong_version_is">Wrong file: this is %1$s. Use Fix file names</string>
    <!-- %1$s: its name now, maybe with a subfolder -->
    <string name="state_wrong_name">Found as %1$s. Use Fix file names</string>

    <!-- A file\'s details (A on a file) -->
    <string name="details_what">What it is: %1$s</string>
    <string name="details_cores">Used by: %1$s</string>
    <string name="details_md5">Right file\'s MD5: %1$s</string>
    <string name="details_md5_any">Any file with this name works</string>
    <!-- %1$s: path, %2$s: its MD5 -->
    <string name="details_file">Your file: %1$s\nIts MD5: %2$s</string>
    <string name="details_file_big">Your file: %1$s\nToo big to be this file</string>
    <string name="close">Close</string>

    <string name="path_easyroms">EASYROMS</string>
</resources>
