# Settings > System > Kernel Tweaks, see andr36oid-ktweaks.sh

on post-fs-data
    mkdir /data/misc/andr36oid-ktprofiles 0770 system system

# note the defaults and apply the saved tweaks as soon as they are loaded
on property:ro.persistent_properties.ready=true
    start andr36oid-ktweaks-boot

# Wi-Fi HAL loads RK915 after persistent properties, and may reload it later.
# Reapply saved runtime knobs once its nodes exist; do not rerun boot counters.
on property:wlan.driver.status=ok && property:sys.andr36oid.kt.ready=1
    start andr36oid-ktweaks

# the start finished: the boot protection starts counting again
on property:sys.boot_completed=1
    setprop persist.andr36oid.kt.tries 0

service andr36oid-ktweaks-boot /system/bin/sh /system/etc/andr36oid-ktweaks.sh boot
    user root
    group root system
    disabled
    oneshot

# started by the app with ctl.start after a change
service andr36oid-ktweaks /system/bin/sh /system/etc/andr36oid-ktweaks.sh apply
    user root
    group root system
    disabled
    oneshot

# Copies profile files between the app and BOOT, EASYROMS or Download.
service andr36oid-ktprofiles /system/bin/sh /system/etc/andr36oid-ktweaks.sh profiles
    user root
    group root system media_rw
    disabled
    oneshot
