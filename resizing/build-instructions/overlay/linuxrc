#!/bin/sh

export PATH=/usr/bin:/bin:/usr/sbin:/sbin
/bin/busybox --install -s

/bin/busybox mount -t proc /proc /proc
/bin/busybox mount -t sysfs none /sys

echo /sbin/mdev >/proc/sys/kernel/hotplug
mdev -s

for _ in $(seq 1 100); do
	[ -e "/dev/fb0" ] && break
	/bin/busybox sleep 0.1
done

[ -e "/sys/class/graphics/fb0/modes" ] || return
[ -z "$(cat /sys/class/graphics/fb0/mode)" ] || return

_mode="$(cat /sys/class/graphics/fb0/modes)"
echo "Setting framebuffer mode to: $_mode"
echo "$_mode" > /sys/class/graphics/fb0/mode


mount -t auto -v /dev/mmcblk0p1 /mnt
NOROMS=0
[ -f /mnt/rk3326-r36s-android.dtb ] && DEVICE=1 && echo "R36S Detected"
[ -f /mnt/rk3326-r36plus-android.dtb ] && DEVICE=2 && echo "R36Plus Detected"
[ -f /mnt/rk3326-r50s-android.dtb ] && DEVICE=3 && echo "R50S Detected"
[ -f /mnt/.noroms ] && NOROMS=1 && echo "Will not create ROMS partition!"

if [ $DEVICE = 1 ]; then
    cp /resizing_480.ppm /tmp/resizing.ppm
fi

if [ $DEVICE = 2 ]; then
    cp /resizing_720.ppm /tmp/resizing.ppm
fi

if [ $DEVICE = 3 ]; then
    cp /resizing_854.ppm /tmp/resizing.ppm
fi

/sbin/busybox-armv8l fbsplash -s /tmp/resizing.ppm

#umount /dev/mmcblk0p*

busybox sleep 1

#fsck system
fsck /dev/mmcblk0p2
busybox sleep 1

# userdata size. Order of choice:
#  - .noroms on BOOT: the whole card goes to userdata, no EASYROMS;
#  - userdata-size.txt on BOOT (written by the SD card flasher): a whole
#    number of GiB, or "all";
#  - otherwise half of the free space, at least 8 GiB and at most 64 GiB.
# If that would leave EASYROMS with less than 1 GiB, userdata gets everything.
# BEGIN plan_userdata
GIB=2097152
USERDATA_START=5701009
plan_userdata() {
    # $1: card size in 512-byte sectors, $2: wish ("" / "all" / GiB number)
    # Sets USERDATA_END and NOROMS. The backup GPT needs the last 34 sectors.
    _last=$(($1 - 34))
    _free=$((_last - USERDATA_START + 1))
    case "$2" in
        all) NOROMS=1 ;;
        "") _want=$((_free / 2))
            [ "$_want" -lt $((8 * GIB)) ] && _want=$((8 * GIB))
            [ "$_want" -gt $((64 * GIB)) ] && _want=$((64 * GIB)) ;;
        *[!0-9]*) echo "Ignoring bad userdata size: $2"
            plan_userdata "$1" ""; return ;;
        *) _want=$(($2 * GIB))
            [ "$_want" -lt $((4 * GIB)) ] && _want=$((4 * GIB)) ;;
    esac
    if [ "$NOROMS" != 1 ]; then
        # End userdata so that EASYROMS starts on a 1 MiB boundary
        USERDATA_END=$(( (USERDATA_START + _want) / 2048 * 2048 - 1 ))
        [ $((_last - USERDATA_END)) -lt "$GIB" ] && NOROMS=1
    fi
    [ "$NOROMS" = 1 ] && USERDATA_END=$_last
}
# END plan_userdata

CARD_SECTORS=$(cat /sys/block/mmcblk0/size)
WISH=""
[ -f /mnt/userdata-size.txt ] && WISH=$(tr -d ' \r\n' < /mnt/userdata-size.txt | tr 'A-Z' 'a-z')
WISH=${WISH%gib}; WISH=${WISH%gb}; WISH=${WISH%g}
plan_userdata "$CARD_SECTORS" "$WISH"
echo "Parted Stage: card ${CARD_SECTORS}s, wish '$WISH', userdata ${USERDATA_START}s-${USERDATA_END}s, NOROMS=$NOROMS" >> /mnt/error.log 2>&1

printf "fix\n" | parted ---pretend-input-tty /dev/mmcblk0 print
parted -s /dev/mmcblk0 mkpart userdata f2fs ${USERDATA_START}s ${USERDATA_END}s >> /mnt/error.log 2>&1
if [ "$NOROMS" = 0 ]; then
    # Create next partition (number auto-assigned)
    parted -s /dev/mmcblk0 mkpart EASYROMS fat32 $((USERDATA_END + 1))s 100% >> /mnt/error.log 2>&1
fi

busybox sleep 1

sync
partprobe /dev/mmcblk0 >> /mnt/error.log 2>&1
partprobe >> /mnt/error.log 2>&1
busybox sleep 1
sync

sleep 4

echo "Resizing starting"
mkfs.f2fs /dev/mmcblk0p6 >> /mnt/error.log 2>&1

if [ $NOROMS = 0 ]; then
    mkfs.exfat /dev/mmcblk0p7 -n EASYROMS >> /mnt/error.log 2>&1
fi

sync

sleep 4
sleep 1

#mkdir /mnt
#mount -t auto -v /dev/mmcblk0p1 /mnt 
sync

echo "Switching to Android Boot"
mv /mnt/boot.ini /mnt/boot.ini-resize
cp /mnt/boot.ini-android /mnt/boot.ini

if [ $DEVICE = 1 ]; then
    cp /resized_480.ppm /tmp/resized.ppm
fi

if [ $DEVICE = 2 ]; then
    cp /resized_720.ppm /tmp/resized.ppm
fi

if [ $DEVICE = 3 ]; then
    cp /resized_854.ppm /tmp/resized.ppm
fi

/sbin/busybox-armv8l fbsplash -s /tmp/resized.ppm

sleep 5
umount /mnt
umount /proc
umount /sys

busybox reboot

busybox reboot -f

reboot

reboot -f

echo "Didn't reboot????"

echo /sbin/mdev >/proc/sys/kernel/hotplug
mdev -s

mount -t auto -v /dev/mmcblk0p1 /mnt
sync
echo "Failed to reboot, init will end and kernel will panic." > /mnt/rebootfailed.log
sync
umount /mnt
sleep 4
echo "End"
