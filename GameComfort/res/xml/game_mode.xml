<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Not saved here, it shows the live state -->
    <SwitchPreference
        android:key="game_mode_now"
        android:persistent="false"
        android:summary="@string/game_mode_now_summary"
        android:title="@string/game_mode_now" />

    <SwitchPreference
        android:key="game_mode_automatic"
        android:defaultValue="false"
        android:summary="@string/game_mode_automatic_summary"
        android:title="@string/game_mode_automatic" />

    <!-- Removed when the performance profiles aren't installed -->
    <ListPreference
        android:key="game_mode_profile"
        android:defaultValue="-1"
        android:entries="@array/game_mode_profile_entries"
        android:entryValues="@array/game_mode_profile_values"
        android:summary="%s"
        android:title="@string/game_mode_profile" />

    <!-- Removed with the profile list, the performance profiles app does the work -->
    <SwitchPreference
        android:key="game_mode_steady_memory"
        android:defaultValue="true"
        android:summary="@string/game_mode_steady_memory_summary"
        android:title="@string/game_mode_steady_memory" />

    <Preference
        android:key="about"
        android:selectable="false"
        android:summary="@string/game_mode_about" />

    <PreferenceCategory
        android:key="continue"
        android:title="@string/continue_category">

        <!-- Title and summary set in code; pressing it continues the game -->
        <Preference
            android:key="continue_now"
            android:persistent="false"
            android:title="@string/continue_now_none" />

        <SwitchPreference
            android:key="continue_on_boot"
            android:defaultValue="false"
            android:summary="@string/continue_on_boot_summary"
            android:title="@string/continue_on_boot" />

        <Preference
            android:key="continue_about"
            android:selectable="false"
            android:summary="@string/continue_about" />
    </PreferenceCategory>
</PreferenceScreen>
