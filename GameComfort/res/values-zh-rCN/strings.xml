<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <string name="app_name">游戏辅助</string>

    <!-- Low battery warning, Settings > Battery -->
    <string name="warning_title">低电量警告</string>
    <string name="warning_summary">在游戏画面上方提醒，让您及时存档</string>
    <string name="warning_when">提醒时机</string>
    <string-array name="warning_entries">
        <item>关闭</item>
        <item>30%、20%、15% 和 5%</item>
        <item>15% 和 5%</item>
        <item>仅 5%</item>
    </string-array>
    <string name="warning_preview">显示测试警告</string>
    <string name="warning_about">全屏玩游戏时，Android 自带的低电量通知很容易被忽略。此功能会改为在屏幕顶部显示一条简短的横幅，在掌机使用电池供电时，每个电量档位提醒一次。它不会抢走游戏的按键操作。\n\n电池耗尽时掌机会自动关机，未保存的进度都会丢失。</string>

    <!-- The banner on top of the game -->
    <string name="banner_charge_text">电量 <xliff:g id="percent">%1$d</xliff:g>%% - 请尽快充电</string>
    <string name="banner_text">电量 <xliff:g id="percent">%1$d</xliff:g>%% - 请立即存档</string>

    <!-- Game mode, Settings home page and Quick Settings tile -->
    <string name="game_mode_title">游戏模式</string>
    <string name="game_mode_summary">玩游戏时开启勿扰模式并屏蔽弹出通知</string>
    <string name="game_mode_now">游戏模式</string>
    <string name="game_mode_now_summary">开启勿扰模式（仅限优先事项），并阻止通知在游戏画面上弹出</string>
    <string name="game_mode_automatic">自动开启</string>
    <string name="game_mode_automatic_summary">打开游戏或模拟器时开启，离开时关闭</string>
    <string name="game_mode_profile">游戏时的性能模式</string>
    <string-array name="game_mode_profile_entries">
        <item>不更改</item>
        <item>性能</item>
        <item>均衡</item>
        <item>省电</item>
    </string-array>
    <string name="game_mode_about">游戏模式结束后，勿扰模式和弹出通知会恢复原来的状态。如果您在此期间自己更改了勿扰模式，则保留您的更改。\n\n如果应用声明自己是游戏，或属于 RetroArch、PPSSPP 等常见模拟器，就会被视为游戏。\n\n原来的性能模式也会恢复，除非您在游戏时选择了其他模式。\n\n勿扰模式允许哪些内容通过，可在“设置 &gt; 声音 &gt; 勿扰模式”中设置。</string>
    <string name="tile_on">开启</string>
    <string name="tile_off">关闭</string>
    <string name="tile_automatic">自动</string>
    <plurals name="close_apps_done">
        <item quantity="other">已关闭 <xliff:g id="count" example="3">%d</xliff:g> 个后台应用</item>
    </plurals>
    <string-array name="warning_values" translatable="false">
        <item>off</item>
        <item>30,20,15,5</item>
        <item>15,5</item>
        <item>5</item>
    </string-array>
    <string name="warning_last">电量 3 % 时的最后提醒</string>
    <string name="warning_last_summary">开启低电量警告后始终有效。此提醒显示时间更长，因为掌机很快就会自动关机。</string>
    <string name="banner_last_text">电量 <xliff:g id="percent">%1$d</xliff:g> %% - 请立即保存游戏。掌机即将自动关机。</string>
    <string-array name="game_mode_profile_values" translatable="false">
        <item>-1</item>
        <item>2</item>
        <item>1</item>
        <item>0</item>
    </string-array>
    <string name="game_mode_steady_memory">稳定内存速度</string>
    <string name="game_mode_steady_memory_summary">游戏期间让内存始终全速运行，避免在游戏中途变速。会略微增加耗电。</string>
    <string name="continue_title">继续</string>
    <string name="continue_tile_none">尚无游戏</string>
    <string name="continue_category">继续游戏</string>
    <string name="continue_now">继续：<xliff:g id="game">%1$s</xliff:g></string>
    <string name="continue_now_none">尚未玩过游戏</string>
    <string name="continue_now_ppsspp">PPSSPP</string>
    <string name="continue_now_app">Android 游戏</string>
    <string name="continue_on_boot">重启后再次打开</string>
    <string name="continue_on_boot_summary">如果关机时有游戏正在运行，包括电池耗尽的情况，主屏幕出现约 10 秒后会再次打开该游戏</string>
    <string name="continue_about">“继续”可一键返回上次玩的游戏：使用快捷设置中的“继续”磁贴、FN + A 或电源菜单。\n\n如果游戏仍在运行，会原样返回离开时的画面。否则，RetroArch 和 PPSSPP 会重新启动同一游戏，RetroArch 还会使用同一核心；其他游戏则只是重新打开。\n\n您将从游戏内的最后一次存档继续。存档发生变化时，RetroArch 每 10 秒写入一次。即时存档不会自动读取或写入：如果最新的即时存档比游戏内存档更新，会有消息提醒您。</string>
    <string name="continue_nothing">尚无可继续的游戏</string>
    <string name="continue_game_missing">找不到 <xliff:g id="game">%1$s</xliff:g> 的游戏文件。SD 卡插入了吗？</string>
    <string name="continue_core_missing"><xliff:g id="game">%1$s</xliff:g> 所需的 RetroArch 核心已不再安装</string>
    <string name="continue_failed">无法启动 <xliff:g id="game">%1$s</xliff:g></string>
    <string name="continue_starting">正在继续 <xliff:g id="game">%1$s</xliff:g></string>
    <string name="continue_state_hint">正在继续 <xliff:g id="game">%1$s</xliff:g>。最新的即时存档（<xliff:g id="slot">%2$s</xliff:g>）比游戏内存档更新。要使用它，请在 RetroArch 菜单（Select + X）中读取。</string>
    <string name="continue_slot">存档位 <xliff:g id="slot">%1$d</xliff:g></string>
    <string name="continue_slot_auto">自动存档</string>
</resources>
