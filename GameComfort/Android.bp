// Settings > Battery > Low battery warning: a short banner on top of games at 15 % and 5 %,
// so there is time to save before the console turns off. Runs as the system user, which
// may draw a system overlay window.
android_app {
    name: "GameComfort",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
