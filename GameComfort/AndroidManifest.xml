<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.andr36oid.gamecomfort"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REMOVE_TASKS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_battery_alert"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- Injected into Settings > Battery -->
        <activity
            android:name=".WarningActivity"
            android:exported="true"
            android:label="@string/warning_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery" />
            <!-- Same order as "Battery percentage"; ties sort by title, so this lands right
                 below it. -->
            <meta-data
                android:name="com.android.settings.order"
                android:value="6" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="low_battery_warning" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/warning_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_battery_alert" />
        </activity>

        <!-- Game mode, injected into the top level of the Settings app, in the console group.
             Also opened by a long press on the tile. -->
        <activity
            android:name=".GameModeActivity"
            android:exported="true"
            android:label="@string/game_mode_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <!-- Same order as Controller test; ties sort by title, so this lands near it
                 and before Storage (-60). -->
            <meta-data
                android:name="com.android.settings.order"
                android:value="-61" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="top_level_game_mode" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/game_mode_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_game_mode" />
            <meta-data
                android:name="com.android.settings.bg.hint"
                android:resource="@color/game_mode_icon_background" />
        </activity>

        <!-- Added to Quick Settings once, on the first boot -->
        <service
            android:name=".GameModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_game_mode"
            android:label="@string/game_mode_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- SystemUI keeps the last state and only binds on a click or when the app
                 asks for an update (GameMode.updateTile) -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Continue playing: brings back the last game and closes, no window of its own.
             Started by its tile, by the power menu and by FN + A (PhoneWindowManager). -->
        <activity
            android:name=".ContinueActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/continue_title"
            android:noHistory="true"
            android:permission="android.permission.DEVICE_POWER"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="org.andr36oid.gamecomfort.action.CONTINUE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Added to Quick Settings once, on the first boot; long press opens Game mode -->
        <service
            android:name=".ContinueTileService"
            android:exported="true"
            android:icon="@drawable/ic_continue"
            android:label="@string/continue_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Waits for battery changes while the warning is on, and watches the app in front
             (Continue playing, automatic game mode). -->
        <service
            android:name=".ComfortService"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
