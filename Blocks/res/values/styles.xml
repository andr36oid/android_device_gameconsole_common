<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full-screen dark DayNight, no action bar: the view draws every screen itself. The
         background is forced true black to match the launcher's look; the accent stays the
         user's system accent (never pinned). GameView reads textColorPrimary,
         textColorSecondary, colorAccent and colorBackground from this theme for its drawing. -->
    <style name="BlocksTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
