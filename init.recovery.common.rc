
on init
    export PATH /sbin:/system/bin
    export LD_LIBRARY_PATH /system/lib64

    export ANDROID_ROOT /system
    export ANDROID_DATA /data
    export EXTERNAL_STORAGE /sdcard

    symlink /proc/self/fd/0 /dev/stdin
    symlink /proc/self/fd/1 /dev/stdout
    symlink /proc/self/fd/2 /dev/stderr

    symlink /system/bin /bin
    symlink /system/etc /etc

    mount cgroup none /acct cpuacct
    mkdir /acct/uid

    mkdir /system
    mkdir /data
    mkdir /cache
    mkdir /sideload
    mkdir /mnt/system
    mount tmpfs tmpfs /tmp

    chown root shell /tmp
    chmod 0775 /tmp

    write /proc/sys/kernel/panic_on_oops 1
    write /proc/sys/vm/max_map_count 1000000


service console /system/bin/sh
    class core
    console
    disabled
    user root
    group shell log readproc
    seclabel u:r:shell:s0
    setenv HOSTNAME console

on property:ro.debuggable=1
    start console

# USB over configfs, as in Android: adb, sideload and the USB drive need the gadget.
# Recovery's own rc only turns it on for ro.hardware rk3326; ours is rk30board.
on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller ff300000.usb

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

# andr36oid: the fstab of whatever started, as Android picks fstab.<fstab_suffix>.
# Without a suffix (the SD card) recovery.fstab stays the SD card's.
on init && property:ro.boot.fstab_suffix=emmc
    copy /system/etc/recovery.fstab.emmc /system/etc/recovery.fstab

on init && property:ro.boot.fstab_suffix=emmcsd
    copy /system/etc/recovery.fstab.emmcsd /system/etc/recovery.fstab
    # /data is on the data card: link it as Android does, but never turn off
    start datacard

service datacard /system/bin/andr36oid-datacard --recovery
    oneshot
    disabled
    user root
    seclabel u:r:recovery:s0

# Panels mounted sideways: the same turn as SurfaceFlinger's
on early-init && property:ro.boot.sf_orientation=ORIENTATION_90
    setprop ro.minui.default_rotation ROTATION_RIGHT

on early-init && property:ro.boot.sf_orientation=ORIENTATION_270
    setprop ro.minui.default_rotation ROTATION_LEFT
