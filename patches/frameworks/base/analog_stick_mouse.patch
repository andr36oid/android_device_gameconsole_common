+    public int interceptGenericMotionEventBeforeDispatching(IBinder focusedToken,
+            MotionEvent event, int policyFlags) {
+        // Intercept right analog stick for mouse control when in mouse mode
+        mstate = SystemProperties.get("sys.KeyMouse.mKeyMouseState");
+
+        if (mstate != null && mstate.equals("on") && (event.getSource() & InputDevice.SOURCE_CLASS_JOYSTICK) != 0) {
+            // MotionEvent.AXIS_RX = 12, AXIS_RY = 13 (right analog stick per IDC mapping)
+            float rx = event.getAxisValue(12); // AXIS_RX (mapped from hardware axis 0x03)
+            float ry = event.getAxisValue(13); // AXIS_RY (mapped from hardware axis 0x04)
+
+            synchronized(mAnalogLock) {
+                lastRX = rx;
+                lastRY = ry;
+
+                // Start polling if not already active and we have significant stick input
+                if (!analogMouseActive && (Math.abs(rx) > ANALOG_DEADZONE || Math.abs(ry) > ANALOG_DEADZONE)) {
+                    analogMouseActive = true;
+                    mAnalogMouseHandler.removeMessages(MSG_ANALOG_MOUSE_POLL);
+                    mAnalogMouseHandler.sendEmptyMessage(MSG_ANALOG_MOUSE_POLL);
+                }
+                // Stop polling if stick returns to center
+                else if (analogMouseActive && Math.abs(rx) <= ANALOG_DEADZONE && Math.abs(ry) <= ANALOG_DEADZONE) {
+                    analogMouseActive = false;
+                    mAnalogMouseHandler.removeMessages(MSG_ANALOG_MOUSE_POLL);
+                }
+            }
+
+            // Consume the event so it doesn't interfere with other input
+            return -1;
+        }
+
+        // For other devices or when mouse mode is off, allow event through
+        return 0;
+    }
