# Moonlight 12.1: settings are the default shared_prefs
# (PreferenceConfiguration.readPreferences). See ../../README.md,
# "First-start settings".
package com.limelight
unless data shared_prefs/com.limelight_preferences.xml
# the stream at the screen's own size, stretched to fill it
datafill prefs.xml shared_prefs/com.limelight_preferences.xml
