<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sl_title">Status light</string>
    <string name="sl_summary">What the little light shows for battery, charging and notifications</string>
    <string name="sl_intro">The little light next to the power button. Pick what it shows when the battery gets low, while charging and when a notification comes in. It keeps working while the console sleeps, it just stops blinking.</string>
    <string name="sl_missing">This console\'s light isn\'t one we know how to control.</string>

    <!-- What the light shows right now -->
    <string name="sl_now">Right now</string>
    <!-- e.g. "Red, battery at 8 %" -->
    <string name="sl_now_battery"><xliff:g id="color">%1$s</xliff:g>, battery at <xliff:g id="level">%2$s</xliff:g> %%</string>
    <!-- e.g. "Red, charging" -->
    <string name="sl_now_charging"><xliff:g id="color">%1$s</xliff:g>, charging</string>
    <string name="sl_now_full"><xliff:g id="color">%1$s</xliff:g>, fully charged</string>
    <!-- e.g. "Blue, for a notification" -->
    <string name="sl_now_notify"><xliff:g id="color">%1$s</xliff:g>, for a notification</string>
    <string name="sl_now_check">Checking colours</string>

    <!-- Battery -->
    <string name="sl_cat_battery">Battery</string>
    <string name="sl_style">Light shows</string>
    <!-- e.g. "Red at 10 % or less" -->
    <string name="sl_style_red_low">Red at <xliff:g id="level">%1$s</xliff:g> %% or less</string>
    <!-- e.g. "Blue, red at 10 % or less" -->
    <string name="sl_style_color_red_low"><xliff:g id="color">%1$s</xliff:g>, red at <xliff:g id="level">%2$s</xliff:g> %% or less</string>
    <!-- e.g. "Blue, purple below 30 %, red at 10 %" -->
    <string name="sl_style_three"><xliff:g id="high">%1$s</xliff:g>, <xliff:g id="middle">%2$s</xliff:g> below 30 %%, red at 10 %%</string>
    <!-- e.g. "Purple below 30 %, red at 10 %" -->
    <string name="sl_style_two"><xliff:g id="middle">%1$s</xliff:g> below 30 %%, red at 10 %%</string>
    <!-- e.g. "Always blue" -->
    <string name="sl_style_always">Always <xliff:g id="color">%1$s</xliff:g></string>
    <!-- e.g. "Your own: blue · red below 11 %" -->
    <string name="sl_style_custom">Your own: <xliff:g id="rules">%1$s</xliff:g></string>
    <!-- e.g. "red below 11 %" -->
    <string name="sl_below"><xliff:g id="color">%1$s</xliff:g> below <xliff:g id="level">%2$s</xliff:g> %%</string>
    <string name="sl_blink_low">Blink when low</string>
    <string name="sl_blink_low_summary">The low battery colour blinks, so it\'s harder to miss</string>
    <!-- e.g. "Red, blinking" -->
    <string name="sl_blinking"><xliff:g id="color">%1$s</xliff:g>, blinking</string>
    <string name="sl_hardware">Leave it to the hardware</string>

    <!-- Charger -->
    <string name="sl_cat_charger">Charger</string>
    <string name="sl_charging">While charging</string>
    <string name="sl_full">When fully charged</string>
    <string name="sl_follow_battery">Battery colours, like without a charger</string>
    <string name="sl_follow_charging">Same as while charging</string>

    <!-- Notifications -->
    <string name="sl_cat_notifications">Notifications</string>
    <string name="sl_notify">Blink for notifications</string>
    <string name="sl_notify_summary">With the screen off, the light blinks while a notification is waiting. In sleep it stays lit instead.</string>
    <string name="sl_notify_colors">Colours per app</string>
    <string name="sl_notify_colors_summary">Pick a colour for each app. The light uses the closest one it can show.</string>

    <!-- Tools -->
    <string name="sl_cat_tools">Tools</string>
    <string name="sl_check">Check colours</string>
    <string name="sl_check_summary">Not seeing the colours you picked? Find out what your console\'s light can really show.</string>
    <string name="sl_reset">Back to default</string>
    <string name="sl_reset_summary">Undo everything on this page, including a colour check</string>

    <!-- Colour check -->
    <!-- %1$d is how many steps, e.g. 9 -->
    <string name="sl_check_intro">The light goes through <xliff:g id="count">%1$d</xliff:g> settings, one at a time. Each time, look at the light and pick what you see. Clones are wired in all sorts of ways, so this finds out what yours can do.</string>
    <string name="sl_check_go">Start</string>
    <!-- e.g. "What does the light show? (3 of 9)" -->
    <string name="sl_check_step">What does the light show? (<xliff:g id="step">%1$d</xliff:g> of <xliff:g id="count">%2$d</xliff:g>)</string>
    <string name="sl_check_other">Something else</string>
    <!-- e.g. "Your light can show: off, blue, red, purple." -->
    <string name="sl_check_result">Your light can show: <xliff:g id="colors">%1$s</xliff:g>.</string>
    <string name="sl_check_no_off">It can\'t switch off, only change colour. On some boards the light is wired straight to the power chip, and no software can turn it off.</string>
    <string name="sl_check_use">Use these colours</string>
    <string name="sl_check_keep">Keep the old ones</string>

    <!-- Colours -->
    <string name="color_off">Off</string>
    <string name="color_red">Red</string>
    <string name="color_green">Green</string>
    <string name="color_blue">Blue</string>
    <string name="color_purple">Purple</string>
    <string name="color_pink">Pink</string>
    <string name="color_orange">Orange</string>
    <string name="color_white">White</string>
</resources>
