<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sl_title">Durum ışığı</string>
    <string name="sl_summary">Küçük ışığın pil, şarj ve bildirimler için ne gösterdiği</string>
    <string name="sl_intro">Güç düğmesinin yanındaki küçük ışık. Pil azaldığında, şarj olurken ve bir bildirim geldiğinde ne göstereceğini seç. Konsol uyurken çalışmayı sürdürür, sadece yanıp sönmeyi keser.</string>
    <string name="sl_missing">Bu konsolun ışığını nasıl kontrol edeceğimizi bilmiyoruz.</string>

    <!-- What the light shows right now -->
    <string name="sl_now">Şu anda</string>
    <!-- e.g. "Red, battery at 8 %" -->
    <string name="sl_now_battery"><xliff:g id="color">%1$s</xliff:g>, pil <xliff:g id="level">%2$s</xliff:g> %%</string>
    <!-- e.g. "Red, charging" -->
    <string name="sl_now_charging"><xliff:g id="color">%1$s</xliff:g>, şarj oluyor</string>
    <string name="sl_now_full"><xliff:g id="color">%1$s</xliff:g>, tamamen dolu</string>
    <!-- e.g. "Blue, for a notification" -->
    <string name="sl_now_notify"><xliff:g id="color">%1$s</xliff:g>, bir bildirim için</string>
    <string name="sl_now_check">Renkler kontrol ediliyor</string>

    <!-- Battery -->
    <string name="sl_cat_battery">Pil</string>
    <string name="sl_style">Işık şunu gösterir</string>
    <!-- e.g. "Red at 10 % or less" -->
    <string name="sl_style_red_low"><xliff:g id="level">%1$s</xliff:g> %% veya altında kırmızı</string>
    <string name="sl_style_color_red_low"><xliff:g id="color">%1$s</xliff:g>, <xliff:g id="level">%2$s</xliff:g> %% veya altında kırmızı</string>
    <!-- e.g. "Blue, purple below 30 %, red at 10 %" -->
    <string name="sl_style_three"><xliff:g id="high">%1$s</xliff:g>, <xliff:g id="middle">%2$s</xliff:g> 30 %%\'un altında, 10 %%\'da kırmızı</string>
    <!-- e.g. "Purple below 30 %, red at 10 %" -->
    <string name="sl_style_two"><xliff:g id="middle">%1$s</xliff:g> 30 %%\'un altında, 10 %%\'da kırmızı</string>
    <!-- e.g. "Always blue" -->
    <string name="sl_style_always">Her zaman <xliff:g id="color">%1$s</xliff:g></string>
    <!-- e.g. "Your own: blue · red below 11 %" -->
    <string name="sl_style_custom">Kendi ayarın: <xliff:g id="rules">%1$s</xliff:g></string>
    <!-- e.g. "red below 11 %" -->
    <string name="sl_below"><xliff:g id="color">%1$s</xliff:g>, <xliff:g id="level">%2$s</xliff:g> %% altında</string>
    <string name="sl_blink_low">Azaldığında yanıp sönsün</string>
    <string name="sl_blink_low_summary">Düşük pil rengi yanıp söner, böylece gözden kaçması daha zor olur</string>
    <!-- e.g. "Red, blinking" -->
    <string name="sl_blinking"><xliff:g id="color">%1$s</xliff:g>, yanıp sönüyor</string>
    <string name="sl_hardware">Donanıma bırak</string>

    <!-- Charger -->
    <string name="sl_cat_charger">Şarj cihazı</string>
    <string name="sl_charging">Şarj olurken</string>
    <string name="sl_full">Tamamen dolduğunda</string>
    <string name="sl_follow_battery">Pil renkleri, şarj cihazı yokmuş gibi</string>
    <string name="sl_follow_charging">Şarj olurkenle aynı</string>

    <!-- Notifications -->
    <string name="sl_cat_notifications">Bildirimler</string>
    <string name="sl_notify">Bildirimler için yanıp sönsün</string>
    <string name="sl_notify_summary">Ekran kapalıyken, bir bildirim beklerken ışık yanıp söner. Uykuda ise sadece yanık kalır.</string>
    <string name="sl_notify_colors">Uygulama başına renk</string>
    <string name="sl_notify_colors_summary">Her uygulama için bir renk seç. Işık gösterebildiği en yakın rengi kullanır.</string>

    <!-- Tools -->
    <string name="sl_cat_tools">Araçlar</string>
    <string name="sl_check">Renkleri kontrol et</string>
    <string name="sl_check_summary">Seçtiğin renkleri görmüyor musun? Konsolunun ışığının gerçekte ne gösterebildiğini öğren.</string>
    <string name="sl_reset">Varsayılana dön</string>
    <string name="sl_reset_summary">Bu sayfadaki her şeyi geri alır, renk kontrolü dahil</string>

    <!-- Colour check -->
    <!-- %1$d is how many steps, e.g. 9 -->
    <string name="sl_check_intro">Işık, <xliff:g id="count">%1$d</xliff:g> ayardan birer birer geçer. Her seferinde ışığa bak ve gördüğünü seç. Klonlar türlü türlü bağlanır, bu yüzden bu, seninkinin ne yapabildiğini bulur.</string>
    <string name="sl_check_go">Başlat</string>
    <!-- e.g. "What does the light show? (3 of 9)" -->
    <string name="sl_check_step">Işık ne gösteriyor? (<xliff:g id="step">%1$d</xliff:g>/<xliff:g id="count">%2$d</xliff:g>)</string>
    <string name="sl_check_other">Başka bir şey</string>
    <!-- e.g. "Your light can show: off, blue, red, purple." -->
    <string name="sl_check_result">Işığın şunları gösterebilir: <xliff:g id="colors">%1$s</xliff:g>.</string>
    <string name="sl_check_no_off">Kapanamaz, sadece renk değiştirir. Bazı kartlarda ışık doğrudan güç çipine bağlıdır ve hiçbir yazılım onu kapatamaz.</string>
    <string name="sl_check_use">Bu renkleri kullan</string>
    <string name="sl_check_keep">Eskilerini tut</string>

    <!-- Colours -->
    <string name="color_off">Kapalı</string>
    <string name="color_red">Kırmızı</string>
    <string name="color_green">Yeşil</string>
    <string name="color_blue">Mavi</string>
    <string name="color_purple">Mor</string>
    <string name="color_pink">Pembe</string>
    <string name="color_orange">Turuncu</string>
    <string name="color_white">Beyaz</string>
</resources>
