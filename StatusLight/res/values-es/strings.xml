<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sl_title">Luz de estado</string>
    <string name="sl_summary">Qué muestra la pequeña luz para batería, carga y notificaciones</string>
    <string name="sl_intro">La pequeña luz junto al botón de encendido. Elige qué muestra cuando la batería está baja, mientras carga y cuando llega una notificación. Sigue funcionando mientras la consola duerme, solo deja de parpadear.</string>
    <string name="sl_missing">No sabemos controlar la luz de esta consola.</string>

    <!-- What the light shows right now -->
    <string name="sl_now">Ahora mismo</string>
    <!-- e.g. "Red, battery at 8 %" -->
    <string name="sl_now_battery"><xliff:g id="color">%1$s</xliff:g>, batería al <xliff:g id="level">%2$s</xliff:g> %%</string>
    <!-- e.g. "Red, charging" -->
    <string name="sl_now_charging"><xliff:g id="color">%1$s</xliff:g>, cargando</string>
    <string name="sl_now_full"><xliff:g id="color">%1$s</xliff:g>, cargada del todo</string>
    <!-- e.g. "Blue, for a notification" -->
    <string name="sl_now_notify"><xliff:g id="color">%1$s</xliff:g>, por una notificación</string>
    <string name="sl_now_check">Comprobando colores</string>

    <!-- Battery -->
    <string name="sl_cat_battery">Batería</string>
    <string name="sl_style">La luz muestra</string>
    <!-- e.g. "Red at 10 % or less" -->
    <string name="sl_style_red_low">Rojo al <xliff:g id="level">%1$s</xliff:g> %% o menos</string>
    <string name="sl_style_color_red_low"><xliff:g id="color">%1$s</xliff:g>, rojo al <xliff:g id="level">%2$s</xliff:g> %% o menos</string>
    <!-- e.g. "Blue, purple below 30 %, red at 10 %" -->
    <string name="sl_style_three"><xliff:g id="high">%1$s</xliff:g>, <xliff:g id="middle">%2$s</xliff:g> por debajo del 30 %%, rojo al 10 %%</string>
    <!-- e.g. "Purple below 30 %, red at 10 %" -->
    <string name="sl_style_two"><xliff:g id="middle">%1$s</xliff:g> por debajo del 30 %%, rojo al 10 %%</string>
    <!-- e.g. "Always blue" -->
    <string name="sl_style_always">Siempre <xliff:g id="color">%1$s</xliff:g></string>
    <!-- e.g. "Your own: blue · red below 11 %" -->
    <string name="sl_style_custom">Lo tuyo: <xliff:g id="rules">%1$s</xliff:g></string>
    <!-- e.g. "red below 11 %" -->
    <string name="sl_below"><xliff:g id="color">%1$s</xliff:g> por debajo del <xliff:g id="level">%2$s</xliff:g> %%</string>
    <string name="sl_blink_low">Parpadear cuando esté baja</string>
    <string name="sl_blink_low_summary">El color de batería baja parpadea, para que sea más difícil no verlo</string>
    <!-- e.g. "Red, blinking" -->
    <string name="sl_blinking"><xliff:g id="color">%1$s</xliff:g>, parpadeando</string>
    <string name="sl_hardware">Dejárselo al hardware</string>

    <!-- Charger -->
    <string name="sl_cat_charger">Cargador</string>
    <string name="sl_charging">Mientras carga</string>
    <string name="sl_full">Cuando está cargada del todo</string>
    <string name="sl_follow_battery">Colores de batería, como sin cargador</string>
    <string name="sl_follow_charging">Igual que mientras carga</string>

    <!-- Notifications -->
    <string name="sl_cat_notifications">Notificaciones</string>
    <string name="sl_notify">Parpadear con notificaciones</string>
    <string name="sl_notify_summary">Con la pantalla apagada, la luz parpadea mientras hay una notificación esperando. En reposo se queda encendida en vez de parpadear.</string>
    <string name="sl_notify_colors">Colores por app</string>
    <string name="sl_notify_colors_summary">Elige un color para cada app. La luz usa el más parecido que pueda mostrar.</string>

    <!-- Tools -->
    <string name="sl_cat_tools">Herramientas</string>
    <string name="sl_check">Comprobar colores</string>
    <string name="sl_check_summary">¿No ves los colores que elegiste? Descubre qué puede mostrar en realidad la luz de tu consola.</string>
    <string name="sl_reset">Volver al valor por defecto</string>
    <string name="sl_reset_summary">Deshace todo en esta página, incluida una comprobación de colores</string>

    <!-- Colour check -->
    <!-- %1$d is how many steps, e.g. 9 -->
    <string name="sl_check_intro">La luz pasa por <xliff:g id="count">%1$d</xliff:g> ajustes, uno a uno. Cada vez, mira la luz y elige lo que ves. Los clones están conectados de formas muy distintas, así que esto descubre qué puede hacer el tuyo.</string>
    <string name="sl_check_go">Empezar</string>
    <!-- e.g. "What does the light show? (3 of 9)" -->
    <string name="sl_check_step">¿Qué muestra la luz? (<xliff:g id="step">%1$d</xliff:g> de <xliff:g id="count">%2$d</xliff:g>)</string>
    <string name="sl_check_other">Otra cosa</string>
    <!-- e.g. "Your light can show: off, blue, red, purple." -->
    <string name="sl_check_result">Tu luz puede mostrar: <xliff:g id="colors">%1$s</xliff:g>.</string>
    <string name="sl_check_no_off">No puede apagarse, solo cambiar de color. En algunas placas la luz va conectada directo al chip de energía, y ningún software puede apagarla.</string>
    <string name="sl_check_use">Usar estos colores</string>
    <string name="sl_check_keep">Mantener los anteriores</string>

    <!-- Colours -->
    <string name="color_off">Apagado</string>
    <string name="color_red">Rojo</string>
    <string name="color_green">Verde</string>
    <string name="color_blue">Azul</string>
    <string name="color_purple">Morado</string>
    <string name="color_pink">Rosa</string>
    <string name="color_orange">Naranja</string>
    <string name="color_white">Blanco</string>
</resources>
