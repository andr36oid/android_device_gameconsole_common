<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sl_title">Lampu status</string>
    <string name="sl_summary">Apa yang ditunjukkan lampu status untuk baterai, pengisian, dan notifikasi</string>
    <string name="sl_intro">Lampu di tengah konsol, di bawah Fn. Pilih apa yang ditunjukkannya saat baterai lemah, saat mengisi daya, dan saat ada notifikasi masuk. Lampu ini tetap bekerja saat konsol tidur, cuma berhenti berkedip.</string>
    <string name="sl_missing">Lampu konsol ini belum kami tahu cara mengendalikannya.</string>

    <!-- What the light shows right now -->
    <string name="sl_now">Saat ini</string>
    <!-- e.g. "Red, battery at 8 %" -->
    <string name="sl_now_battery"><xliff:g id="color">%1$s</xliff:g>, baterai di <xliff:g id="level">%2$s</xliff:g> %%</string>
    <!-- e.g. "Red, charging" -->
    <string name="sl_now_charging"><xliff:g id="color">%1$s</xliff:g>, mengisi daya</string>
    <string name="sl_now_full"><xliff:g id="color">%1$s</xliff:g>, terisi penuh</string>
    <!-- e.g. "Blue, for a notification" -->
    <string name="sl_now_notify"><xliff:g id="color">%1$s</xliff:g>, untuk notifikasi</string>
    <string name="sl_now_check">Memeriksa warna</string>

    <!-- Battery -->
    <string name="sl_cat_battery">Baterai</string>
    <string name="sl_style">Lampu menunjukkan</string>
    <!-- e.g. "Red at 10 % or less" -->
    <string name="sl_style_red_low">Merah di <xliff:g id="level">%1$s</xliff:g> %% atau kurang</string>
    <string name="sl_style_color_red_low"><xliff:g id="color">%1$s</xliff:g>, merah di <xliff:g id="level">%2$s</xliff:g> %% atau kurang</string>
    <!-- e.g. "Blue, purple below 30 %, red at 10 %" -->
    <string name="sl_style_three"><xliff:g id="high">%1$s</xliff:g>, <xliff:g id="middle">%2$s</xliff:g> di bawah 30 %%, merah di 10 %%</string>
    <!-- e.g. "Purple below 30 %, red at 10 %" -->
    <string name="sl_style_two"><xliff:g id="middle">%1$s</xliff:g> di bawah 30 %%, merah di 10 %%</string>
    <!-- e.g. "Always blue" -->
    <string name="sl_style_always">Selalu <xliff:g id="color">%1$s</xliff:g></string>
    <!-- e.g. "Your own: blue · red below 11 %" -->
    <string name="sl_style_custom">Punyamu: <xliff:g id="rules">%1$s</xliff:g></string>
    <!-- e.g. "red below 11 %" -->
    <string name="sl_below"><xliff:g id="color">%1$s</xliff:g> di bawah <xliff:g id="level">%2$s</xliff:g> %%</string>
    <string name="sl_blink_low">Berkedip saat lemah</string>
    <string name="sl_blink_low_summary">Warna baterai lemah berkedip, jadi lebih sulit terlewat</string>
    <!-- e.g. "Red, blinking" -->
    <string name="sl_blinking"><xliff:g id="color">%1$s</xliff:g>, berkedip</string>
    <string name="sl_hardware">Serahkan ke hardware</string>

    <!-- Charger -->
    <string name="sl_cat_charger">Charger</string>
    <string name="sl_charging">Saat mengisi daya</string>
    <string name="sl_full">Saat terisi penuh</string>
    <string name="sl_follow_battery">Warna baterai, seperti tanpa charger</string>
    <string name="sl_follow_charging">Sama seperti saat mengisi daya</string>

    <!-- Notifications -->
    <string name="sl_cat_notifications">Notifikasi</string>
    <string name="sl_notify">Berkedip untuk notifikasi</string>
    <string name="sl_notify_summary">Saat layar mati, lampu berkedip selagi ada notifikasi yang menunggu. Saat tidur, lampu tetap menyala saja.</string>
    <string name="sl_notify_colors">Warna per app</string>
    <string name="sl_notify_colors_summary">Pilih warna untuk setiap app. Lampu memakai warna yang paling mendekati yang bisa ditunjukkannya.</string>

    <!-- Tools -->
    <string name="sl_cat_tools">Alat</string>
    <string name="sl_check">Periksa warna</string>
    <string name="sl_check_summary">Tidak melihat warna yang kamu pilih? Cari tahu apa yang sebenarnya bisa ditunjukkan lampu konsolmu.</string>
    <string name="sl_reset">Kembali ke default</string>
    <string name="sl_reset_summary">Membatalkan semua di halaman ini, termasuk pemeriksaan warna</string>

    <!-- Colour check -->
    <!-- %1$d is how many steps, e.g. 9 -->
    <string name="sl_check_intro">Lampu akan melewati <xliff:g id="count">%1$d</xliff:g> pengaturan, satu per satu. Setiap kali, lihat lampunya dan pilih apa yang kamu lihat. Clone dipasang dengan berbagai cara, jadi ini mencari tahu apa yang bisa dilakukan milikmu.</string>
    <string name="sl_check_go">Mulai</string>
    <!-- e.g. "What does the light show? (3 of 9)" -->
    <string name="sl_check_step">Apa yang ditunjukkan lampu? (<xliff:g id="step">%1$d</xliff:g> dari <xliff:g id="count">%2$d</xliff:g>)</string>
    <string name="sl_check_other">Yang lain</string>
    <!-- e.g. "Your light can show: off, blue, red, purple." -->
    <string name="sl_check_result">Lampumu bisa menunjukkan: <xliff:g id="colors">%1$s</xliff:g>.</string>
    <string name="sl_check_no_off">Lampu ini tidak bisa mati, hanya bisa berganti warna. Di beberapa board, lampu terhubung langsung ke chip daya, dan tidak ada software yang bisa mematikannya.</string>
    <string name="sl_check_use">Pakai warna ini</string>
    <string name="sl_check_keep">Pertahankan yang lama</string>

    <!-- Colours -->
    <string name="color_off">Mati</string>
    <string name="color_red">Merah</string>
    <string name="color_green">Hijau</string>
    <string name="color_blue">Biru</string>
    <string name="color_purple">Ungu</string>
    <string name="color_pink">Pink</string>
    <string name="color_orange">Oranye</string>
    <string name="color_white">Putih</string>
</resources>
