<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="sl_title">Lampka stanu</string>
    <string name="sl_summary">Co pokazuje lampka stanu przy baterii, ładowaniu i powiadomieniach</string>
    <string name="sl_intro">Lampka na środku konsoli, pod Fn. Wybierz, co ma pokazywać, kiedy bateria się kończy, podczas ładowania i gdy przychodzi powiadomienie. Działa dalej, kiedy konsola śpi, tylko przestaje migać.</string>
    <string name="sl_missing">Nie umiemy jeszcze sterować lampką tej konsoli.</string>

    <!-- What the light shows right now -->
    <string name="sl_now">Teraz</string>
    <!-- e.g. "Red, battery at 8 %" -->
    <string name="sl_now_battery"><xliff:g id="color">%1$s</xliff:g>, bateria na <xliff:g id="level">%2$s</xliff:g> %%</string>
    <!-- e.g. "Red, charging" -->
    <string name="sl_now_charging"><xliff:g id="color">%1$s</xliff:g>, ładowanie</string>
    <string name="sl_now_full"><xliff:g id="color">%1$s</xliff:g>, naładowana do pełna</string>
    <!-- e.g. "Blue, for a notification" -->
    <string name="sl_now_notify"><xliff:g id="color">%1$s</xliff:g>, dla powiadomienia</string>
    <string name="sl_now_check">Sprawdzanie kolorów</string>

    <!-- Battery -->
    <string name="sl_cat_battery">Bateria</string>
    <string name="sl_style">Lampka pokazuje</string>
    <!-- e.g. "Red at 10 % or less" -->
    <string name="sl_style_red_low">Czerwony przy <xliff:g id="level">%1$s</xliff:g> %% lub mniej</string>
    <string name="sl_style_color_red_low"><xliff:g id="color">%1$s</xliff:g>, czerwony przy <xliff:g id="level">%2$s</xliff:g> %% lub mniej</string>
    <!-- e.g. "Blue, purple below 30 %, red at 10 %" -->
    <string name="sl_style_three"><xliff:g id="high">%1$s</xliff:g>, <xliff:g id="middle">%2$s</xliff:g> poniżej 30 %%, czerwony przy 10 %%</string>
    <!-- e.g. "Purple below 30 %, red at 10 %" -->
    <string name="sl_style_two"><xliff:g id="middle">%1$s</xliff:g> poniżej 30 %%, czerwony przy 10 %%</string>
    <!-- e.g. "Always blue" -->
    <string name="sl_style_always">Zawsze <xliff:g id="color">%1$s</xliff:g></string>
    <!-- e.g. "Your own: blue · red below 11 %" -->
    <string name="sl_style_custom">Własne: <xliff:g id="rules">%1$s</xliff:g></string>
    <!-- e.g. "red below 11 %" -->
    <string name="sl_below"><xliff:g id="color">%1$s</xliff:g> poniżej <xliff:g id="level">%2$s</xliff:g> %%</string>
    <string name="sl_blink_low">Migaj, gdy niski poziom</string>
    <string name="sl_blink_low_summary">Kolor niskiej baterii miga, więc trudniej go przegapić</string>
    <!-- e.g. "Red, blinking" -->
    <string name="sl_blinking"><xliff:g id="color">%1$s</xliff:g>, miga</string>
    <string name="sl_hardware">Zostawić to sprzętowi</string>

    <!-- Charger -->
    <string name="sl_cat_charger">Ładowarka</string>
    <string name="sl_charging">Podczas ładowania</string>
    <string name="sl_full">Gdy naładowana do pełna</string>
    <string name="sl_follow_battery">Kolory baterii, jak bez ładowarki</string>
    <string name="sl_follow_charging">Tak jak podczas ładowania</string>

    <!-- Notifications -->
    <string name="sl_cat_notifications">Powiadomienia</string>
    <string name="sl_notify">Migaj przy powiadomieniach</string>
    <string name="sl_notify_summary">Przy wygaszonym ekranie lampka miga, gdy czeka powiadomienie. W uśpieniu zostaje po prostu zapalona.</string>
    <string name="sl_notify_colors">Kolory dla każdej aplikacji</string>
    <string name="sl_notify_colors_summary">Wybierz kolor dla każdej aplikacji. Lampka użyje najbliższego, jaki może pokazać.</string>

    <!-- Tools -->
    <string name="sl_cat_tools">Narzędzia</string>
    <string name="sl_check">Sprawdź kolory</string>
    <string name="sl_check_summary">Nie widzisz wybranych kolorów? Sprawdź, co naprawdę może pokazać lampka twojej konsoli.</string>
    <string name="sl_reset">Przywróć domyślne</string>
    <string name="sl_reset_summary">Cofa wszystko na tej stronie, łącznie ze sprawdzeniem kolorów</string>

    <!-- Colour check -->
    <!-- %1$d is how many steps, e.g. 9 -->
    <string name="sl_check_intro">Lampka przejdzie przez <xliff:g id="count">%1$d</xliff:g> ustawień, jedno po drugim. Każdym razem patrz na lampkę i wybierz, co widzisz. Klony są okablowane w różny sposób, więc to sprawdzi, co umie twoja.</string>
    <string name="sl_check_go">Start</string>
    <!-- e.g. "What does the light show? (3 of 9)" -->
    <string name="sl_check_step">Co pokazuje lampka? (<xliff:g id="step">%1$d</xliff:g> z <xliff:g id="count">%2$d</xliff:g>)</string>
    <string name="sl_check_other">Coś innego</string>
    <!-- e.g. "Your light can show: off, blue, red, purple." -->
    <string name="sl_check_result">Twoja lampka może pokazać: <xliff:g id="colors">%1$s</xliff:g>.</string>
    <string name="sl_check_no_off">Nie może się wyłączyć, tylko zmienia kolor. W niektórych płytach lampka jest podłączona prosto do układu zasilania i żaden program nie może jej wyłączyć.</string>
    <string name="sl_check_use">Użyj tych kolorów</string>
    <string name="sl_check_keep">Zostaw stare</string>

    <!-- Colours -->
    <string name="color_off">Wyłączony</string>
    <string name="color_red">Czerwony</string>
    <string name="color_green">Zielony</string>
    <string name="color_blue">Niebieski</string>
    <string name="color_purple">Fioletowy</string>
    <string name="color_pink">Różowy</string>
    <string name="color_orange">Pomarańczowy</string>
    <string name="color_white">Biały</string>
</resources>
