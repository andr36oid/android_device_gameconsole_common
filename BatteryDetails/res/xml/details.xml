<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        android:key="header"
        android:selectable="false" />

    <PreferenceCategory
        android:key="graph_category"
        android:title="@string/graph_title">

        <org.andr36oid.batterydetails.GraphPreference
            android:key="graph" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="now"
        android:title="@string/now_title">

        <Preference android:key="voltage" android:title="@string/voltage" android:selectable="false" />
        <Preference android:key="current" android:title="@string/current" android:selectable="false" />
        <Preference android:key="power" android:title="@string/power" android:selectable="false" />
        <Preference android:key="temperature" android:title="@string/temperature" android:selectable="false" />
        <Preference android:key="charger" android:title="@string/charger" android:selectable="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="capacity_category"
        android:title="@string/capacity_title">

        <!-- Removed when the kernel can't change the capacity -->
        <org.andr36oid.batterydetails.CapacityPreference
            android:key="capacity_slider"
            android:title="@string/capacity_setting"
            android:summary="@string/capacity_hint" />
        <Preference android:key="capacity_reset" />
        <!-- Removed when the kernel can't count the charge (drained_uah) -->
        <Preference android:key="measure" android:title="@string/measure_title" />
        <!-- What the fuel gauge reports back, so it shows the setting took effect -->
        <Preference android:key="capacity" android:title="@string/capacity" android:selectable="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="limit_category"
        android:title="@string/limit_title">

        <!-- Removed when the kernel has no charge limit -->
        <ListPreference
            android:key="charge_limit"
            android:title="@string/limit_setting"
            android:dialogTitle="@string/limit_setting"
            android:persistent="false" />

        <!-- Removed when the kernel has no charging speed setting -->
        <ListPreference
            android:key="charge_speed"
            android:title="@string/speed_setting"
            android:dialogTitle="@string/speed_setting"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="sleep_category"
        android:title="@string/sleep_title">

        <!-- Removed when the kernel has no sleep modes to choose from -->
        <SwitchPreference
            android:key="deep_sleep"
            android:title="@string/deep_sleep"
            android:summaryOn="@string/deep_sleep_on"
            android:summaryOff="@string/deep_sleep_off"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="diag_category"
        android:title="@string/diag_category">

        <!-- Removed when the charger driver has no andr36oid_diag file -->
        <Preference
            android:key="charge_diag"
            android:title="@string/diag_title"
            android:summary="@string/diag_summary">
            <intent
                android:targetPackage="org.andr36oid.batterydetails"
                android:targetClass="org.andr36oid.batterydetails.ChargeDiagActivity" />
        </Preference>
    </PreferenceCategory>

    <Preference
        android:key="about"
        android:selectable="false"
        android:summary="@string/about" />
</PreferenceScreen>
