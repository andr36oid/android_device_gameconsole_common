    <string name="diag_test_summary">Memantau jalur pengisian selama 15 detik saat kamu memasang pengisi daya, lalu memberi tahu bagian mana yang tidak menyadarinya.</string>
    <string name="diag_test_unplug">Cabut pengisi daya dan perangkat USB apa pun, lalu tekan Mulai.</string>
