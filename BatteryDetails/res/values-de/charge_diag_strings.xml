    <!-- Battery details > Charging diagnostics -->
    <string name="diag_category">Fehlersuche</string>
    <string name="diag_title">Lade-Diagnose</string>
    <string name="diag_summary">Was die Konsole sieht, wenn ein Ladegerät angesteckt ist. Hilft, wenn sie nicht lädt.</string>

    <string name="diag_test_category">Steckertest</string>
    <string name="diag_test_title">Steckertest starten</string>
    <string name="diag_test_summary">Beobachtet 15 Sekunden lang den Ladeweg, während du das Ladegerät ansteckst, und sagt dann, welcher Teil es nicht bemerkt hat.</string>
    <string name="diag_test_unplug">Trenne das Ladegerät und alle USB-Geräte, dann drücke Start.</string>
    <string name="diag_test_start">Start</string>
    <string name="diag_test_plug">Stecke jetzt das Ladegerät ein.\n\n<xliff:g id="seconds">%1$d</xliff:g> s übrig</string>
    <string name="diag_test_result">Ergebnis des Steckertests</string>
    <string name="diag_test_last">Letztes Ergebnis</string>

    <string name="diag_verdict_charging">Laden funktioniert: bis zu <xliff:g id="ma">%1$d</xliff:g> mA sind in den Akku geflossen.</string>
    <string name="diag_verdict_no_current">Die Konsole sieht das Ladegerät, aber es fließt kein Strom in den Akku. Ladegerät-Status: <xliff:g id="state">%1$s</xliff:g>.</string>
    <string name="diag_verdict_driver_missed">Der Power-Chip (RK817) sieht Strom ankommen, aber der Ladetreiber hat ihn nicht als Ladegerät erkannt. Probiere eine andere Ladegerät-Erkennung in den Kernel Tweaks.</string>
    <string name="diag_verdict_pin_only">Der Pin für die Ladegerät-Erkennung hat sich geändert, aber kein Strom ist beim Power-Chip (RK817) angekommen.</string>
    <string name="diag_verdict_nothing">Nichts an der Konsole hat das Ladegerät bemerkt: Kein Strom erreicht den Power-Chip (RK817). Probiere ein anderes Kabel und Ladegerät. Lädt die Konsole ausgeschaltet, muss ihr Anschluss in andr36oid repariert werden.</string>
    <string name="diag_verdict_boost">Der 5-V-Boost für USB-Geräte war an, obwohl nichts angesteckt war. Der Anschluss gibt dann vielleicht Strom ab, statt ihn aufzunehmen.</string>
    <string name="diag_verdict_report">Um das an das andr36oid-Team zu schicken, erstelle einen Problembericht (A+B+X+Y 10 Sekunden gedrückt halten). Er enthält diese Werte.</string>
    <string name="diag_verdict_seen">Erkennungs-Pin geändert: <xliff:g id="pin">%1$s</xliff:g>\nPower-Chip hat Strom gesehen: <xliff:g id="pmic">%2$s</xliff:g>\nTreiber hat ein Ladegerät gesehen: <xliff:g id="driver">%3$s</xliff:g>\nHöchster Strom in den Akku: <xliff:g id="ma">%4$s</xliff:g> mA</string>
    <string name="diag_yes">ja</string>
