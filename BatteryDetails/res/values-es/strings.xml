    <string name="about">El porcentaje es una estimación del medidor de carga. El voltaje se mide directamente: unos 4,2 V es carga completa, 3,7 V es más o menos la mitad y la consola se apaga cerca de 3,4 V. El voltaje baja mientras se ejecuta un juego y se recupera en reposo.\n\nSi el porcentaje y el voltaje no coinciden, carga hasta que la consola indique que está cargada. Así el medidor se corrige solo.\n\nLos tiempos son estimaciones aproximadas basadas en la corriente actual.</string>

    <!-- Durations -->
    <string name="duration_min"><xliff:g id="minutes">%1$d</xliff:g> min</string>
    <string name="duration_h_min"><xliff:g id="hours">%1$d</xliff:g> h <xliff:g id="minutes">%2$d</xliff:g> min</string>
