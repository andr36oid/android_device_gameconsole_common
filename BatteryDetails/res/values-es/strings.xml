    <string name="value_current_in">Entran <xliff:g id="ma">%1$d</xliff:g> mA</string>
    <string name="value_current_out">Salen <xliff:g id="ma">%1$d</xliff:g> mA</string>
    <string name="value_power"><xliff:g id="watts">%1$.2f</xliff:g> W</string>
