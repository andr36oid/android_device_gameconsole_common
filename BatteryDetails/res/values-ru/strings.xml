    <string name="about">Процент — это оценка контроллера заряда. Напряжение измеряется напрямую: около 4,2 V — полный заряд, 3,7 V — примерно середина, а около 3,4 V консоль выключается. Во время игры напряжение проседает и восстанавливается в покое.\n\nЕсли процент и напряжение не совпадают, зарядите консоль, пока она не покажет полный заряд. Так контроллер сам себя исправит.\n\nВремя — грубая оценка по текущему току.</string>

    <!-- Durations -->
    <string name="duration_min"><xliff:g id="minutes">%1$d</xliff:g> мин</string>
    <string name="duration_h_min"><xliff:g id="hours">%1$d</xliff:g> ч <xliff:g id="minutes">%2$d</xliff:g> мин</string>
