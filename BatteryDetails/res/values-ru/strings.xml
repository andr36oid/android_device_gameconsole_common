    <!-- Header -->
    <string name="percent"><xliff:g id="percent">%1$d</xliff:g>%%</string>
    <string name="status_charging">Заряжается</string>
    <string name="status_full">Заряжена</string>
    <string name="status_discharging">От батареи</string>
    <string name="status_not_charging">Подключено, не заряжается</string>
    <string name="time_to_full">до полной зарядки около <xliff:g id="time">%1$s</xliff:g></string>
    <string name="time_left">при таком расходе осталось около <xliff:g id="time">%1$s</xliff:g></string>
