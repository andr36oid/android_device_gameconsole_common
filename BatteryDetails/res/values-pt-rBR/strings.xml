    <string name="about">A porcentagem é uma estimativa do medidor de carga. A tensão é medida diretamente: cerca de 4,2 V é carga completa, 3,7 V é mais ou menos a metade e o console desliga perto de 3,4 V. A tensão cai enquanto um jogo está rodando e se recupera em repouso.\n\nSe a porcentagem e a tensão não baterem, carregue até o console indicar carga completa. Assim o medidor se corrige sozinho.\n\nOs tempos são estimativas aproximadas com base na corrente atual.</string>

    <!-- Durations -->
    <string name="duration_min"><xliff:g id="minutes">%1$d</xliff:g> min</string>
    <string name="duration_h_min"><xliff:g id="hours">%1$d</xliff:g> h <xliff:g id="minutes">%2$d</xliff:g> min</string>
