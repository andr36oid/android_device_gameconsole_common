    <string name="details_title">Detalhes da bateria</string>
    <string name="details_summary">Tensão, corrente, tempos de carga e um gráfico de 24 horas</string>

    <!-- Header -->
    <string name="percent"><xliff:g id="percent">%1$d</xliff:g>%%</string>
    <string name="status_charging">Carregando</string>
    <string name="status_full">Carregada</string>
    <string name="status_discharging">Na bateria</string>
