cc_prebuilt_binary {
    name: "mkfs.erofs",
    arch: {
        arm64: { srcs: ["mkfs.erofs"] },
    },
    compile_multilib: "64",
    static_executable: true,
    stl: "none",
    system_shared_libs: [],
    strip: { none: true },
    check_elf_files: false,
}

