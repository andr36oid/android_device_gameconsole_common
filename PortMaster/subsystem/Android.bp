cc_binary {
    name: "andr36oid-keyheld",
    srcs: ["andr36oid-keyheld.c"],
    cflags: [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_binary {
    name: "andr36oid-guest",
    srcs: ["andr36oid-guest.c"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

// Runs in a glibc rootfs too; no Android linker or shared libraries there.
cc_binary {
    name: "andr36oid-fn-watch",
    srcs: ["andr36oid-fn-watch.c"],
    static_executable: true,
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
