# Fixed services: request is consumed by init before any service starts.
service andr36oid-subsystem /system/bin/sh /system/etc/andr36oid-subsystem.sh run-prop
    class late_start
    user root
    group root system mount
    seclabel u:r:shell:s0
    disabled
    oneshot

service andr36oid-subsystem-scan /system/bin/sh /system/etc/andr36oid-subsystem.sh scan
    class late_start
    user root
    group root system mount
    seclabel u:r:shell:s0
    disabled
    oneshot

service andr36oid-subsystem-optimize /system/bin/sh /system/etc/andr36oid-subsystem.sh optimize-prop
    class late_start
    user root
    group root system mount
    seclabel u:r:shell:s0
    disabled
    oneshot

on property:sys.andr36oid.subsystem.request=run
    setprop sys.andr36oid.subsystem.run_target ${sys.andr36oid.subsystem.port:-ES}
    setprop sys.andr36oid.subsystem.request ""
    start andr36oid-subsystem

on property:sys.andr36oid.subsystem.request=scan
    setprop sys.andr36oid.subsystem.request ""
    setprop sys.andr36oid.subsystem.scan_pending 1
    start andr36oid-subsystem-scan

# start is ignored for an already running oneshot. Keep one coalesced re-scan
# for changes that arrive during enumeration or just before that service exits.
on property:init.svc.andr36oid-subsystem-scan=stopped && property:sys.andr36oid.subsystem.scan_pending=1
    start andr36oid-subsystem-scan

on property:sys.andr36oid.subsystem.request=optimize
    setprop sys.andr36oid.subsystem.opt_dispatch_job ${sys.andr36oid.subsystem.opt_request_id:-invalid}
    setprop sys.andr36oid.subsystem.opt_dispatch_source ${sys.andr36oid.subsystem.opt_source:-invalid}
    setprop sys.andr36oid.subsystem.request ""
    start andr36oid-subsystem-optimize

# Scan also reconciles interrupted optimization journals without display handoff.
on property:sys.boot_completed=1
    setprop sys.andr36oid.subsystem.request scan

# Preserve detection re-scan after vold's asynchronous games-card mount.
on property:sys.andr36oid.easyroms.ready=1
    setprop sys.andr36oid.subsystem.request scan
