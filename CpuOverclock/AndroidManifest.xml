<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.andr36oid.cpuoverclock"
    android:sharedUserId="android.uid.system">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_cpu_overclock"
        android:label="@string/overclock_title"
        android:supportsRtl="true">

        <!-- Injected into the top level of the Settings app, right below Joystick mouse.
             Also opened by a long press on the tile. -->
        <activity
            android:name=".OverclockActivity"
            android:exported="true"
            android:label="@string/overclock_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-63" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="top_level_cpu_overclock" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/overclock_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_cpu_overclock" />
            <meta-data
                android:name="com.android.settings.bg.hint"
                android:resource="@color/overclock_icon_background" />
        </activity>

        <!-- Off until the overclock is used for the first time, see Overclock.showTile() -->
        <service
            android:name=".OverclockTileService"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_cpu_overclock"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Battery saver / Balanced / Performance. Always there, and added to Quick Settings
             once, on the first boot. -->
        <service
            android:name=".ProfileTileService"
            android:exported="true"
            android:icon="@drawable/ic_performance_profile"
            android:label="@string/profile_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Applies the saved profile after boot -->
        <receiver
            android:name=".ProfileReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- FN + R1, sent by the system (PhoneWindowManager) -->
        <receiver
            android:name=".ProfileSwitchReceiver"
            android:exported="true"
            android:permission="android.permission.DEVICE_POWER">
            <intent-filter>
                <action android:name="org.andr36oid.cpuoverclock.action.NEXT_PROFILE" />
            </intent-filter>
        </receiver>

        <!-- Game mode picks a profile while you play and puts the old one back after -->
        <receiver
            android:name=".ProfileCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DEVICE_POWER">
            <intent-filter>
                <action android:name="org.andr36oid.cpuoverclock.action.SET_PROFILE" />
                <action android:name="org.andr36oid.cpuoverclock.action.RESTORE_PROFILE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
