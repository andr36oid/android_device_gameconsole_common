<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:key="profiles"
        android:title="@string/profile_category">

        <ListPreference
            android:key="profile"
            android:persistent="false"
            android:title="@string/profile_title"
            android:entries="@array/profile_names" />

        <Preference
            android:key="profile_about"
            android:selectable="false" />

        <ListPreference
            android:key="cpu_cap"
            android:persistent="false"
            android:title="@string/cpu_cap_title" />

        <Preference
            android:key="app_profiles"
            android:title="@string/app_profiles_title">
            <intent
                android:targetClass="org.andr36oid.cpuoverclock.AppProfilesActivity"
                android:targetPackage="org.andr36oid.cpuoverclock" />
        </Preference>

        <SwitchPreference
            android:key="close_apps_on_game"
            android:persistent="false"
            android:title="@string/close_apps_on_game_title"
            android:summary="@string/close_apps_on_game_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="overclock"
        android:title="@string/overclock_category">

        <SwitchPreference
            android:key="enabled"
            android:persistent="false"
            android:title="@string/overclock_switch" />

        <ListPreference
            android:key="speed"
            android:persistent="false"
            android:title="@string/overclock_speed" />

        <Preference
            android:key="about"
            android:selectable="false"
            android:summary="@string/overclock_about" />
    </PreferenceCategory>

    <!-- Removed when the kernel lists no GPU or memory overclock speeds -->
    <PreferenceCategory
        android:key="gpu_ram_category"
        android:title="@string/gpu_ram_category">
        <SwitchPreference
            android:key="gpu_oc"
            android:persistent="false"
            android:title="@string/gpu_oc_title" />
        <ListPreference
            android:key="ram_oc"
            android:persistent="false"
            android:title="@string/ram_oc_title" />
        <Preference
            android:key="gpu_ram_about"
            android:selectable="false"
            android:summary="@string/gpu_ram_about" />
    </PreferenceCategory>
    <!-- Removed when the kernel has no undervolt parameter -->
    <PreferenceCategory
        android:key="undervolt_category"
        android:title="@string/undervolt_category">

        <ListPreference
            android:key="undervolt"
            android:persistent="false"
            android:title="@string/undervolt_title" />

        <Preference
            android:key="undervolt_about"
            android:selectable="false"
            android:summary="@string/undervolt_about" />
    </PreferenceCategory>
</PreferenceScreen>
