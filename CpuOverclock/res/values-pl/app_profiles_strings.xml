<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Per-app profiles -->
    <string name="app_profiles_title">Profile aplikacji</string>
    <string name="app_profiles_off">Wył.</string>
    <!-- Summary in Settings > Performance, count is the number of apps with their own profile -->
    <plurals name="app_profiles_on">
        <item quantity="one">Wł., <xliff:g id="count">%d</xliff:g> aplikacja ma własny profil</item>
        <item quantity="few">Wł., <xliff:g id="count">%d</xliff:g> aplikacje mają własny profil</item>
        <item quantity="many">Wł., <xliff:g id="count">%d</xliff:g> aplikacji ma własny profil</item>
        <item quantity="other">Wł., <xliff:g id="count">%d</xliff:g> aplikacji ma własny profil</item>
    </plurals>
    <string name="app_profiles_switch">Przełączaj profil według aplikacji</string>
    <string name="app_profiles_switch_summary">Aplikacja z własnym profilem dostaje go, gdy jest otwarta. Po wyjściu z niej wraca profil wybrany w ustawieniach Wydajność.</string>
    <string name="app_profiles_apps">Aplikacje</string>
    <!-- First choice of every app, profile is the chosen profile, e.g. "Default (Balanced)" -->
    <string name="app_profile_default">Domyślny (<xliff:g id="profile">%1$s</xliff:g>)</string>
    <string name="app_profiles_about">Domyślny oznacza, że aplikacja używa profilu wybranego w ustawieniach Wydajność. Niektóre emulatory zaczynają z profilem Wydajność, a niektóre aplikacje z profilem Zrównoważony lub Oszczędzanie baterii. Każdy z nich możesz tu zmienić.\n\nKafelek w Szybkich ustawieniach i FN + R1 działają też w aplikacji z własnym profilem. Twój wybór obowiązuje wtedy do wyjścia z aplikacji.\n\nGdy ta opcja jest włączona, mały pomocnik sprawdza, która aplikacja jest otwarta. Nie działa, gdy opcja jest wyłączona lub żadna aplikacja nie ma własnego profilu.</string>
    <!-- Second line of the FN + R1 message in an app with its own profile, app is its name -->
    <string name="app_profile_until_left">Do wyjścia z aplikacji <xliff:g id="app">%1$s</xliff:g></string>
    <!-- Tile subtitle in an app with its own profile, e.g. "Performance, PPSSPP" -->
    <string name="app_profile_tile"><xliff:g id="profile">%1$s</xliff:g>, <xliff:g id="app">%2$s</xliff:g></string>
</resources>
