<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <string name="overclock_title">性能</string>
    <string name="overclock_summary">省电或全速运行、CPU 限速和超频</string>

    <!-- Performance profiles -->
    <string name="profile_category">性能模式</string>
    <string name="profile_title">模式</string>
    <string-array name="profile_names">
        <item>省电</item>
        <item>均衡</item>
        <item>性能</item>
    </string-array>
    <!-- What each profile does. cpu is a CPU speed like "1.01 GHz", gpu a GPU speed in MHz. -->
    <string name="profile_about_saver">游戏时间更长。CPU 频率不超过 <xliff:g id="cpu">%1$s</xliff:g>，图形频率为 <xliff:g id="gpu">%2$d</xliff:g> MHz。玩 8 位和 16 位游戏绰绰有余。</string>
    <string name="profile_about_balanced">标准频率。游戏需要时处理器加速，不需要时降速。</string>
    <string name="profile_about_footer">\n\n掌机重启后仍保留所选模式。用快捷设置图块可切换到下一个模式。</string>
    <string name="profile_about_footer_fn">\n\n掌机重启后仍保留所选模式。按 FN + R1 或用快捷设置图块可切换到下一个模式。</string>
    <string name="profile_failed">无法更改性能模式</string>
    <!-- Toast after FN + R1, e.g. "Performance profile: Battery saver" -->
    <string name="profile_switched">性能模式：<xliff:g id="profile">%1$s</xliff:g></string>
    <string name="profile_tile_label">性能</string>
    <!-- Toast after FN + R1 while a maximum CPU speed holds the CPU lower than the profile would,
         e.g. "Performance profile: Balanced, CPU up to 816 MHz" -->
    <string name="profile_switched_capped">性能模式：<xliff:g id="profile">%1$s</xliff:g>，CPU 最高 <xliff:g id="speed">%2$s</xliff:g></string>
    <!-- Tile subtitle with a maximum CPU speed, e.g. "Balanced, 816 MHz" -->
    <string name="profile_tile_capped"><xliff:g id="profile">%1$s</xliff:g>，<xliff:g id="speed">%2$s</xliff:g></string>

    <!-- Maximum CPU speed (underclock) -->
    <string name="cpu_cap_title">CPU 最高频率</string>
    <!-- First entry of the list, no limit. speed is the standard top speed, e.g. "1296 MHz" -->
    <string name="cpu_cap_stock">默认（<xliff:g id="speed">%1$s</xliff:g>）</string>
    <string name="cpu_cap_note">频率越低，续航越长、掌机越凉快，但游戏会变慢。如果游戏卡顿，请选择更高的频率。掌机重启后仍会保留。</string>
    <!-- The cap is lower than what the profile allows, speed e.g. "816 MHz" -->
    <string name="cpu_cap_active">最高 <xliff:g id="speed">%1$s</xliff:g>，与性能模式无关。</string>
    <!-- The profile already stays lower than the cap -->
    <string name="cpu_cap_profile_lower"><xliff:g id="speed">%1$s</xliff:g>。当前性能模式已将 CPU 限制在 <xliff:g id="profile_speed">%2$s</xliff:g> 或更低。</string>
    <string name="cpu_cap_on_hold"><xliff:g id="speed">%1$s</xliff:g>。超频开启期间暂停生效。</string>
    <string name="cpu_cap_none">除性能模式外无其他限制。</string>
    <!-- A CPU speed, e.g. "816 MHz" -->
    <string name="speed_mhz"><xliff:g id="mhz">%1$d</xliff:g> MHz</string>

    <string name="overclock_category">CPU 超频（实验性）</string>
    <string name="overclock_switch">超频</string>
    <string name="overclock_switch_on">运行频率最高 <xliff:g id="speed">%1$s</xliff:g></string>
    <string name="overclock_switch_off">已关闭，CPU 最高运行在 <xliff:g id="speed">%1$s</xliff:g></string>
    <string name="overclock_speed">频率</string>

    <!-- A CPU speed, e.g. "1.51 GHz" -->
    <string name="speed_ghz"><xliff:g id="ghz">%1$.2f</xliff:g> GHz</string>

    <string name="overclock_about">让要求高的游戏模拟得更快，但有代价：掌机会更热，耗电更快，部分掌机在较高频率下会卡死或崩溃。如果出现这种情况，请选择较低的频率。\n\n掌机每次启动时都不会超频，重启即可关闭超频。超频开启期间，CPU 最高频率设置暂停生效。掌机过热时也会自动降速。</string>

    <string name="overclock_unsupported">此掌机无法超频。</string>
    <string name="overclock_failed">无法更改 CPU 频率</string>

    <!-- CPU undervolt -->
    <string name="undervolt_category">CPU 降压（实验性）</string>
    <string name="undervolt_title">降压</string>
    <string name="undervolt_off">关闭</string>
    <!-- An undervolt step, e.g. "−25 mV" -->
    <string name="undervolt_step">−<xliff:g id="mv">%1$d</xliff:g> mV</string>
    <string name="undervolt_about">以稍低的电压让 CPU 跑同样的频率，因此耗电略少、温度略低，在较高频率下效果最明显。816 MHz 及以下时收益很小。\n\n每颗芯片都不一样。如果游戏崩溃，或掌机卡死、重启，请改回“关闭”。在保存数据时崩溃可能会损坏卡上的文件，所以请一次只降一档，玩一段时间后再继续降低。\n\n掌机每次启动时降压都处于关闭状态，重启即可关闭降压。</string>
    <string name="gpu_ram_category">GPU 和内存超频（实验性）</string>
    <string name="gpu_oc_title">GPU 超频</string>
    <string name="gpu_oc_on">开启：最高 <xliff:g id="fast">%1$s</xliff:g>，而不是 <xliff:g id="stock">%2$s</xliff:g></string>
    <string name="gpu_oc_off">关闭：最高 <xliff:g id="stock">%2$s</xliff:g>，超频后为 <xliff:g id="fast">%1$s</xliff:g></string>
    <string name="ram_oc_title">内存频率</string>
    <string name="ram_oc_off">默认（<xliff:g id="speed">%1$s</xliff:g>）</string>
    <string name="ram_oc_experimental"><xliff:g id="speed">%1$s</xliff:g>（实验性）</string>
    <string name="ram_oc_warning_title">实验性内存频率</string>
    <string name="ram_oc_warning">此频率会让 GPU 和内存的供电线路使用最高电压。部分内存芯片能稳定运行，其他的可能导致游戏崩溃、掌机卡死或画面出错。\n\n这不会损坏内存，但保存数据时崩溃可能会损坏卡上的文件。如果出现问题，请改用较低的频率。重启即可关闭。</string>
    <string name="ram_oc_warning_ok">使用</string>
    <string name="gpu_ram_about">为要求高的游戏提供更快的图形和内存。GPU 超频会把 GPU 的运行频率从 520 MHz 提到 600 MHz。更高的内存频率对 PPSSPP 等模拟器帮助最大。两者都会提高 GPU 和内存共用的供电线路电压，因此掌机会稍微更热，耗电也更快。\n\n每颗芯片都不一样。如果游戏崩溃或掌机卡死，请关闭它们。掌机每次启动时都不会开启这些设置，重启即可关闭。\n\n基于 zenmode-adri 的 R36 Tuner Next。</string>
    <string name="gpu_ram_unsupported">此掌机的系统不支持该频率</string>
    <string name="gpu_ram_failed">无法更改 GPU 或内存频率</string>
    <string name="undervolt_failed">无法更改 CPU 电压</string>

    <!-- Quick Settings tile -->
    <string name="tile_label">CPU 超频</string>
    <string name="tile_off">关闭</string>
    <string name="gpu_tile_label">GPU 超频</string>
    <string name="ram_tile_label">内存超频</string>
    <string name="tile_added_gpu">GPU 超频快捷开关已添加到通知栏</string>
    <string name="tile_added_ram">内存超频快捷开关已添加到通知栏</string>
    <string name="profile_about_performance">最流畅的模拟体验。CPU 频率始终不低于 <xliff:g id="cpu">%1$s</xliff:g>，图形处理器始终以 <xliff:g id="gpu">%2$d</xliff:g> MHz 运行，内存始终全速运行。适用于 PS1、N64 和 PSP 游戏。电池消耗更快。</string>
    <string name="close_apps_on_game_title">打开任何游戏时关闭后台应用</string>
    <string name="close_apps_on_game_summary">为游戏释放内存，效果与电源菜单中的“关闭后台应用”相同</string>
    <string name="app_profiles_title">应用专属模式</string>
    <string name="app_profiles_off">关闭</string>
    <plurals name="app_profiles_on">
        <item quantity="other">已开启，<xliff:g id="count">%d</xliff:g> 个应用有专属模式</item>
    </plurals>
    <string name="app_profiles_switch">根据应用切换模式</string>
    <string name="app_profiles_switch_summary">有专属模式的应用在打开时使用该模式。离开应用后，会恢复“性能”中选择的模式。</string>
    <string name="app_profiles_apps">应用</string>
    <string name="app_profile_default">默认（<xliff:g id="profile">%1$s</xliff:g>）</string>
    <string name="app_profiles_about">默认表示跟随“性能”中选择的模式。部分模拟器初始设为“性能”，部分应用设为“均衡”或“省电”。您可以在这里逐一更改。\n\n在有专属模式的应用中，快捷设置磁贴和 FN + R1 仍然有效。此时，您的选择会持续到离开应用为止。\n\n开启后，一个小型辅助服务会监测当前打开的应用。关闭时，或没有应用设置专属模式时，该服务不会运行。</string>
    <string name="app_profile_until_left">直到离开 <xliff:g id="app">%1$s</xliff:g></string>
    <string name="app_profile_tile"><xliff:g id="profile">%1$s</xliff:g>, <xliff:g id="app">%2$s</xliff:g></string>
    <string name="game_turbo_title">Game Turbo（游戏时最高时钟频率）</string>
    <string name="game_turbo_summary">游戏位于前台时，保持 CPU（1296 MHz）、GPU（520 MHz）和内存的标准时钟频率。游戏时会消耗更多电量。之后会恢复之前的限制和正常调速器。明确指定的应用配置优先。不启用超频。</string>
    <string name="game_affinity_title">将游戏固定到专用核心</string>
    <string name="game_affinity_summary">实验性功能：让 RetroArch 或 PPSSPP 使用核心 2–3，让后台工作和选定的设备中断使用核心 0–1，然后恢复原状。四个核心完全相同；任何收益都来自更少的争用，效果并不确定。</string>
    <string name="perf_subtitle">主机运行游戏的方式</string>
    <string name="perf_hint">PS1、N64 和 PSP 在“性能”模式下运行效果最佳。</string>
    <string name="perf_mode_saver_tag">更长的电池续航。适合 8 位和 16 位游戏。</string>
    <string name="perf_mode_balanced_tag">仅在游戏需要时提速。</string>
    <string name="perf_mode_performance_tag">最流畅，最适合复古游戏的高帧率。适用于 PS1、N64 和 PSP。运行时会稍微更热。</string>
    <string name="perf_card_on">\u2713 开启</string>
    <string name="perf_row_ingame_title">游戏内选项</string>
    <string name="perf_row_ingame_value">游戏模式</string>
    <string name="perf_row_perapp_title">按应用设置性能</string>
    <string name="perf_row_advanced_title">高级</string>
    <string name="perf_row_advanced_value">超频、限制</string>
    <string name="perf_ingame_title">游戏内选项</string>
    <string name="perf_ingame_brightness_title">游戏中的屏幕亮度</string>
    <string name="perf_ingame_brightness_summary">游戏可以自行打开的亮度开关</string>
    <string name="perf_ingame_lowbatt_title">低电量警告</string>
    <string name="perf_ingame_lowbatt_summary">电量不足时在游戏中显示提示</string>
    <string name="perf_ingame_continue_title">返回上次的游戏</string>
    <string name="perf_ingame_continue_summary">进入上次玩过的游戏的快捷方式</string>
    <string name="perf_advanced_note">面向高级用户。默认值对所有主机都安全。</string>
    <string name="perf_cat_limits">速度限制</string>
    <string name="perf_status">当前运行：CPU 最高 %1$s · %2$d°C</string>
    <string name="perf_status_no_temp">当前运行：CPU 最高 %1$s</string>
</resources>
