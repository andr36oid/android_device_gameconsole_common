<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Per-app profiles -->
    <string name="app_profiles_title">应用专属模式</string>
    <string name="app_profiles_off">关闭</string>
    <!-- Summary in Settings > Performance, count is the number of apps with their own profile -->
    <plurals name="app_profiles_on">
        <item quantity="other">开启，<xliff:g id="count">%d</xliff:g> 个应用有专属模式</item>
    </plurals>
    <string name="app_profiles_switch">按应用切换模式</string>
    <string name="app_profiles_switch_summary">有专属模式的应用在打开期间使用该模式。离开应用后，恢复在“性能”中选择的模式。</string>
    <string name="app_profiles_apps">应用</string>
    <!-- First choice of every app, profile is the chosen profile, e.g. "Default (Balanced)" -->
    <string name="app_profile_default">默认（<xliff:g id="profile">%1$s</xliff:g>）</string>
    <string name="app_profiles_about">“默认”表示该应用使用在“性能”中选择的模式。部分模拟器初始为“性能”模式，部分应用初始为“均衡”或“省电”模式。您可以在这里更改其中任何一项。\n\n在有专属模式的应用中，快捷设置图块和 FN + R1 仍然可用。您选择的模式会一直保持到您离开该应用。\n\n此功能开启期间，一个小型辅助程序会监测当前打开的是哪个应用。此功能关闭或没有应用设置专属模式时，它不会运行。</string>
    <!-- Second line of the FN + R1 message in an app with its own profile, app is its name -->
    <string name="app_profile_until_left">直到您离开 <xliff:g id="app">%1$s</xliff:g></string>
    <!-- Tile subtitle in an app with its own profile, e.g. "Performance, PPSSPP" -->
    <string name="app_profile_tile"><xliff:g id="profile">%1$s</xliff:g>，<xliff:g id="app">%2$s</xliff:g></string>
</resources>
