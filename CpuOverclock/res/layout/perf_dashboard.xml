<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@android:color/black"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="22dp" android:paddingRight="22dp"
        android:paddingTop="20dp" android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/overclock_title"
            android:textColor="?android:attr/textColorPrimary" android:textSize="28sp"
            android:textStyle="bold" android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/perf_subtitle"
            android:textColor="?android:attr/textColorSecondary" android:textSize="14sp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:id="@+id/perf_cards"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="18dp" />

        <!-- Live proof of the selected mode: current CPU ceiling + SoC temperature -->
        <TextView
            android:id="@+id/perf_status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary" android:textSize="14sp"
            android:layout_marginTop="14dp" android:gravity="center_horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/perf_hint"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/perf_hint"
            android:textColor="?android:attr/textColorSecondary" android:textSize="13sp"
            android:layout_marginTop="12dp" android:gravity="center_horizontal" />

        <include layout="@layout/perf_row" android:id="@+id/row_ingame"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" />
        <include layout="@layout/perf_row" android:id="@+id/row_perapp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
        <include layout="@layout/perf_row" android:id="@+id/row_advanced"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</ScrollView>
