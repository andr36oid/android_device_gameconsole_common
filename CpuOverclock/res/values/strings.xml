    <string name="overclock_title">CPU overclock (experimental)</string>
    <string name="overclock_summary">Run the processor faster than standard</string>

    <string name="overclock_switch">Overclock</string>
    <string name="overclock_switch_on">Running at up to <xliff:g id="speed">%1$s</xliff:g></string>
    <string name="overclock_switch_off">Standard speed, up to <xliff:g id="speed">%1$s</xliff:g></string>
