<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Performance dashboard. Dark DeviceDefault so text is light and the accent is the user's
         system accent overlay (never pinned), but the window is forced to TRUE black - the plain
         dark colorBackground is only dark-grey. Same pattern as SmoothnessTest/Credits. -->
    <style name="PerfTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <!-- Shared components read colorBackground (the HintBar colours its bar from it); keep it
             true black too, or the hint bar renders dark-grey on our black window. -->
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:colorEdgeEffect">?android:attr/colorAccent</item>
        <!-- Not fullscreen: this lives under Settings, so keep the status bar (clock/battery/wifi)
             like every other Settings screen. -->
        <item name="android:fontFamily">sans</item>
    </style>

    <!-- Advanced page: same, but WITH an action bar for the title. -->
    <style name="PerfTheme.Settings" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:colorEdgeEffect">?android:attr/colorAccent</item>
    </style>
</resources>
