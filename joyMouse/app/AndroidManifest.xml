<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gameconsole.joymouse"
    android:sharedUserId="android.uid.system">

    <!-- Only the joyMouse daemon (root) may ask for the mode toast. -->
    <permission
        android:name="com.gameconsole.joymouse.permission.ANNOUNCE"
        android:protectionLevel="signature" />

    <!-- Not persistent (that kept ~5 MB in use for good): the daemon starts the app while
         the toggle chord is held, before the mode toast is due (Announcer.h) -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_joymouse"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- Opened from Settings > Controls (Controllers app), not an entry of its own -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
        </activity>

        <receiver
            android:name=".ModeToastReceiver"
            android:exported="true"
            android:permission="com.gameconsole.joymouse.permission.ANNOUNCE">
            <intent-filter>
                <action android:name="com.gameconsole.joymouse.action.MODE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
