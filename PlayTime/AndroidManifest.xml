<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.andr36oid.playtime"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- parental controls: counting in the foreground, the time up page coming back right
         after Home, and turning the console off when no PIN comes -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.STOP_APP_SWITCHES" />
    <uses-permission android:name="android.permission.REBOOT" />

    <application
        android:allowBackup="false"
        android:allowClearUserData="false"
        android:icon="@drawable/ic_play_time"
        android:label="@string/play_time_title"
        android:supportsRtl="true">

        <!-- Injected into the top level of the Settings app, in the console group -->
        <activity
            android:name=".PlayTimeActivity"
            android:exported="true"
            android:label="@string/play_time_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <!-- Same order as Controller test; ties sort by title, so this lands after
                 it and before Storage (-60). -->
            <meta-data
                android:name="com.android.settings.order"
                android:value="-61" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="top_level_play_time" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/play_time_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_play_time" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
        </activity>

        <!-- Parental controls (Parental.java) -->
        <activity
            android:name=".ParentalActivity"
            android:exported="false"
            android:label="@string/parental_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings" />
        <activity
            android:name=".PinActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />
        <activity
            android:name=".TimeUpActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="org.andr36oid.playtime.timeup"
            android:showWhenLocked="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />
        <service
            android:name=".ParentalService"
            android:exported="false" />

        <!-- Break reminder check, every few minutes while the console is awake -->
        <receiver
            android:name=".BreakReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
