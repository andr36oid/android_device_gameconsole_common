    <string name="play_time_title">Oyun süresi</string>
    <string name="play_time_summary">Ne kadar oynadığınız, en çok oynadıklarınız ve mola hatırlatıcıları</string>

    <!-- Header above the week chart -->
    <string name="today">Bugün: <xliff:g id="time">%1$s</xliff:g></string>
