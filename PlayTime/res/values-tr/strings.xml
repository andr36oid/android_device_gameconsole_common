    <string name="break_text">Kısa bir mola vermeye ne dersiniz? Gözlerinizi dinlendirin ve biraz gerinin, oyununuz bekler.</string>
    <string name="break_text_battery">Kısa bir mola vermeye ne dersiniz? Gözlerinizi dinlendirin ve biraz gerinin. Pil: %%<xliff:g id="percent">%1$d</xliff:g>.</string>
