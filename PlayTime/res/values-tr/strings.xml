    <string name="about">Oyun süresi, bir uygulamanın ekranda açık kaldığı süreyi sayar. Ana ekran, Ayarlar ve ekranın kapalı olduğu süre sayılmaz.\n\nMola hatırlatıcısı ekranın ne kadar süredir açık olduğunu sayar. 2 dakika veya daha uzun bir ara sayımı yeniden başlatır.</string>

    <!-- Durations -->
    <string name="duration_min"><xliff:g id="minutes">%1$d</xliff:g> dk</string>
    <string name="duration_h"><xliff:g id="hours">%1$d</xliff:g> sa</string>
    <string name="duration_h_min"><xliff:g id="hours">%1$d</xliff:g> sa <xliff:g id="minutes">%2$d</xliff:g> dk</string>

