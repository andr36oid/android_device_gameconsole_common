<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <string name="play_time_title">游戏时间</string>
    <string name="play_time_summary">玩了多久、最常玩的游戏和休息提醒</string>

    <!-- Header above the week chart -->
    <string name="today">今天：<xliff:g id="time">%1$s</xliff:g></string>
    <string name="this_week">过去 7 天：<xliff:g id="time">%1$s</xliff:g></string>

    <string name="most_played">最常玩（过去 7 天）</string>
    <string name="nothing_played">还没有记录。快去玩点什么吧！</string>
    <!-- Summary of an app in the most played list: time, and the share of all play time -->
    <string name="app_time"><xliff:g id="time">%1$s</xliff:g> · <xliff:g id="percent">%2$d</xliff:g>%%</string>

    <string name="breaks">休息</string>
    <string name="break_reminder">提醒我休息</string>
    <string-array name="break_entries">
        <item>从不</item>
        <item>30 分钟后</item>
        <item>45 分钟后</item>
        <item>1 小时后</item>
        <item>1 小时 30 分钟后</item>
        <item>2 小时后</item>
    </string-array>
    <string name="about">游戏时间统计的是应用在屏幕上打开的时间。主屏幕、设置和屏幕关闭的时间不计算在内。\n\n休息提醒统计的是屏幕连续亮着的时间。暂停 2 分钟或更久后会重新计时。</string>

    <!-- Durations -->
    <string name="duration_min"><xliff:g id="minutes">%1$d</xliff:g> 分钟</string>
    <string name="duration_h"><xliff:g id="hours">%1$d</xliff:g> 小时</string>
    <string name="duration_h_min"><xliff:g id="hours">%1$d</xliff:g> 小时 <xliff:g id="minutes">%2$d</xliff:g> 分钟</string>

    <!-- Break reminder notification -->
    <string name="channel_name">休息提醒</string>
    <string name="break_title">您已经玩了 <xliff:g id="time">%1$s</xliff:g></string>
    <string name="break_text">该休息一下了吧？让眼睛歇歇，活动活动身体，游戏会等着您。</string>
    <string name="break_text_battery">该休息一下了吧？让眼睛歇歇，活动活动身体。电量剩余 <xliff:g id="percent">%1$d</xliff:g>%%。</string>

    <!-- Parental controls (Settings > Play time > Parental controls) -->
    <string name="parental_title">家长控制</string>
    <string name="parental_off_summary">已关闭。用 PIN 码限制主机的游戏时长。</string>
    <!-- %1$s: time left, e.g. "42 min" -->
    <string name="parental_on_summary">已开启 · 剩余 <xliff:g id="time">%1$s</xliff:g></string>
    <string name="parental_switch_summary">限制主机的游戏时长，超时后只有输入 PIN 码才能继续玩</string>
    <string name="parental_limit">允许的游戏时长</string>
    <string name="parental_refill">时间在此之后恢复</string>
    <plurals name="parental_refill_hours">
        <item quantity="other">休息 <xliff:g id="hours">%1$d</xliff:g> 小时</item>
    </plurals>
    <string name="parental_refill_pin">仅限 PIN 码</string>
    <string name="parental_shutdown">时间用完时</string>
    <!-- %1$s: e.g. "2 min" -->
    <string name="parental_shutdown_after">无 PIN 码输入超过 <xliff:g id="time">%1$s</xliff:g> 后关闭主机</string>
    <string name="parental_shutdown_never">保持「时间已到」页面开启</string>
    <string name="parental_refill_custom">自定义…</string>
    <string name="parental_refill_custom_title">休息时长</string>
    <string name="parental_allowed">允许的应用</string>
    <string name="parental_allowed_none">无。此处选择的应用不消耗游戏时间，时间用完后仍可打开，例如学习类应用。</string>
    <string name="parental_blocked_apps">被屏蔽的应用</string>
    <string name="parental_blocked_none">无。家长控制开启时，此处选择的应用无法打开。</string>
    <!-- toast when a blocked app is opened; %1$s: the app's name -->
    <string name="parental_blocked"><xliff:g id="app">%1$s</xliff:g> 已被家长控制屏蔽</string>
    <!-- time up page, above the buttons of the allowed apps -->
    <string name="parental_still_open">以下应用仍可使用：</string>
    <string name="parental_left_title">剩余时间</string>
    <!-- %1$s left of %2$s, e.g. "42 min of 1 h" -->
    <string name="parental_left_summary">还剩 <xliff:g id="left">%1$s</xliff:g>，共 <xliff:g id="allowed">%2$s</xliff:g>。选择即可增加时间。</string>
    <string name="parental_change_pin">更改 PIN 码</string>
    <string name="parental_about">统计屏幕亮着的时间，适用于除允许的应用以外的所有应用。主机没有带电池的时钟，所以不按一天中的时间计算：在屏幕关闭或主机休眠的情况下，经过足够长的休息后时间会恢复。关闭主机不算休息，因为主机无法得知它被关了多久。如需整夜休眠，请使用电源键。\n\n时间快用完前 10 分钟和 2 分钟会发出提醒。之后会有一个页面盖住屏幕，直到输入 PIN 码；如果没有输入，主机会按上述设置关机。重启后，时间仍然是用完的。\n\n忘记 PIN 码？只有重新设置存储卡才能清除。</string>
    <string name="parental_left">剩余游戏时间：<xliff:g id="time">%1$s</xliff:g></string>
    <string name="parental_warning_channel">游戏时间提醒</string>
    <string name="parental_warning">游戏时间将在 <xliff:g id="time">%1$s</xliff:g> 后结束。记得保存游戏！</string>
    <string name="parental_up_title">游戏时间已到</string>
    <plurals name="parental_up_text_rest">
        <item quantity="other">该休息啦！主机休眠后，游戏时间会在休息 <xliff:g id="hours">%1$d</xliff:g> 小时后恢复，或家长可以输入 PIN 码增加时间。</item>
    </plurals>
    <string name="parental_up_text_pin">该休息啦！家长可以输入 PIN 码增加时间。</string>
    <!-- %1$s: minutes:seconds, e.g. "1:45" -->
    <string name="parental_shutdown_in">主机将在 <xliff:g id="time">%1$s</xliff:g> 后关机。</string>
    <string name="parental_more_time">更多游戏时间</string>
    <!-- %1$s: e.g. "30 min" -->
    <string name="parental_add">增加 <xliff:g id="time">%1$s</xliff:g></string>
    <!-- %1$s: the whole allowance, e.g. "1 h" -->
    <string name="parental_start_over">重新开始（<xliff:g id="time">%1$s</xliff:g>）</string>

    <!-- PIN pad: A, B and Start are the console's buttons -->
    <string name="pin_hint">A：按下 · B：删除 · Start：确定</string>
    <string name="pin_check_title">输入 PIN 码</string>
    <string name="pin_check_text">家长控制已用 PIN 码保护。</string>
    <string name="pin_new_title">设置 PIN 码</string>
    <string name="pin_new_text">4 位数字。只应由家长知道：用于更改这些设置和增加游戏时间。</string>
    <string name="pin_again_title">再次输入</string>
    <string name="pin_mismatch">两次输入不一致。请重新设置。</string>
    <string name="pin_wrong">PIN 码错误</string>
    <string name="pin_wait">尝试次数过多。请等待 <xliff:g id="seconds">%1$d</xliff:g> 秒。</string>
</resources>
