    <string name="rescue_tip">ボタンがめちゃくちゃになった場合は、音量ボタンの両方を5秒間押し続けるとリセットされます。</string>

    <!-- A button picked to act as the Fn button, on consoles without one or by choice -->
    <string name="fn_set">「<xliff:g id="button">%1$s</xliff:g>」がFNになりました。短く押すとホーム画面、押したまま別のボタンを押すとショートカットが使えます。</string>
    <string name="fn_replaced_button">「<xliff:g id="button">%1$s</xliff:g>」がFNになりました。FNにできるボタンは1つだけなので、「<xliff:g id="old_button">%2$s</xliff:g>」は元の動作に戻ります。</string>
    <string name="fn_replaced_volume">「<xliff:g id="button">%1$s</xliff:g>」がFNになり、FNのボタンの組み合わせの代わりになりました。</string>
    <string name="fn_cleared">「<xliff:g id="button">%1$s</xliff:g>」はもうFNではありません。</string>

