<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.andr36oid.buttonmapper">

    <!-- Writes the hardware_button_* settings, granted through the platform signature -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_app"
        android:label="@string/button_mapping_title"
        android:supportsRtl="true">

        <!-- Opened from Settings > Controls (Controllers app), not an entry of its own -->
        <activity
            android:name=".ButtonMappingActivity"
            android:exported="true"
            android:label="@string/button_mapping_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
        </activity>

        <!-- Switches between the button profiles -->
        <service
            android:name=".ProfileTileService"
            android:exported="true"
            android:icon="@drawable/ic_settings_button_mapping"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- Not an active tile on purpose: the volume-button reset in the framework
                 clears the remap without telling this app, so SystemUI must bind the
                 tile each time the panel opens to show the right profile -->
        </service>
    </application>
</manifest>
