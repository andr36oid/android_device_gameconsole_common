    <string name="beta_install_count">Instalar selecionados (<xliff:g id="count">%d</xliff:g>)</string>
    <string name="beta_not_now">Agora não</string>
    <string name="beta_done">Concluído</string>

    <!-- %s is the app version, e.g. 3.0.2 -->
    <string name="beta_version">Versão <xliff:g id="version">%s</xliff:g></string>
    <string name="state_not_installed">Não instalado</string>
    <string name="state_installed">Instalado</string>
