    <!-- %1$s is the kind of build (beta, dirty, debug), %2$s the full version -->
    <string name="beta_notice">Você está usando uma versão <xliff:g id="kind">%1$s</xliff:g> (<xliff:g id="version">%2$s</xliff:g>). Estes apps só são oferecidos nas versões beta e dirty. Eles não fazem parte das versões finais.</string>
    <string name="beta_notice_more">Escolha os que você quer testar. Você pode voltar aqui quando quiser em Configurações > Apps beta.</string>
