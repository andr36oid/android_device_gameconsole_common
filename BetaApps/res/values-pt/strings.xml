    <string name="state_install_failed">Não foi possível instalar: <xliff:g id="reason">%s</xliff:g></string>
    <string name="state_missing">O APK não está nesta versão</string>

    <!-- %1$d apps installed, %2$d failed -->
    <string name="result_summary">Instalados: <xliff:g id="ok">%1$d</xliff:g>, com falha: <xliff:g id="failed">%2$d</xliff:g>.</string>

