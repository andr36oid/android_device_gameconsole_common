<resources>
    <string name="beta_title">Beta apps</string>
    <string name="beta_summary">Extra apps for testers, not in release builds</string>

    <!-- %1$s is the kind of build (beta, dirty, debug), %2$s the full version -->
    <string name="beta_notice">You\'re running a <xliff:g id="kind" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">%1$s</xliff:g> build (<xliff:g id="version" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">%2$s</xliff:g>). These apps are only offered in beta and dirty builds. They are not part of release builds.</string>
    <string name="beta_notice_more">Pick the ones you want to try. You can come back here any time from Settings > Beta apps.</string>
    <string name="beta_kind_unknown">test</string>
    <string name="beta_version_unknown">unknown version</string>
    <string name="beta_empty">This build has no beta apps.</string>

    <string name="beta_install">Install selected</string>
