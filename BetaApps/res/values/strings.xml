    <string name="beta_install_count">Install selected (<xliff:g id="count" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">%d</xliff:g>)</string>
    <string name="beta_not_now">Not now</string>
    <string name="beta_done">Done</string>

    <!-- %s is the app version, e.g. 3.0.2 -->
    <string name="beta_version">Version <xliff:g id="version" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">%s</xliff:g></string>
    <string name="state_not_installed">Not installed</string>
    <string name="state_installed">Installed</string>
