    <string name="beta_notice">Bir <xliff:g id="kind" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">%1$s</xliff:g> derlemesi kullanıyorsunuz (<xliff:g id="version" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">%2$s</xliff:g>). Bu uygulamalar yalnızca beta ve dirty derlemelerde sunulur. Sürüm derlemelerinde yer almazlar.</string>
    <string name="beta_notice_more">Denemek istediklerinizi seçin. Buraya istediğiniz zaman Ayarlar > Beta uygulamalar üzerinden dönebilirsiniz.</string>
