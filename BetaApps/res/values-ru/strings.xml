    <string name="beta_install_count">Установить выбранные (<xliff:g id="count">%d</xliff:g>)</string>
    <string name="beta_not_now">Не сейчас</string>
    <string name="beta_done">Готово</string>

    <!-- %s is the app version, e.g. 3.0.2 -->
    <string name="beta_version">Версия <xliff:g id="version">%s</xliff:g></string>
    <string name="state_not_installed">Не установлено</string>
