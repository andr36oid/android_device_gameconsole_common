<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="beta_title">Бета-приложения</string>
    <string name="beta_summary">Доп. приложения для тестеров, нет в релизных сборках</string>

    <!-- %1$s is the kind of build (beta, dirty, debug), %2$s the full version -->
    <string name="beta_notice">У вас сборка типа <xliff:g id="kind">%1$s</xliff:g> (<xliff:g id="version">%2$s</xliff:g>). Эти приложения предлагаются только в сборках beta и dirty. В релизные сборки они не входят.</string>
    <string name="beta_notice_more">Выберите те, что хотите попробовать. Вернуться сюда можно в любой момент: Настройки &gt; Бета-приложения.</string>
    <string name="beta_kind_unknown">test</string>
    <string name="beta_version_unknown">неизвестная версия</string>
    <string name="beta_empty">В этой сборке нет бета-приложений.</string>

    <string name="beta_install">Установить выбранные</string>
