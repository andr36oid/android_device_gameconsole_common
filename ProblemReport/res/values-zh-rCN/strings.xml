    <string name="report_title">问题报告</string>
    <string name="report_summary">将日志保存到 SD 卡，以便随错误报告一起发送</string>

    <string name="intro">出问题了？请保存一份报告，并在向我们反馈问题时附上。报告包含当前和上次启动时的系统日志、崩溃报告以及这台掌机的说明信息。大约需要 1 分钟。</string>

    <string name="note_title">出了什么问题？</string>
    <string name="note_hint">可选。您当时在做什么，发生了什么？</string>
    <string name="note_dialog">描述一下问题。这段描述会写入报告。</string>

    <string name="save_title">保存报告</string>
    <string name="save_summary">保存到 EASYROMS 上的 andr36oid-reports 文件夹</string>
