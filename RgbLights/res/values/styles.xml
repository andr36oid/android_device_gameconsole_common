<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark DayNight with a settings-style action bar, so the back arrow and title
         render like the Settings > Display screen (this is reached from there). The
         background is forced true black to match the mockup; the accent is the
         user's system accent (never pinned). RgbView reads textColorPrimary,
         textColorSecondary and colorAccent from this theme for its drawing. -->
    <style name="RgbTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:colorEdgeEffect">?android:attr/colorAccent</item>
    </style>
</resources>
