// Settings > Personalization: accent colour, UI sounds and boot animation in one
// d-pad friendly page (the pieces live in ../themes).
android_app {
    name: "ConsoleLook",
    static_libs: ["andr36oid-hint-bar"],
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
