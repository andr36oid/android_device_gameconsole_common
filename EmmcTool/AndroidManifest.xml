<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.andr36oid.emmc"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REBOOT" />
    <!-- the installer comes back on top when the home app covers it after a restart -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_emmc"
        android:label="@string/emmc_title"
        android:supportsRtl="true">

        <!-- Injected into Settings > System (under Advanced). Off until BootReceiver finds
             the eMMC switched on by Kernel Tweaks for this start. -->
        <activity
            android:name=".EmmcActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/emmc_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/emmc_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_emmc" />
        </activity>

        <!-- eMMC Installation. Opened from Settings through InstallEntry, and by
             BootReceiver after a restart the installation asked for. -->
        <activity
            android:name=".InstallActivity"
            android:exported="false"
            android:label="@string/inst_title"
            android:theme="@style/Andr36oidSetupTheme" />

        <!-- Injected into Settings > System (under Advanced). Off until BootReceiver finds
             the eMMC switched on and andr36oid started from the SD card. -->
        <activity-alias
            android:name=".InstallEntry"
            android:enabled="false"
            android:exported="true"
            android:label="@string/inst_title"
            android:targetActivity=".InstallActivity">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/inst_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_emmc" />
        </activity-alias>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
