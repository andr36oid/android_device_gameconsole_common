<?xml version="1.0" encoding="utf-8"?>
<!-- System uid so it may set the persist.andr36oid.stick_* properties -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.andr36oid.stickcalibration"
    android:sharedUserId="android.uid.system">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_stick_calibration"
        android:label="@string/cal_title"
        android:supportsRtl="true">

        <!-- Opened from Settings > Controls (Controllers app), not an entry of its own -->
        <activity
            android:name=".StickCalibrationActivity"
            android:exported="true"
            android:label="@string/cal_title"
            android:screenOrientation="nosensor"
            android:theme="@style/StickCalibrationTheme">
        </activity>
    </application>
</manifest>
