    <string name="app_name">Touch controls</string>
    <string name="settings_summary">Play touchscreen games with the buttons, per app</string>

    <!-- Settings > Touch controls -->
    <string name="settings_intro">Some games only work with a touchscreen. Here you can give such a game its own layout: each button or stick touches a spot on the screen. The layout switches on by itself while that game is in front, and every other app keeps the normal buttons.</string>
