 	void IRFrontend::Comp_Vh2f(MIPSOpcode op) {
 		CONDITIONAL_DISABLE(VFPU_VEC);
-		if (js.HasUnknownPrefix() || !IsPrefixWithinSize(js.prefixS, op)) {
+		if (js.HasUnknownPrefix() || js.HasSPrefix()) {
 			DISABLE;
 		}
 
 		// Vector expand half to float
 		// d[N*2] = float(lowerhalf(s[N])), d[N*2+1] = float(upperhalf(s[N]))
+		//
+		// Same steps as ExpandHalf() (half_to_float_fast5), written with integer and float ops
+		// so it stays in translated code instead of calling the interpreter:
+		//   bits = float((h & 0x7fff) << 13) * 2^112
+		//   Inf/NaN (exponent 31): bits = 0x7f800000 | (h & 0x3ff)
+		//   bits |= sign
 
-		DISABLE;
+		VectorSize sz = GetVecSize(op);
+		VectorSize outsize;
+		switch (sz) {
+		case V_Single:
+			outsize = V_Pair;
+			break;
+		case V_Pair:
+			outsize = V_Quad;
+			break;
+		default:
+			DISABLE;
+		}
+
+		u8 sregs[2], dregs[4];
+		GetVectorRegsPrefixS(sregs, sz, _VS);
+		GetVectorRegsPrefixD(dregs, outsize, _VD);
+		int nOut = GetNumVectorElements(outsize);
+
+		const u8 word = IRTEMP_0, h = IRTEMP_1, bits = IRTEMP_2, mask = IRTEMP_3;
+		const u8 ftemp = IRVTEMP_0, fmagic = IRVTEMP_0 + 1;
+		ir.Write(IROp::SetConstF, fmagic, ir.AddConstantFloat(5192296858534827628530496329220096.0f));  // 2^112
+
+		// Results go to temps first, the destination may overlap the source.
+		for (int i = 0; i < nOut; i++) {
+			ir.Write(IROp::FMovToGPR, h, sregs[i / 2]);
+			if (i & 1)
+				ir.Write(IROp::ShrImm, h, h, 16);
+			else
+				ir.Write(IROp::AndConst, h, h, ir.AddConstant(0xFFFF));
+
+			// Finite values.
+			ir.Write(IROp::AndConst, bits, h, ir.AddConstant(0x7FFF));
+			ir.Write(IROp::ShlImm, bits, bits, 13);
+			ir.Write(IROp::FMovFromGPR, ftemp, bits);
+			ir.Write(IROp::FMul, ftemp, ftemp, fmagic);
+			ir.Write(IROp::FMovToGPR, bits, ftemp);
+
+			// mask = all ones when the exponent is 31.
+			ir.Write(IROp::AndConst, mask, h, ir.AddConstant(0x7C00));
+			ir.Write(IROp::AddConst, mask, mask, ir.AddConstant(0x0400));
+			ir.Write(IROp::ShrImm, mask, mask, 15);
+			ir.Write(IROp::Neg, mask, mask);
+
+			// word = 0x7f800000 | (h & 0x3ff), then select it where mask is set.
+			ir.Write(IROp::OrConst, word, h, ir.AddConstant(0xFFFFFC00));
+			ir.Write(IROp::AndConst, word, word, ir.AddConstant(0x7F8003FF));
+			ir.Write(IROp::Xor, word, word, bits);
+			ir.Write(IROp::And, word, word, mask);
+			ir.Write(IROp::Xor, bits, bits, word);
+
+			// Sign.
+			ir.Write(IROp::AndConst, h, h, ir.AddConstant(0x8000));
+			ir.Write(IROp::ShlImm, h, h, 16);
+			ir.Write(IROp::Or, bits, bits, h);
+			ir.Write(IROp::FMovFromGPR, IRVTEMP_PFX_T + i, bits);
+		}
+
+		for (int i = 0; i < nOut; i++) {
+			ir.Write(IROp::FMov, dregs[i], IRVTEMP_PFX_T + i);
+		}
+		ApplyPrefixD(dregs, outsize, _VD);
 	}
 
