on post-fs-data
    mkdir /data/misc/gameconsole 0700 root root
    # before system_server starts: it reads the folder access (URI grants) for
    # Daijishou only then. Waits for it; the step is a blkid call and a small file.
    exec_start gameconsole-emu-early

service gameconsole-emu /system/bin/gameconsole-setup main
    class main
    user root
    group root system
    disabled
    oneshot

service gameconsole-emu-early /system/bin/gameconsole-setup early
    user root
    group root system
    disabled
    oneshot

# All of these but the early one go through one worker (setup/internal/worker): a
# start while another works leaves its request and exits, the worker runs it next.
on property:sys.boot_completed=1
    start gameconsole-emu

# Settings > Controllers changed who is player 1 in RetroArch: written into
# retroarch.cfg once RetroArch is closed (gameconsole-setup, RetroArchPlayers)
service gameconsole-ra-players /system/bin/gameconsole-setup players
    class main
    user root
    group root system
    disabled
    oneshot

on property:persist.andr36oid.ra_player1=*
    start gameconsole-ra-players

# The setup's app page (QuickStart) was left with Next: install the picked bundled
# apps now instead of at the next start (gameconsole-setup, InstallAPKs)
service gameconsole-apps /system/bin/gameconsole-setup apps
    class main
    user root
    group root system
    disabled
    oneshot

on property:sys.andr36oid.apps_chosen=1
    start gameconsole-apps

# The Magisk app was updated past the root in ramdisk.uimg: rebuild it while the boot
# animation says so ("Rebuilding Magisk RAM disk ..."), then restart (setup/internal/magisk)
service gameconsole-magisk /system/bin/gameconsole-setup magisk
    user root
    group root system
    disabled
    oneshot

on property:init.svc.bootanim=running
    start gameconsole-magisk

# A PortMaster session may have added or removed ports: refresh Daijishou's Ports
# library so it matches EmulationStation without a reboot (gameconsole-setup,
# ReconcilePorts). The broker sets this after a PortMaster handoff.
service gameconsole-ports /system/bin/gameconsole-setup reconcile-ports
    class main
    user root
    group root system
    disabled
    oneshot

on property:sys.andr36oid.ports_changed=1
    start gameconsole-ports
    setprop sys.andr36oid.ports_changed 0

# Every subsystem session can change favorites or play history in EmulationStation.
service gameconsole-library /system/bin/gameconsole-setup sync-library
    class main
    user root
    group root system
    disabled
    oneshot

on property:sys.andr36oid.subsystem_changed=1
    start gameconsole-library
    setprop sys.andr36oid.subsystem_changed 0
