    <string name="ime_name">手柄键盘</string>
    <!-- Hint line above the keys. Buttons on keys (B, X, Y, START, SELECT, L3) are shown on the keys themselves. -->
    <string name="hint_grid">按住 A：重音字母 · L1/R1 移动光标 · L2 隐藏 · R2 大字 · R3 摇杆输入</string>
    <string name="hint_sticks">左摇杆：选组 · 右摇杆：选字母，松开即输入 · B 删除 · X 空格 · Y 大小写 · START 回车 · R3 按键</string>
    <string name="stick_left">选组</string>
