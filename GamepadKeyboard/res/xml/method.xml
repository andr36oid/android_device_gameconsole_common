<?xml version="1.0" encoding="utf-8"?>
<!-- Not marked default: the Android TV keyboard (LeanbackIME) stays the default keyboard.
     This one is installed and can be chosen in Settings > System > Languages & input.
     One subtype per Latin-script language with its own layout or accents; other languages
     fall back to en_US (QWERTY). The layout itself is chosen in code from the locale. -->
