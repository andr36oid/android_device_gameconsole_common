# Sony DualSense Edge controller (054c:0df2), hid-playstation. The same
# layout as Vendor_054c_Product_0ce6.kl, see there.

# Cross, Circle, Square, Triangle
key 0x130   BUTTON_A
key 0x131   BUTTON_B
key 0x134   BUTTON_X
key 0x133   BUTTON_Y

key 0x136   BUTTON_L1
key 0x137   BUTTON_R1
key 0x138   BUTTON_L2
key 0x139   BUTTON_R2
axis 0x02   LTRIGGER
axis 0x05   RTRIGGER

# Left stick, right stick
axis 0x00   X
axis 0x01   Y
axis 0x03   Z
axis 0x04   RZ
key 0x13d   BUTTON_THUMBL
key 0x13e   BUTTON_THUMBR

axis 0x10   HAT_X
axis 0x11   HAT_Y

# Create, Options, PS button
key 0x13a   BUTTON_SELECT
key 0x13b   BUTTON_START
key 0x13c   BUTTON_MODE
