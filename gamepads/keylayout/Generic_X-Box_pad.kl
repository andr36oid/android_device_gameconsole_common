# Every Xbox-style pad the kernel's xpad driver knows only by its maker, not
# by model: xpad names all of them "Generic X-Box pad", and Android looks up a
# layout by that name when it has none for the vendor and product ID. That
# covers 8BitDo pads in X-input mode with their own ID (2dc8:xxxx), GameSir,
# PowerA, Hori, Nacon, Turtle Beach and the other makers xpad matches by
# class. Without this file Generic.kl put the right stick on RX/RY, which
# RetroArch and most games don't read, and the triggers on Z/RZ.
# Same as Android's Xbox 360 layout, Vendor_045e_Product_028e.kl.

key 304   BUTTON_A
key 305   BUTTON_B
key 307   BUTTON_X
key 308   BUTTON_Y
key 310   BUTTON_L1
key 311   BUTTON_R1
key 317   BUTTON_THUMBL
key 318   BUTTON_THUMBR

# Left stick, right stick, triggers
axis 0x00 X flat 4096
axis 0x01 Y flat 4096
axis 0x03 Z flat 4096
axis 0x04 RZ flat 4096
axis 0x02 LTRIGGER
axis 0x05 RTRIGGER

axis 0x10 HAT_X
axis 0x11 HAT_Y

# Back, Start, Guide
key 314   BUTTON_SELECT
key 315   BUTTON_START
key 316   BUTTON_MODE
