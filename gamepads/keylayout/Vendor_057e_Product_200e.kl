# Nintendo Switch Joy-Cons in the USB charging grip, hid-nintendo driver. Each
# Joy-Con is its own input device. The same letter layout as Android's Switch
# Pro Controller file (Vendor_057e_Product_2009.kl) and the built-in pad:
# A (right) = BUTTON_A, B (bottom) = BUTTON_B, X (top) = BUTTON_X,
# Y (left) = BUTTON_Y.

# B, A, X, Y
key 0x130    BUTTON_B
key 0x131    BUTTON_A
key 0x133    BUTTON_X
key 0x134    BUTTON_Y

# L, R, ZL, ZR
key 0x136    BUTTON_L1
key 0x137    BUTTON_R1
key 0x138    BUTTON_L2
key 0x139    BUTTON_R2

# Left Joy-Con stick, right Joy-Con stick
axis 0x00    X
axis 0x01    Y
axis 0x03    Z
axis 0x04    RZ
key 0x13d    BUTTON_THUMBL
key 0x13e    BUTTON_THUMBR

# Left Joy-Con arrow buttons
key 0x220    DPAD_UP
key 0x221    DPAD_DOWN
key 0x222    DPAD_LEFT
key 0x223    DPAD_RIGHT

# Minus, Plus, Capture, Home
key 0x13a    BUTTON_SELECT
key 0x13b    BUTTON_START
key 0x135    BUTTON_MODE
key 0x13c    HOME
