<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Controls. The console's own entries open the apps below; their titles are the
     apps' labels, and an app the build doesn't have is left out. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:key="console"
        android:title="@string/console_title">

        <Preference android:key="org.andr36oid.buttonmapper/.ButtonMappingActivity" />
        <!-- Which buttons the console has (summary from the saved check), and what does the
             Fn button's job: filled in by ControllersFragment -->
        <Preference
            android:key="button_check"
            android:title="@string/check_title" />
        <Preference
            android:key="fn_standin"
            android:title="@string/fn_standin_row" />
        <Preference android:key="org.andr36oid.stickcalibration/.StickCalibrationActivity" />
        <Preference android:key="org.andr36oid.controllertest/.ControllerTestActivity" />
        <Preference android:key="com.gameconsole.joymouse/.SettingsActivity" />
        <Preference android:key="org.andr36oid.touchmapper/.SettingsActivity" />
    </PreferenceCategory>

    <!-- Only on consoles with a rumble motor (the built-in pad offers rumble) -->
    <PreferenceCategory
        android:key="rumble"
        android:title="@string/rumble_title">

        <ListPreference
            android:key="rumble_strength"
            android:persistent="false"
            android:title="@string/rumble_strength_title"
            android:dialogTitle="@string/rumble_strength_title"
            android:summary="%s"
            android:entries="@array/rumble_strength_entries"
            android:entryValues="@array/rumble_strength_values" />

        <Preference
            android:key="rumble_test"
            android:title="@string/rumble_test_title"
            android:summary="@string/rumble_test_summary" />

        <Preference
            android:key="rumble_help"
            android:selectable="false"
            android:summary="@string/rumble_help" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="more"
        android:title="@string/more_title">

        <Preference
            android:key="external"
            android:title="@string/external_title" />

        <ListPreference
            android:key="player1"
            android:persistent="false"
            android:title="@string/player1_title"
            android:dialogTitle="@string/player1_title"
            android:summary="%s"
            android:entries="@array/player1_entries"
            android:entryValues="@array/player1_values" />
    </PreferenceCategory>
</PreferenceScreen>
