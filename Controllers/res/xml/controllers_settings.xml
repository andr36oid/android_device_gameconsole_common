<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:key="connected"
        android:title="@string/connected_title" />

    <PreferenceCategory
        android:key="retroarch"
        android:title="@string/retroarch_title">

        <ListPreference
            android:key="player1"
            android:persistent="false"
            android:title="@string/player1_title"
            android:dialogTitle="@string/player1_title"
            android:entries="@array/player1_entries"
            android:entryValues="@array/player1_values" />

        <Preference
            android:key="hotkeys"
            android:selectable="false"
            android:title="@string/hotkeys_title"
            android:summary="@string/hotkeys_summary" />

        <Preference
            android:key="ppsspp"
            android:selectable="false"
            android:title="@string/ppsspp_title"
            android:summary="@string/ppsspp_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="bluetooth"
        android:title="@string/bluetooth_title">

        <Preference
            android:key="pair"
            android:title="@string/pair_title"
            android:summary="@string/pair_summary" />
    </PreferenceCategory>
</PreferenceScreen>
