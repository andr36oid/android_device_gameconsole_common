    <!-- RetroArch -->
    <string name="player1_title">RetroArch でのプレイヤー 1</string>
    <string-array name="player1_entries">
        <item>内蔵の操作</item>
        <item>外部コントローラー</item>
    </string-array>
    <string name="player1_later">変更は次回 RetroArch を起動したときに反映されます。起動中の場合は、先に終了してください（Select + Start を 2 回押す）。</string>

    <!-- Bluetooth -->
    <string name="bluetooth_title">Bluetooth</string>
    <string name="pair_title">Bluetooth コントローラーをペアリング</string>
    <string name="pair_summary">ペアリングモードのコントローラーを検索</string>
    <string name="bluetooth_off">Bluetooth をオンにする</string>
    <string name="bluetooth_off_summary">Bluetooth はオフです</string>
    <string name="bluetooth_turning_on">Bluetooth をオンにしています…</string>
    <string name="bluetooth_missing">Bluetooth がありません</string>
    <string name="bluetooth_missing_summary">この本体には Bluetooth がありません。ワイヤレスコントローラーを使うには USB Bluetooth アダプターを OTG ポートに接続するか、USB コントローラーを使ってください。</string>
    <string name="paired_connected">ペアリング済み、接続中</string>
    <string name="paired_not_connected">ペアリング済みですが未接続です。コントローラーの電源を入れるか、A を押してください。</string>
    <string name="paired_dialog_connect">接続</string>
    <string name="paired_dialog_forget">削除</string>
    <string name="paired_forget_title">%1$s を削除しますか？</string>
    <string name="paired_forget_message">再び使うには、もう一度ペアリングしてください。</string>

    <!-- Pairing page -->
    <string name="pair_how_title">コントローラーをペアリングモードにする</string>
    <string name="pair_how">Xbox: 上の小さなペアリングボタンを、Xbox ボタンが速く点滅するまで押し続けます。\nPlayStation 4 または 5: Share（Create）と PS を、ライトが点滅するまで押し続けます。\nSwitch Pro: USB ポートの横にある上の小さなボタンを押し続けます。\n8BitDo: スイッチ、または Start + 任意のボタンでモードを選び、Pair を 3 秒間押し続けます。</string>
    <string name="pair_found_title">見つかったコントローラー</string>
    <string name="pair_searching">検索中…</string>
    <string name="pair_search_again">再検索</string>
    <string name="pair_search_again_summary">これ以上見つかりません。A を押すと再検索します。</string>
    <string name="pair_show_all">すべての Bluetooth 機器を表示</string>
    <string name="pair_show_all_summary">コントローラーと名乗らない機器も表示します</string>
    <string name="pair_device_summary">A を押してペアリング</string>
    <string name="pair_pairing">ペアリング中… 確認が表示されたら「ペアリング」を選んでください。</string>
    <string name="pair_connecting">ペアリング済み。接続中…</string>
    <string name="pair_connected">接続しました。すぐに使えます。</string>
    <string name="pair_failed">ペアリングに失敗しました。コントローラーをもう一度ペアリングモードにして、A を押してください。</string>
    <string name="pair_no_name">名前のない機器（%1$s）</string>

