    <string name="fn_combo_confirm_title">Usar %1$s + %2$s como FN?</string>
    <string name="fn_combo_confirm">Segure %1$s e aperte %2$s (ou o contrário) para abrir os atalhos com FN. O botão que você segura funciona normalmente, nos jogos também; o segundo só abre o FN enquanto o primeiro está segurado. Você pode mudar isso em Configurações &gt; Controles &gt; Atalhos com FN.</string>
    <string name="fn_standin_other">Usar outro botão como FN</string>
