<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.andr36oid.credits">

    <!-- Lucid from the Music folder plays during the credits; granted at the first start
         by etc/default-permissions/andr36oid-credits.xml -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="false"
        android:label="@string/credits_title"
        android:supportsRtl="true">

        <!-- Opened by tapping the andr36oid version in Settings > About console -->
        <activity
            android:name=".CreditsActivity"
            android:exported="true"
            android:label="@string/credits_title"
            android:screenOrientation="nosensor"
            android:theme="@style/CreditsTheme" />
    </application>
</manifest>
