<?xml version="1.0" encoding="utf-8"?>
<!-- andr36oid: speech bubble over the welcome screen icon; the tail sits 16 dp from the
     right edge (10 dp margin + half its width), WelcomeActivity lines it up with the icon -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical">
    <TextView
        android:id="@+id/bubble_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/andr36oid_bubble"
        android:maxWidth="240dp"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:textColor="#202020"
        android:textSize="14sp"
        android:textStyle="bold" />
    <ImageView
        android:layout_width="12dp"
        android:layout_height="7dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/andr36oid_bubble_tail" />
</LinearLayout>
