<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="app_title">存档备份</string>

    <!-- %1$s: a time, e.g. 14:02 -->
    <string name="today">今天 %1$s</string>
    <string name="yesterday">昨天 %1$s</string>
    <plurals name="files">
        <item quantity="other">%1$d 个文件</item>
    </plurals>
    <plurals name="games">
        <item quantity="other">%1$d 个游戏</item>
    </plurals>

    <!-- The summary in Settings and under Back up now -->
    <!-- %1$s: when, e.g. Today, 14:02; %2$s: e.g. 123 files -->
    <string name="last_backup">上次备份：%1$s，%2$s</string>
    <string name="last_none">还没有备份</string>
    <string name="last_no_saves">还没有找到存档文件</string>
    <!-- %1$s: the summary above, %2$s: what went wrong -->
    <string name="last_failed">%1$s\n上次尝试失败：%2$s</string>

    <string name="where_internal">内部存储空间</string>
    <string name="where_easyroms">EASYROMS</string>
    <string name="where_usb">U 盘</string>

    <!-- Progress, on the page and in the notification -->
    <string name="step_start">正在开始…</string>
    <string name="step_scan">正在查找存档文件…</string>
    <!-- %1$d: file number, %2$d: all files -->
    <string name="step_backup">正在备份第 %1$d 个文件，共 %2$d 个…</string>
    <string name="step_backup_plain">正在备份…</string>
    <string name="step_copy">正在将备份复制到其他位置…</string>
    <string name="step_list">正在读取备份…</string>
    <string name="step_plan">正在与掌机上的存档进行比较…</string>
    <string name="step_restore">正在恢复…</string>

    <!-- %1$s: e.g. 123 files -->
    <string name="backup_done">已备份 %1$s</string>
    <string name="backup_unchanged">自上次备份以来没有任何变化</string>
    <string name="backup_nothing">未找到存档文件。请先玩一下游戏并存档。</string>

    <string name="error_no_storage">没有可备份到的位置：内部存储空间和 EASYROMS 都不可用。</string>
    <string name="error_no_space">内部存储空间和 EASYROMS 上都没有足够的空间进行备份。</string>
    <string name="error_write_failed">无法写入备份。SD 卡可能出现故障：请将存档复制到电脑上。</string>
    <string name="error_no_usb">未找到 U 盘。请插入 U 盘后重试。</string>
    <string name="error_not_found">此备份已不存在。</string>
    <string name="error_safety_failed">未恢复任何内容：无法先备份将被替换的存档。请释放一些空间后重试。</string>
    <string name="error_busy">正在进行备份，请稍后重试。</string>
    <string name="error_start">存档备份无法运行。请重启掌机后重试。</string>

    <!-- The main page -->
    <string name="backup_now_title">立即备份</string>
    <string name="restore_title">恢复存档</string>
    <string name="restore_summary">选择一个备份，然后恢复全部或单个游戏。写入任何内容前，您都会先看到将发生的更改。</string>
    <string name="usb_title">立即备份到 U 盘</string>
    <!-- %1$s: the drive's name -->
    <string name="usb_summary">将最新的备份复制到 %1$s</string>
    <string name="usb_none">插入 U 盘，即可在 SD 卡之外另存一份副本</string>
    <string name="auto_category">自动备份</string>
    <string name="auto_title">自动备份</string>
    <string name="auto_summary">充电时每天一次，以及关闭游戏后。没有变化时跳过。关闭游戏后，超过 16 MB 的即时存档（PSP）等到每日备份时再备份。</string>
    <string name="keep_title">保留的备份数量</string>
    <!-- %1$s: a number -->
    <string name="keep_summary">保留最新的 %1$s 个备份，最近几天每天至少保留一个。更早的备份会被删除。</string>
    <string name="where_summary">备份会保存到两个位置：内部存储空间/Backups/Saves 和 EASYROMS/backups/saves，插入 U 盘时还会保存到 U 盘。这两个位置在同一张 SD 卡上，所以请不时将备份复制到电脑或 U 盘。RetroArch、PPSSPP 的存档以及游戏旁边的存档文件都会包含在内。</string>

    <!-- The list of backups -->
    <!-- %1$s: what's running -->
    <string name="waiting_for_backup">正在进行备份。%1$s</string>
    <string name="no_backups">还没有备份。请使用“立即备份”，或等待充电时的每日备份。</string>
    <!-- %1$s: e.g. 12 games, %2$s: e.g. 123 files, %3$s: size, %4$s: where -->
    <string name="backup_summary">%1$s，%2$s，%3$s\n位于%4$s</string>
    <!-- %1$s: where -->
    <string name="backup_broken">此备份已损坏，无法读取（位于%1$s）</string>

    <!-- One backup -->
    <string name="restore_all_title">全部恢复</string>
    <!-- %1$s: e.g. 123 files -->
    <string name="restore_all_summary">此备份中的全部 %1$s。会先显示将发生的更改。</string>
    <!-- %1$s: e.g. 3 files, %2$s: folders, %3$s: when -->
    <string name="game_summary">%1$s，位于 %2$s，保存于 %3$s</string>

    <!-- What restoring would do -->
    <string name="plan_title_all">全部恢复？</string>
    <!-- %1$s: the game -->
    <string name="plan_title_game">恢复 %1$s？</string>
    <plurals name="plan_missing">
        <item quantity="other">掌机上缺少 %1$d 个文件，将会放回。</item>
    </plurals>
    <plurals name="plan_older">
        <item quantity="other">掌机上有 %1$d 个较旧的存档将被备份中的替换。</item>
    </plurals>
    <plurals name="plan_newer">
        <item quantity="other">掌机上有 %1$d 个存档比备份更新，将予以保留：</item>
    </plurals>
    <!-- %1$s: file name, %2$s: its time on the console, %3$s: its time in the backup -->
    <string name="plan_newer_item">• %1$s（掌机：%2$s，备份：%3$s）</string>
    <!-- %1$d: how many more -->
    <string name="plan_more">• 以及另外 %1$d 个</string>
    <plurals name="plan_same">
        <item quantity="other">%1$d 个文件已经相同。</item>
    </plurals>
    <plurals name="plan_unavailable">
        <item quantity="other">%1$d 个文件属于 EASYROMS，但 EASYROMS 尚未装载，目前无法恢复。</item>
    </plurals>
    <string name="plan_nothing">没有需要恢复的内容。</string>
    <string name="plan_note">任何将被替换的内容都会先备份。恢复前请退出 RetroArch 和 PPSSPP，否则它们关闭时可能会覆盖已恢复的存档。</string>
    <string name="restore_button">恢复</string>
    <string name="replace_newer_button">较新的也替换</string>
    <string name="replace_newer_title">替换较新的存档？</string>
    <plurals name="replace_newer_message">
        <item quantity="other">掌机上有 %1$d 个存档比备份更新。替换后，相应游戏会回到较早的进度。较新的存档会先备份。</item>
    </plurals>
    <string name="replace_button">替换</string>

    <string name="result_title">恢复完成</string>
    <plurals name="result_restored">
        <item quantity="other">已恢复 %1$d 个文件。</item>
    </plurals>
    <plurals name="result_kept">
        <item quantity="other">已保留 %1$d 个较新的存档。</item>
    </plurals>
    <plurals name="result_failed">
        <item quantity="other">有 %1$d 个文件无法写入。SD 卡可能已满或出现故障。</item>
    </plurals>

    <!-- The notification while an automatic backup runs -->
    <string name="channel_name">存档备份运行中</string>
    <string name="notification_title">正在备份存档</string>
</resources>
