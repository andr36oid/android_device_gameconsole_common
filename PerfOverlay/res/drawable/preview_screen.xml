<?xml version="1.0" encoding="utf-8"?>
<!-- Sky over grass, so the overlay is seen against something bright like in a game -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#5C9DE0"
        android:centerColor="#A8D0F0"
        android:endColor="#4E8A3A" />
    <corners android:radius="6dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
