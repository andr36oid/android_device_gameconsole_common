<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <string name="app_title">Wi-Fi transfer</string>
    <string name="app_summary">Copy games from a phone or computer over the network</string>

    <string name="internal_storage">Internal storage</string>

    <!-- Server on -->
    <string name="open_in_browser">On a phone or computer on the same network, scan the code or open</string>
    <string name="pin_label">PIN</string>
    <!-- %1$s more addresses, e.g. "http://10.0.0.5:8080" -->
    <string name="other_urls">Also: <xliff:g id="urls">%1$s</xliff:g></string>
    <string name="qr_description">QR code with the address</string>
    <string name="status_waiting">Waiting for a browser to connect…</string>
    <string name="status_connected">Connected. Pick files in the browser to send them.</string>
    <!-- %1$s file name, %2$d percent, %3$s received so far, %4$s file size, %5$s speed per second -->
    <string name="status_receiving">Receiving <xliff:g id="name">%1$s</xliff:g>\n<xliff:g id="percent">%2$d</xliff:g>%%  ·  <xliff:g id="done">%3$s</xliff:g> of <xliff:g id="size">%4$s</xliff:g>  ·  <xliff:g id="speed">%5$s</xliff:g>/s</string>
    <!-- %1$d files, %2$s their total size -->
    <plurals name="status_received">
        <item quantity="one"><xliff:g id="count">%1$d</xliff:g> file received (<xliff:g id="size">%2$s</xliff:g>)</item>
        <item quantity="other"><xliff:g id="count">%1$d</xliff:g> files received (<xliff:g id="size">%2$s</xliff:g>)</item>
    </plurals>
    <plurals name="files_received">
        <item quantity="one"><xliff:g id="count">%1$d</xliff:g> file received</item>
        <item quantity="other"><xliff:g id="count">%1$d</xliff:g> files received</item>
    </plurals>

    <!-- %1$s address of the phone or computer -->
    <string name="warning_pin">Wrong PIN entered on <xliff:g id="address">%1$s</xliff:g></string>
    <string name="warning_locked">Too many wrong PINs from <xliff:g id="address">%1$s</xliff:g>, it has to wait a minute</string>
    <string name="warning_new_pin">Too many wrong PINs, so there is a new PIN</string>

    <string name="recent_title">Recent transfers</string>
    <!-- %1$s size, %2$s folder, e.g. "EASYROMS/snes", %3$s time -->
    <string name="recent_done"><xliff:g id="size">%1$s</xliff:g> to <xliff:g id="folder">%2$s</xliff:g>  ·  <xliff:g id="time">%3$s</xliff:g></string>
    <!-- %1$s why, %2$s time -->
    <string name="recent_failed">Failed: <xliff:g id="why">%1$s</xliff:g>  ·  <xliff:g id="time">%2$s</xliff:g></string>

    <!-- Server off, starting, no network -->
    <string name="starting">Starting…</string>
    <string name="off_title">Wi-Fi transfer is off</string>
    <string name="off_message">Turn it on to copy games and other files to this console from the browser of a phone or computer on the same network. No cable and no app needed.</string>
    <string name="stopped_idle">It turned itself off after 30 minutes without use.</string>
    <string name="no_network_title">No network</string>
    <string name="no_network_message">The console isn\'t connected to a network. Connect to Wi-Fi, or plug in a USB Wi-Fi or USB Ethernet adapter, in Settings &gt; Network &amp; internet.\n\nThe phone or computer you copy from has to be on the same network.</string>
    <string name="error_title">Can\'t start</string>
    <string name="error_message">The transfer server didn\'t start: <xliff:g id="error">%1$s</xliff:g></string>

    <!-- Button help at the bottom of the screen -->
    <string name="keys_on">A  Turn off     B  Close</string>
    <string name="keys_off">A  Turn on     B  Close</string>
    <string name="keys_network">X  Network settings</string>

    <!-- Foreground service notification -->
    <string name="channel_name">Wi-Fi transfer</string>
    <string name="notification_title">Wi-Fi transfer is on</string>
    <!-- %1$s address, %2$s PIN -->
    <string name="notification_text"><xliff:g id="url">%1$s</xliff:g>  ·  PIN <xliff:g id="pin">%2$s</xliff:g></string>
    <string name="notification_receiving">Receiving <xliff:g id="name">%1$s</xliff:g></string>
    <string name="notification_stop">Stop</string>

    <!-- Quick Settings tile -->
    <string name="tile_label">Wi-Fi transfer</string>
    <string name="tile_on">On</string>
    <string name="tile_off">Off</string>
</resources>
