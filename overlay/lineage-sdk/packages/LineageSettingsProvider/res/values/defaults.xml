<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Pure black background for the dark theme ("Pure black" under
         Settings > Display > Dark theme). SystemUI turns the black theme
         overlay off at boot unless this setting is set, so the dark theme
         default in the framework overlay alone only gives dark grey.
         Needs the LineageSettingsProvider change adding def_berry_black_theme. -->
    <bool name="def_berry_black_theme">true</bool>

    <!-- Never send LineageOS stats unless the user opts in (already the
         upstream default, pinned here since the setup wizard no longer asks) -->
    <bool name="def_stats_collection">false</bool>

</resources>
