<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Do not enable auto rotation switching -->
    <bool name="def_accelerometer_rotation">false</bool>

    <!-- Disable the lockscreen -->
    <bool name="def_lockscreen_disabled">true</bool>

    <!-- Let the screen time out on the charger too: many consoles sit on a charger for
         days, and a lit screen keeps the whole console awake and warm the whole time -->
    <bool name="def_stay_on_while_plugged_in">false</bool>

    <!-- Do not give up on DHCP -->
    <integer name="def_max_dhcp_retries">0</integer>
    
    <!-- disable network monitoring support -->
    <bool name="def_netstats_enabled">false</bool>

    <!-- ms until the system goes to sleep, 24 hours default for TV devices -->
    <integer name="def_sleep_timeout">86400000</integer>
  
    <!-- Screen off after 10 minutes without a button press (was never). Emulators keep the
         screen on by themselves while a game runs. -->
    <integer name="def_screen_off_timeout">600000</integer>

    <!-- Allow users to use both the on-screen keyboard, as well as a real
         keyboard -->
    <bool name="def_show_ime_with_hard_keyboard">true</bool> 
        
    <bool name="def_dim_screen">false</bool>
    <bool name="def_install_non_market_apps">true</bool>
    <string name="def_airplane_mode_radios">bluetooth,wifi</string>
    <string name="airplane_mode_toggleable_radios">bluetooth,wifi</string>
    <bool name="def_haptic_feedback">false</bool>
    <bool name="def_bluetooth_on">false</bool>
    <!-- Location off by default (0 == off, 3 == on); the setup wizard no
         longer asks about it -->
    <integer name="def_location_mode">0</integer>
    <!--    <bool name="def_device_provisioned">true</bool>  -->

    <!-- Window open/close and activity transitions at half length (0.5x in
         Developer options), so menus feel quicker on the slow CPU -->
    <fraction name="def_window_animation_scale">50%</fraction>
    <fraction name="def_window_transition_scale">50%</fraction>

    <!-- The retro charger sound, with the retro UI sounds on by default (themes/themes.mk) -->
    <string name="def_charging_started_sound" translatable="false">/product/media/audio/ui/andr36oid/charging.ogg</string>

</resources>
