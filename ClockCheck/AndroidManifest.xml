<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.andr36oid.clockcheck"
    android:sharedUserId="android.uid.system">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_clock_check"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- Checks the clock at boot. TIME_SET (the user or network time set the clock)
             clears the warning. Both are allowed for manifest receivers. -->
        <receiver
            android:name=".ClockReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
