<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="check_title">SD 卡检测</string>
    <string name="check_summary">测试速度，并检查是否为扩容假卡</string>

    <string name="card_title">存储卡或 U 盘</string>
    <string name="no_card">没有可用的 SD 卡或 U 盘。请插入一个，或等它显示在“存储”中。</string>

    <!-- details: %1$s name (EASYROMS), %2$s size of the whole card -->
    <string name="details_title">%1$s，%2$s 存储卡</string>
    <string name="details_title_usb">%1$s，%2$s U 盘</string>
    <!-- %1$s maker, %2$s product name, %3$s date made -->
    <string name="details_card">%1$s %2$s，生产于 %3$s</string>
    <string name="details_free">可用空间 %1$s</string>
    <string name="maker_unknown">未知厂商（ID %1$s）</string>
    <!-- %1$s the maker and model the card reports, e.g. "SanDisk SR256, made 2025-03" -->
    <string name="details_model">型号：%1$s</string>
    <!-- when the card reports no model name -->
    <string name="details_no_name">（无型号名称）</string>
    <string name="details_compare">请与卡上的标签对比。如果卡上印的品牌没有出现在这里，这张卡很可能是假的。</string>

    <string name="speed_category">速度</string>
    <string name="speed_title">测试速度</string>
    <string name="speed_summary">写入并读取一个 256 MB 的文件，大约需要 1 分钟。</string>
    <string name="speed_running_write">正在写入…</string>
    <string name="speed_running_read">正在读取…</string>
    <!-- %1$s write speed, %2$s read speed, e.g. 18.2 MB/s -->
    <string name="speed_result">写入 %1$s，读取 %2$s</string>
    <string name="speed_good">适合所有系统。</string>
    <string name="speed_ok">玩游戏没问题。复制和保存大文件会比较慢。</string>
    <string name="speed_slow">速度慢：加载时间会很长，尤其是 PSP、Dreamcast 和 N64 游戏。</string>
    <string name="mb_per_s">%1$.1f MB/s</string>

    <string name="full_category">实际容量</string>
    <string name="full_title">检查实际容量</string>
    <string name="full_title_stop">停止检查</string>
    <!-- %1$s free space, %2$s how long -->
    <string name="full_summary">用测试数据填满可用空间（%1$s），全部读回后再删除。虚标容量的假卡无法通过此检查。大约需要 %2$s。</string>
    <string name="full_summary_unknown_time">用测试数据填满可用空间（%1$s），全部读回后再删除。虚标容量的假卡无法通过此检查。大容量卡需要几个小时；可以先测试速度，以获得更准确的时间估算。</string>
    <string name="full_probe">正在查找假卡迹象…</string>
    <!-- %1$s done, %2$s total, %3$s time left -->
    <string name="full_writing">正在写入测试数据：%1$s / %2$s，大约还需 %3$s</string>
    <string name="full_reading">正在读回：%1$s / %2$s，大约还需 %3$s</string>
    <string name="full_writing_start">正在写入测试数据：%1$s / %2$s</string>
    <string name="full_reading_start">正在读回：%1$s / %2$s</string>
    <string name="full_stopping">正在停止并删除测试数据…</string>

    <string name="full_pass">通过。全部 %1$s 测试数据读回后与写入的一致。这张卡是真卡。</string>
    <string name="full_bad_data">未通过。有 %1$s 测试数据读回时出错，从大约 %2$s 之后开始。此卡是假卡或已损坏，实际只能存放大约 %3$s。请把游戏复制出来，换一张卡。</string>
    <string name="full_wraps">未通过。这是一张假卡：写入大约 %1$s 后就会从头覆盖，所以实际只能存放这么多。请让游戏总量低于这个数，最好还是换一张卡。</string>
    <string name="full_wraps_restored">检查在写入时发现了这个问题，并已恢复卡的开头部分。</string>
    <string name="full_wraps_not_restored">检查在写入时发现了这个问题，但无法恢复卡的开头部分。掌机可能无法再从此卡启动：请备份您的游戏。</string>
    <string name="full_write_error">未通过。写入 %1$s 测试数据后，卡报告了错误。它可能已损坏或是假卡。</string>
    <string name="full_stopped">已停止。测试数据已删除。</string>

    <string name="error_prefix">未完成。%1$s</string>
    <string name="error_no_space">可用空间不足，无法进行测试。</string>
    <string name="error_not_mounted">存储卡尚未就绪。</string>
    <string name="error_write">存储卡报告了写入错误。</string>
    <string name="error_read">存储卡报告了读取错误。</string>
    <string name="error_other">无法运行检查。</string>

    <string name="confirm_title">检查实际容量？</string>
    <!-- %1$s card name, %2$s how long -->
    <string name="confirm_text">此操作会占满 %1$s 上的全部可用空间，持续大约 %2$s，完成前游戏无法在上面存档。请接上充电器：掌机会保持唤醒。您可以随时停止。您的游戏和文件不会受到影响。</string>
    <string name="confirm_time_unknown">几个小时</string>
    <string name="confirm_start">开始</string>

    <string name="busy">另一项检查正在运行。</string>

    <string name="about">掌机常常搭配假卡或旧卡出售。假卡声称的容量比实际大，复制到实际容量之外的游戏读回来就是坏的。此检查只会写入可用空间。</string>

    <string name="hours_minutes">%1$d 小时 %2$d 分钟</string>
    <string name="minutes">%1$d 分钟</string>

    <string name="channel_name">SD 卡检测</string>
    <string name="done_title">SD 卡检测已完成</string>

    <string name="userdata_name">内部存储</string>
    <string name="details_userdata">此存储卡没有 EASYROMS 分区，因此测试将使用卡上的内部存储。实际容量检查会为 Android 预留 1 GB 可用空间。</string>
</resources>
