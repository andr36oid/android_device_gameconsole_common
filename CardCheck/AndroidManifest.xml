<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.andr36oid.cardcheck"
    android:sharedUserId="android.uid.system">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_card_check"
        android:label="@string/check_title"
        android:supportsRtl="true">

        <!-- Injected into Settings > Storage -->
        <activity
            android:name=".CardActivity"
            android:exported="true"
            android:label="@string/check_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.storage" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="card_check" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/check_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_card_check" />
        </activity>

        <!-- The check service says it's done; a long check gets a notification.
             Only root (the service) and the system can send it. -->
        <receiver
            android:name=".FinishedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="org.andr36oid.cardcheck.FINISHED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
