// Settings > Storage > SD card check: card details, a speed test and a real size check
// that finds fake cards. Runs as the system user like the other console apps; the
// reading and writing is done by the andr36oid-cardcheck init service (Android.mk),
// which needs root for the card itself and for EASYROMS.
android_app {
    name: "CardCheck",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}

// Random 4 KB reads and writes for the speed test (O_DIRECT, which toybox dd can't do).
// Run by the helper as root; pulled in by andr36oid-cardcheck in Android.mk.
cc_binary {
    name: "andr36oid-cardspeed",
    srcs: ["speed/cardspeed.c"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
