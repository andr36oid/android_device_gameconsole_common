<?xml version="1.0" encoding="utf-8"?>
<!-- The stick step's right-hand area: the live stick drawing on top, then a short hint and a
     chip per stick fix (issue #5). The activity adds the StickView into stick_holder and only
     shows the chips whose kernel knob this console has. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/stick_holder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/stick_fix_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/av_stick_hint"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:attr/textColorSecondary" />

    <LinearLayout
        android:id="@+id/stick_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/chip_invert_x"
            style="@style/Andr36oidSetupButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/chip_invert_y"
            style="@style/Andr36oidSetupButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/chip_swap"
            style="@style/Andr36oidSetupButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
