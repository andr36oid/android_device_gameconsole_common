<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Hands-on tutorial that runs once after the setup wizard -->
    <string name="tutorial_label">教程</string>
    <!-- Above the progress bar, e.g. "Step 3 of 11" -->
    <string name="tutorial_step">第 <xliff:g id="current">%1$d</xliff:g> 步，共 <xliff:g id="total">%2$d</xliff:g> 步</string>

    <!-- Buttons at the bottom -->
    <string name="tutorial_back">返回</string>
    <string name="tutorial_start">开始</string>
    <string name="tutorial_next">下一步</string>
    <string name="tutorial_skip_step">跳过此步</string>
    <string name="tutorial_skip_all">跳过教程</string>
    <!-- On the FN steps, for consoles without an FN button: skips all of them -->
    <string name="tutorial_no_fn">没有 FN 键</string>
    <string name="tutorial_done">完成</string>
    <string name="tutorial_open_guide">打开完整指南</string>

    <!-- Shown under the list once everything on a step was done -->
    <string name="tutorial_well_done">做得好。按 A 继续。</string>

    <!-- Welcome -->
    <string name="tutorial_welcome_title">来试试按键吧</string>
    <string name="tutorial_welcome_body">这台掌机没有触摸屏。所有操作都用按键完成，这个简短的教程会让您逐个试一遍。大约需要 3 分钟。\n\n按 A 继续，按 B 返回。已经会的步骤可以按 Select 跳过。</string>

    <!-- A, B, X, Y -->
    <string name="tutorial_face_title">A、B、X 和 Y</string>
    <string name="tutorial_face_body">A 用于确认：打开所选内容，按下屏幕上的按钮。\n\nB 用于返回，每次返回一个界面。\n\nX 和 Y 在不同的应用和游戏中有不同功能。\n\n每个键各按一次。</string>
    <string name="tutorial_press_a">按 A</string>
    <string name="tutorial_press_b">按 B</string>
    <string name="tutorial_press_x">按 X</string>
    <string name="tutorial_press_y">按 Y</string>

    <!-- D-pad -->
    <string name="tutorial_dpad_title">方向键</string>
    <string name="tutorial_dpad_body">方向键用于在屏幕上移动选择：在列表、菜单和按钮之间移动。在菜单中，左摇杆的作用相同。\n\n每个方向各按一次。</string>
    <string name="tutorial_dpad_up">上</string>
    <string name="tutorial_dpad_down">下</string>
    <string name="tutorial_dpad_left">左</string>
    <string name="tutorial_dpad_right">右</string>

    <!-- Sticks -->
    <string name="tutorial_sticks_title">摇杆</string>
    <string name="tutorial_sticks_body">游戏会用到两个摇杆。每个摇杆也可以像按键一样按下：这就是 L3 和 R3。\n\n推动两个摇杆，看圆点跟着移动，然后按下其中一个摇杆。</string>
    <string name="tutorial_stick_left">推动左摇杆</string>
    <string name="tutorial_stick_right">推动右摇杆</string>
    <string name="tutorial_stick_click">按下一个摇杆（L3 或 R3）</string>

    <!-- Shoulder buttons -->
    <string name="tutorial_shoulder_title">肩键</string>
    <string name="tutorial_shoulder_body">肩键在背面：L1 和 R1 在外侧，L2 和 R2 在它们旁边的内侧。很多应用用 L1 和 R1 切换标签页或页面。\n\n每个键各按一次。</string>
    <string name="tutorial_press_l1">按 L1</string>
    <string name="tutorial_press_r1">按 R1</string>
    <string name="tutorial_press_l2">按 L2</string>
    <string name="tutorial_press_r2">按 R2</string>

    <!-- FN = home -->
    <string name="tutorial_home_title">FN 是主屏幕键</string>
    <string name="tutorial_home_body">在任何地方（即使在游戏中）单独按 FN 都能回到主屏幕。主屏幕是 Daijishou，您的游戏和应用都在那里。\n\n现在试一下：按 FN。几秒后本教程会自动回来。</string>
    <string name="tutorial_home_body_simple">在任何地方（即使在游戏中）单独按 FN 都能回到主屏幕。主屏幕是 Simple UI：常用应用在“已固定”中，所有应用在“应用”中。\n\n现在试一下：按 FN。几秒后本教程会自动回来。</string>
    <string name="tutorial_home_task">按 FN</string>
    <string name="tutorial_home_back">欢迎回来。就是这么简单。</string>

    <!-- FN + volume -->
    <string name="tutorial_brightness_title">FN 快捷键：亮度</string>
    <string name="tutorial_brightness_body">FN 还有第二个用途：按住它再按另一个按键，即可使用快捷键。\n\n按住 FN 再按音量+ 可调亮屏幕。按住 FN 再按音量− 可调暗屏幕。单独按音量键仍然调节音量。</string>
    <string name="tutorial_brightness_up">调亮：FN + 音量+</string>
    <string name="tutorial_brightness_down">调暗：FN + 音量−</string>
    <string name="tutorial_brightness_hint">已经最亮了？先调暗。</string>
    <!-- After FN alone was pressed on a step that wants FN plus another button -->
    <string name="tutorial_fn_alone">刚才只按了 FN，所以打开了主屏幕。请按住 FN 不放，再按第二个按键。</string>

    <!-- FN + Y -->
    <string name="tutorial_shade_title">FN 快捷键：快捷设置</string>
    <string name="tutorial_shade_body">按住 FN 再按 Y，可以打开通知和快捷设置，其中有 WLAN、蓝牙等图块。\n\n现在打开它。再按一次 FN + Y 即可关闭。</string>
    <string name="tutorial_shade_open">打开：FN + Y</string>

    <!-- Joystick mouse -->
    <string name="tutorial_mouse_title">摇杆鼠标</string>
    <string name="tutorial_mouse_body">少数应用需要触摸屏。在这些应用中，可以用右摇杆移动鼠标指针。A 为点击，L1 为右键点击，左摇杆用于滚动。\n\n要开启或关闭，请同时按下两个摇杆（L3 + R3）1 秒。</string>
    <string name="tutorial_mouse_body_fn">少数应用需要触摸屏。在这些应用中，可以用右摇杆移动鼠标指针。A 为点击，L1 为右键点击，左摇杆用于滚动。\n\n要开启或关闭，请同时按下两个摇杆（L3 + R3）1 秒，或按 FN + X。</string>
    <string name="tutorial_mouse_on">开启鼠标</string>
    <string name="tutorial_mouse_off">再次关闭</string>

    <!-- Power -->
    <string name="tutorial_power_title">电源键</string>
    <string name="tutorial_power_body">短按电源键让掌机休眠，再短按一次即可唤醒。\n\n按住电源键 1 秒可打开电源菜单：关机、重启等。按 B 关闭菜单。</string>
    <string name="tutorial_power_sleep">短按电源键休眠，再按一次唤醒</string>
    <string name="tutorial_power_menu">按住电源键打开菜单，然后按 B 关闭</string>

    <!-- Games -->
    <string name="tutorial_games_title">游戏放在哪里</string>
    <string name="tutorial_games_body">将 SD 卡插入电脑。除了一个小的 BOOT 磁盘，还会显示一个名为 EASYROMS 的大磁盘：那是放游戏的地方。\n\n为每个系统建一个单独的文件夹，命名为 nes、snes、gba、megadrive 或 psx 等。\n\n然后打开 Daijishou（按 FN），添加一个平台，并在 EASYROMS 上选择对应的文件夹。Daijishou 会列出游戏，并用 RetroArch 或 PPSSPP 启动它们。</string>
    <string name="tutorial_games_body_no_fn">将 SD 卡插入电脑。除了一个小的 BOOT 磁盘，还会显示一个名为 EASYROMS 的大磁盘：那是放游戏的地方。\n\n为每个系统建一个单独的文件夹，命名为 nes、snes、gba、megadrive 或 psx 等。\n\n然后打开 Daijishou，添加一个平台，并在 EASYROMS 上选择对应的文件夹。Daijishou 会列出游戏，并用 RetroArch 或 PPSSPP 启动它们。</string>
    <!-- Under the games text, when the EASYROMS partition was found -->
    <string name="tutorial_games_space">此卡上的 EASYROMS：共 <xliff:g id="total">%2$s</xliff:g>，可用 <xliff:g id="free">%1$s</xliff:g>。</string>

    <!-- Finish -->
    <string name="tutorial_done_title">准备就绪</string>
    <string name="tutorial_done_body">基础知识就是这些。\n\n快速入门指南会介绍更多内容：模拟器、速度和电池、上网，以及出问题时该怎么办。可以在这里打开，也可以随时从“设置 &gt; 快速入门指南”打开。</string>
    <string name="tutorial_done_body_fn_help">基础知识就是这些。忘了某个快捷键？在任何应用或游戏中单独按住 FN 片刻，即可查看全部快捷键。\n\n快速入门指南会介绍更多内容：模拟器、速度和电池、上网，以及出问题时该怎么办。可以在这里打开，也可以随时从“设置 &gt; 快速入门指南”打开。</string>

    <!-- Guide bottom bar: X opens the tutorial -->
    <string name="hint_tutorial">教程</string>
    <string name="tutorial_change_fn">更改 FN</string>
</resources>
