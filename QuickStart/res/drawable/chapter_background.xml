<?xml version="1.0" encoding="utf-8"?>
<!-- A chapter in the list: accent ring when focused, soft fill when it is the one shown -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#2680DEEA" />
            <stroke android:width="2dp" android:color="@color/guide_accent" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="@color/guide_panel" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
