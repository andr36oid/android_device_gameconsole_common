<?xml version="1.0" encoding="utf-8"?>
<!-- The page: a faint panel, ringed while the D-pad scrolls it -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="@color/guide_panel" />
            <stroke android:width="2dp" android:color="@color/guide_accent" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="@color/guide_panel" />
        </shape>
    </item>
</selector>
