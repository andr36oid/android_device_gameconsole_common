<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.andr36oid.guide"
    android:sharedUserId="android.uid.system">

    <!-- Held by the first-start launcher (org.andr36oid.firststart, signed with the same key)
         to tell FirstStartReceiver that it came to the front -->
    <permission
        android:name="org.andr36oid.guide.permission.FIRST_START"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_quick_start"
        android:label="@string/guide_title"
        android:supportsRtl="true">

        <!-- Injected into the top level of the Settings app, above Button mapping -->
        <activity
            android:name=".GuideActivity"
            android:exported="true"
            android:label="@string/guide_title"
            android:screenOrientation="nosensor"
            android:theme="@style/GuideTheme">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-66" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="top_level_quick_start" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/guide_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_quick_start" />
            <meta-data
                android:name="com.android.settings.bg.hint"
                android:resource="@color/guide_icon_background" />
        </activity>

        <!-- Hands-on tutorial: the first-start launcher opens it once after setup, through
             FirstStartReceiver. X in the guide opens it again. The action is for adb:
             am start -a org.andr36oid.guide.action.TUTORIAL -->
        <activity
            android:name=".TutorialActivity"
            android:exported="true"
            android:label="@string/tutorial_label"
            android:launchMode="singleTask"
            android:taskAffinity="org.andr36oid.guide.tutorial"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|navigation|touchscreen|orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/TutorialTheme">
            <intent-filter>
                <action android:name="org.andr36oid.guide.action.TUTORIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings > Apps & notifications > Home screen: switch between Daijishou and our
             launcher, remove or bring back the other one. Off unless the build ships both
             (FirstBootReceiver switches it on), so the row isn't there otherwise. -->
        <activity
            android:name=".HomeScreenActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/home_screen_title"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.apps" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-10" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="andr36oid_home_screen" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/home_screen_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_home_screen" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
        </activity>

        <!-- The same tutorial as the setup wizard's last page, in the wizard's task -->
        <activity
            android:name=".SetupTutorialActivity"
            android:exported="true"
            android:label="@string/tutorial_label"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|navigation|touchscreen|orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/TutorialTheme">
            <intent-filter>
                <action android:name="org.andr36oid.guide.action.SETUP_TUTORIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The setup wizard's page after the home screen choice: which bundled apps to
             install (all offline, from the card) -->
        <activity
            android:name=".SetupAppsActivity"
            android:exported="true"
            android:label="@string/setup_apps_title"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|navigation|touchscreen|orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/TutorialTheme">
            <intent-filter>
                <action android:name="org.andr36oid.guide.action.SETUP_APPS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The setup wizard's page after the tutorial: shut down now to copy games onto
             EASYROMS -->
        <activity
            android:name=".SetupAddGamesActivity"
            android:exported="true"
            android:label="@string/add_games_title"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|navigation|touchscreen|orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/TutorialTheme">
            <intent-filter>
                <action android:name="org.andr36oid.guide.action.SETUP_ADD_GAMES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The first start's safety net at boot and after the wizard: starts the watchdog
             while the first-start launcher is home, removes a left-over launcher. Switches
             itself off once the first start is over. -->
        <receiver
            android:name=".FirstBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- From the first-start launcher: it came to the front (opens the tutorial, or FN
             was pressed), Back to the tutorial, Skip tutorial -->
        <receiver
            android:name=".FirstStartReceiver"
            android:exported="true"
            android:permission="org.andr36oid.guide.permission.FIRST_START">
            <intent-filter>
                <action android:name="org.andr36oid.guide.action.FIRST_START_HOME" />
                <action android:name="org.andr36oid.guide.action.FIRST_START_OPEN" />
                <action android:name="org.andr36oid.guide.action.FIRST_START_SKIP" />
            </intent-filter>
        </receiver>

        <!-- The first start's watchdog alarm and the launcher's uninstall result -->
        <receiver
            android:name=".FirstStartWatchdog"
            android:exported="false" />

        <service
            android:name=".SetupDoneJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
