<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.andr36oid.guide"
    android:sharedUserId="android.uid.system">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_quick_start"
        android:label="@string/guide_title"
        android:supportsRtl="true">

        <!-- Injected into the top level of the Settings app, above Button mapping -->
        <activity
            android:name=".GuideActivity"
            android:exported="true"
            android:label="@string/guide_title"
            android:screenOrientation="nosensor"
            android:theme="@style/GuideTheme">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-66" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="top_level_quick_start" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/guide_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_quick_start" />
            <meta-data
                android:name="com.android.settings.bg.hint"
                android:resource="@color/guide_icon_background" />
        </activity>

        <!-- Hands-on tutorial: FirstBootReceiver opens it once after setup, when the home
             screen has settled. X in the guide opens it again. The action is for adb:
             am start -a org.andr36oid.guide.action.TUTORIAL -->
        <activity
            android:name=".TutorialActivity"
            android:exported="true"
            android:label="@string/tutorial_label"
            android:launchMode="singleTask"
            android:taskAffinity="org.andr36oid.guide.tutorial"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|navigation|touchscreen|orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/TutorialTheme">
            <intent-filter>
                <action android:name="org.andr36oid.guide.action.TUTORIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Opens the tutorial once the setup wizard is done and the home screen has
             settled -->
        <receiver
            android:name=".FirstBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".SetupDoneJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
