// The quick start guide: shown once after the first setup, and from Settings > Quick start
// guide. Runs as the system user so it may open by itself after setup.
android_app {
    name: "Andr36oidGuide",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
