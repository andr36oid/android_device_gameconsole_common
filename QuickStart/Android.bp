// The quick start guide and the hands-on tutorial: Settings > Quick start guide, and the
// tutorial once after the first setup (see FirstStart.java). Runs as the system user, so it may
// open by itself, give the home role to the chosen home screen (Daijishou or our launcher, see
// HomeChoice.java) and uninstall the first-start launcher.
android_app {
    name: "Andr36oidGuide",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: ["andr36oid-console-art", "andr36oid-setup-theme", "andr36oid-hint-bar"],
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
