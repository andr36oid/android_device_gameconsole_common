import /vendor/etc/init/hw/init.${ro.target.product}.rc
import /vendor/etc/init/hw/init.rk30board.usb.rc

# Keeps a journal and gives storage back after either process restarts.
service andr36oid-usb-drive /system/bin/sh /system/etc/andr36oid-usb-drive.sh
    class late_start
    user root
    group root system mount
    seclabel u:r:shell:s0
    disabled
    oneshot

# The shared USB helper starts this only after taking ownership of g1.
service andr36oid-controller /system/bin/andr36oid-controller ${sys.andr36oid.usbdrive.target}
    class late_start
    user root
    group root system input
    seclabel u:r:shell:s0
    disabled
    oneshot

on property:sys.boot_completed=1
    start andr36oid-usb-drive

on property:sys.andr36oid.usbdrive.request=start
    start andr36oid-usb-drive

# One recovery attempt after a controller helper crash, including setup before
# the native daemon is ready. Clear the flag first to avoid a recovery loop.
on property:init.svc.andr36oid-usb-drive=stopped && property:sys.andr36oid.usbdrive.controller=1
    setprop sys.andr36oid.usbdrive.controller 0
    setprop sys.andr36oid.usbdrive.request stop
    start andr36oid-usb-drive

on property:init.svc.andr36oid-controller=stopped
    setprop sys.andr36oid.usbdrive.ready 0

on property:sys.andr36oid.usbdrive.scan=start
    start andr36oid-usb-drive

on early-init
    # Full CPU clock while starting: the kernel picks schedutil, which climbs slowly through
    # a start that is mostly short bursts. sys.boot_completed hands it back to schedutil.
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "performance"

    # Screen settings of the console, from its BOOT profile's boot script (one image
    # for every console, see r36s BOOT/Devices). Set before SurfaceFlinger starts;
    # ro properties, so only the first value counts.
    setprop ro.surface_flinger.primary_display_orientation ${ro.boot.sf_orientation:-ORIENTATION_0}
   
    # mount debugfs
    mount debugfs /sys/kernel/debug /sys/kernel/debug mode=755
    chmod 755 /sys/kernel/debug
    chmod 755 /sys/kernel/debug/sync
    
    # Change ownership of sw_sync node
    chown graphics graphics /sys/kernel/debug/sync/sw_sync
    chmod 777 /sys/kernel/debug/sync/sw_sync
    chown graphics graphics /sys/kernel/debug/sync/info

    # Vop bandwidth for ddr dvfs
    chown system system /sys/class/devfreq/dmc/vop_bandwidth
    chmod 0660 /sys/class/devfreq/dmc/vop_bandwidth

    # Screen density per DTB: the 720x720 DTBs set ro.boot.lcd_density (200)
    # in /firmware/android. ro.sf.lcd_density (178, build.prop) is already
    # set and can't change, so use qemu.sf.lcd_density, the override that
    # SurfaceFlinger and DisplayMetrics read first. Other DTBs: 178, the same
    # as TARGET_SCREEN_DENSITY in r36s/BoardConfig.mk (keep the two equal).
    setprop qemu.sf.lcd_density ${ro.boot.lcd_density:-178}


# Kernel Tweaks > Full clock while starting, off: back to schedutil at once
on early-init && property:ro.boot.andr36oid_boot_boost=0
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "schedutil"

on init

    symlink /etc/firmware /vendor/firmware
    symlink /lib/firmware /vendor/firmware
  
    setprop sys.init_log_level 8

    # disable cursor blink for fbcon, if no splash screen support
    write /sys/class/graphics/fbcon/cursor_blink 0
        
    setprop init.svc.console stopped
    
    write /sys/fs/cgroup/memory.use_hierarchy 1

    # disable transparent huge pages
    write /sys/kernel/mm/transparent_hugepage/enabled "never"
    # khugepaged starts before init (THP is "madvise" in the defconfig) and raises
    # min_free_kbytes to 36864 (18 free 2MB pageblocks for huge pages). Turning
    # THP off above does not lower it again, so the kernel kept ~58MB free at all times.
    # 12MB is still 3x the kernel's own default for 1GB and gives ~24MB back to apps.
    write /proc/sys/vm/min_free_kbytes 12288

    # Prefer swapping anon pages to zram over dropping file cache.
    # 4.19 caps swappiness at 100, anything higher is rejected.
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/page-cluster  0
    write /sys/block/zram0/comp_algorithm lz4

    # Chmod/chown specific sys entry
    chown system system /sys/class/backlight/backlight/brightness
    chmod 0660 /sys/class/backlight/backlight/brightness

    # Display color table (kernel VOP color_lut): Night Light and extra dim
    # without GPU composition (frameworks/base DisplayTransformManager)
    chown system system /sys/devices/platform/ff460000.vop/color_lut
    chmod 0660 /sys/devices/platform/ff460000.vop/color_lut

    chown root root /sys/class/devfreq/dmc/system_status
    chmod 0666 /sys/class/devfreq/dmc/system_status

on fs
   # /dev/block/by-name so that we can use the same fstabs everywhere.
   # symlink /dev/block/platform/ff370000.dwmmc/by-name /dev/block/by-name

    # Start HW service manager early
    start hwservicemanager
    
    # No fstab path: Android picks fstab.<androidboot.fstab_suffix>, else fstab.rk30board.
    # An install on the built-in eMMC has its own (fstab.emmc, set by its boot.ini).
    mount_all --early
    
on late-fs
    # Start services for bootanim
    start servicemanager
    start hwcomposer-2-1
    start gralloc-2-0
    start surfaceflinger
    start bootanim

    # First start on a fresh card: add userdata and EASYROMS before /data is mounted
    # (/system/etc/andr36oid-firstresize.sh). It runs after bootanim is started, so the
    # boot animation shows "Resizing SD card ..." under the logo meanwhile.
    exec - root root -- /system/bin/sh /system/etc/andr36oid-firstresize.sh

    # An eMMC install with Android's data on an SD card (androidboot.datacard): wait
    # for that card in either slot and link it as /dev/block/by-name/a36data for
    # fstab.emmcsd. Exits at once without a data card; turns off after 3 minutes.
    exec - root root -- /system/bin/andr36oid-datacard

    # Publish the boot/data card's EASYROMS before the public volumes are mounted
    exec - root root -- /system/bin/sh /system/etc/andr36oid-easyroms.sh

    # Mount RW partitions which need run fsck    
    mount_all --late
    
    # set RLIMIT_MEMLOCK to 8MB
    setrlimit 8 8388608 8388608

    # boot time fs tune
    # I/O counters on for the SD card (this kernel starts with them off), so
    # /sys/block/mmcblk0/stat, storaged and dumpsys diskstats show what is written to it
    write /sys/block/mmcblk0/queue/iostats 1
    # and the built-in eMMC (mmcblk2), else the power menu's eMMC graph stays at zero
    write /sys/block/mmcblk2/queue/iostats 1
    write /sys/block/mmcblk0/queue/scheduler mq-deadline
    write /sys/block/mmcblk0/queue/iosched/slice_idle 0
    write /sys/block/mmcblk0/queue/rotational 0    
    write /sys/block/mmcblk0/queue/read_ahead_kb 2048
    write /sys/block/mmcblk0/bdi/read_ahead_kb 2048
    write /sys/block/mmcblk0/queue/nr_requests 256

    #insmod /vendor/lib/modules/wlan.ko
    insmod /vendor/lib/modules/btintel.ko
    insmod /vendor/lib/modules/btbcm.ko
    insmod /vendor/lib/modules/btrtl.ko
    # No USB autosuspend for Bluetooth dongles: cheap CSR/Realtek clones often
    # fail to wake up again on this OTG port, and a suspended dongle adds a
    # resume delay to the first packet (pad connect, headphone play).
    insmod /vendor/lib/modules/btusb.ko enable_autosuspend=0
    insmod /vendor/lib/modules/ath3k.ko
    insmod /vendor/lib/modules/bcm203x.ko
    insmod /vendor/lib/modules/bpa10x.ko
    insmod /vendor/lib/modules/bfusb.ko
    
on post-fs-data
    # /data is formatted and mounted: the boot animation drops "Resizing SD card ..."
    setprop sys.andr36oid.resizing 0

    # Storage through sdcardfs instead of FUSE: with FUSE every file read and write on
    # the cards (ROMs, saves) goes through MediaProvider, whose CPU time then shows up as
    # "Media Storage" battery use. init.rc sets persist.sys.fuse true in this same trigger
    # and runs first; StorageManagerService reboots when the settings flag disagrees with
    # it, so both are set.
    setprop persist.sys.fuse false
    setprop persist.sys.fflag.override.settings_fuse false

    # Full logcat dump is debug only: setprop persist.vendor.logger.enable 1

    # Create directory for hostapd
    mkdir /data/hostapd 0770 system wifi

    # Create /data/time folder for time-services
    mkdir /data/time/ 0700 system system

    mkdir /data/audio/ 0770 media audio

    # Bluetooth
    #setprop ro.bt.bdaddr_path "system/etc/bt/bd_addr.txt"
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/type

    # Set indication (checked by vold) that we have finished this action
    setprop vold.post_fs_data_done 1

# Persistent properties are loaded by the core action first. exec waits here,
# in init's default mount namespace, before the queued zygote-start event.
# late-fs already published EASYROMS, which hotfixes read before vold mounts it.
on load_persist_props_action
    exec - root root system -- /system/bin/sh /system/etc/andr36oid-hotfix.sh
    setprop sys.andr36oid.hotfix.applying 0

on property:sys.boot_completed=1
    setprop persist.andr36oid.hotfix.tries 0

on zygote-start

    # Create the directories used by the Wireless subsystem
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

on boot
      
    # Settings > CPU overclock switches the boost OPPs, the kernel starts with them off
    chown root system /sys/devices/system/cpu/cpufreq/boost
    chmod 0664 /sys/devices/system/cpu/cpufreq/boost
    chown root system /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    # Settings > Performance profiles set the lowest and highest CPU and GPU speeds
    chown root system /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chown root system /sys/class/devfreq/ff400000.gpu/min_freq
    chmod 0664 /sys/class/devfreq/ff400000.gpu/min_freq
    chown root system /sys/class/devfreq/ff400000.gpu/max_freq
    chmod 0664 /sys/class/devfreq/ff400000.gpu/max_freq
    # Performance also holds the memory clock at its top speed
    chown root system /sys/class/devfreq/dmc/min_freq
    chmod 0664 /sys/class/devfreq/dmc/min_freq
    # Settings > Performance > Memory overclock raises it above the stock top
    chown root system /sys/class/devfreq/dmc/max_freq
    chmod 0664 /sys/class/devfreq/dmc/max_freq
    # Settings > Performance > CPU undervolt, the kernel resets it on every boot
    chown root system /sys/module/rockchip_cpufreq/parameters/undervolt_uv
    chmod 0664 /sys/module/rockchip_cpufreq/parameters/undervolt_uv
    # Settings > Display > Black frame insertion (BlackFrameInsertion app), off on every boot
    chown root system /sys/module/rockchipdrm/parameters/bfi
    chmod 0664 /sys/module/rockchipdrm/parameters/bfi

    chown system system /sys/class/thermal/thermal_zone0/policy
    chown system system /sys/class/thermal/thermal_zone1/policy
    chown system system /sys/class/thermal/thermal_zone2/policy

    # Kernel Tweaks from ktweak
    	# Limit max perf event processing time to this much CPU usage
    	write /proc/sys/kernel/perf_cpu_time_max_percent 5
	write /proc/sys/kernel/randomize_va_space 0
	# Execute child process before parent after fork	
	write /proc/sys/kernel/sched_child_runs_first 1
	write /proc/sys/kernel/sched_rt_runtime_us 1000000
	write /proc/sys/kernel/timer_migration 0

	# Net
	# Enable Explicit Congestion Control
	write /proc/sys/net/ipv4/tcp_ecn 1
	# Enable fast socket open for receiver and sender
	write /proc/sys/net/ipv4/tcp_fastopen 3
	write /proc/sys/net/ipv4/tcp_slow_start_after_idle 0
	# Disable SYN cookies
	write /proc/sys/net/ipv4/tcp_syncookies 0
	write /proc/sys/net/ipv4/tcp_timestamps 0

    	# VM
    	# Laptop mode holds back writeback for spinning disks. Off lets the SD card flush early and in smaller bursts
    	write proc/sys/vm/laptop_mode 0
    	write proc/sys/vm/compact_unevictable_allowed 0  
    	# Start non-blocking writeback later  	
    	write proc/sys/vm/dirty_background_ratio 10
    	# Start blocking writeback later
    	write proc/sys/vm/dirty_ratio 30
    	# Require dirty memory to stay in memory for longer
    	write proc/sys/vm/dirty_expire_centisecs 3000
    	# Run the dirty memory flusher threads less often
    	write proc/sys/vm/dirty_writeback_centisecs 500
   	write proc/sys/vm/extfrag_threshold 750
    	write proc/sys/vm/oom_dump_tasks 0
    	# Disable read-ahead for swap devices
    	write proc/sys/vm/page-cluster 0
    	# Update /proc/stat less often to reduce jitter
    	#write proc/sys/vm/stat_interval 120
    	# Allow more inodes and dentries to be cached
    	write proc/sys/vm/vfs_cache_pressure 200
    	write proc/sys/vm/watermark_scale_factor 100

	# Disable unnecessary printk logging
	write /proc/sys/kernel/printk_devkmsg off

    # add a cpuset for the camera daemon
    # we want all the little cores for camera
    mkdir /dev/cpuset/camera-daemon
    write /dev/cpuset/camera-daemon/cpus 0
    write /dev/cpuset/camera-daemon/mems 0
    chown system system /dev/cpuset/camera-daemon
    chown system system /dev/cpuset/camera-daemon/tasks
    chmod 0664 /dev/cpuset/camera-daemon/tasks

    # end boot time fs tune
    write /sys/block/sda/queue/read_ahead_kb 2048
    write /sys/block/sda/queue/nr_requests 256
    write /sys/block/sda/queue/iostats 0
    write /sys/block/mmcblk0/queue/iostats 1
    write /sys/block/mmcblk0/queue/read_ahead_kb 512
    write /sys/block/mmcblk0/queue/nr_requests 2048
    write /sys/block/mmcblk0/queue/add_random 0 
    # Cap each discard at 128MB, as AOSP init.rc asks for mmcblk0. One big SD erase blocks all reads until it ends
    write /sys/block/mmcblk0/queue/discard_max_bytes 134217728
    # Second card slot (ROMs on TF2): same read-ahead as the boot card instead of the 128KB kernel default
    write /sys/block/mmcblk1/queue/read_ahead_kb 512
    write /sys/block/mmcblk1/queue/iostats 1
    write /sys/block/mmcblk1/queue/add_random 0
    # Built-in eMMC (mmcblk2), the system disk on an eMMC install: the same as the boot card
    write /sys/block/mmcblk2/queue/read_ahead_kb 512
    write /sys/block/mmcblk2/queue/iostats 1
    write /sys/block/mmcblk2/queue/add_random 0
  
    trigger sys-boot-completed-set
    
on sys-boot-completed-set
   # Enable ZRAM on boot_complete
    swapon_all

on configure-cpuset
    # update cpusets feature nodes for rk3326 tablet 
    write /dev/cpuset/foreground/cpus 0-3

    # restricted is for system tasks that are being throttled
    # due to screen off.    
    write /dev/cpuset/restricted/cpus 0-1
    
    # top-app gets all cpus
    write /dev/cpuset/top-app/cpus 0-3

    #background contains a small subset (generally one little core)
    write /dev/cpuset/background/cpus 0

    # add system-background cpuset, a new cpuset for system services
    # that should not run on larger cores
    # system-background is for system tasks that should only run on
    # little cores, not on bigs to be used only by init
    write /dev/cpuset/system-background/cpus 0-2

on property:sys.boot_completed=1
   trigger configure-cpuset
    chown root system /sys/class/devfreq/ff400000.gpu/governor
    chmod 0664 /sys/class/devfreq/ff400000.gpu/governor
    chown root system /sys/class/devfreq/ff400000.gpu/min_freq
    chmod 0664 /sys/class/devfreq/ff400000.gpu/min_freq
    chown root system /sys/class/devfreq/ff400000.gpu/max_freq
    chmod 0664 /sys/class/devfreq/ff400000.gpu/max_freq

on property:sys.boot_completed=1
    # Back from the start's performance governor (early-init) to schedutil
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "schedutil"
    # The rockchip cpufreq driver keeps governor settings per policy, so the knobs are
    # under policy0/schedutil (the old cpufreq/schedutil path does not exist).
    # Without this schedutil waits 10 ms (40 us DT latency x 1000) between speed changes.
    # Step up after 1 ms so a game gets the clock fast; step down after 10 ms as before.
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us 1000
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us 10000
    # Give the app on screen (top-app) a 10% schedtune boost, like Pixel 2/3 do.
    # schedutil then clocks up sooner for the game or menu in front.
    write /dev/stune/top-app/schedtune.boost 10

service usb_modeswitch /vendor/bin/usb_modeswitch -KW -v 0bda -p 1a2b
    class main
    oneshot

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
     -g@android:wpa_wlan0
     interface android.hardware.wifi.supplicant@1.0::ISupplicant default
     interface android.hardware.wifi.supplicant@1.1::ISupplicant default
     socket wpa_wlan0 dgram 660 wifi wifi
     class main
     disabled
     oneshot

# Settings > Calibrate sticks: per-axis ends and middle ("off" = factory settings) and the
# round dead zone in %, for the odroidgo3-joypad driver. Also runs at boot when the saved
# values are loaded. Kernels without the files just log a failed write.
on property:persist.andr36oid.stick_deadzone=*
    write /sys/devices/platform/odroidgo3-joypad/stick_deadzone ${persist.andr36oid.stick_deadzone}

on property:persist.andr36oid.stick_cal=*
    write /sys/devices/platform/odroidgo3-joypad/stick_cal ${persist.andr36oid.stick_cal}

# Settings > Controls > Rumble strength, 0-100 % of what a game asks for (0: off)
on property:persist.andr36oid.rumble_strength=*
    write /sys/devices/platform/odroidgo3-joypad/rumble_strength ${persist.andr36oid.rumble_strength}

# Settings > Battery > Deep sleep: the firmware's sleep steps and wake-up sources
# ("default" = the DTB's). Also runs at boot when the saved values are loaded.
on property:persist.andr36oid.sleep_mode=*
    write /sys/module/rockchip_pm_config/parameters/sleep_mode ${persist.andr36oid.sleep_mode}

on property:persist.andr36oid.sleep_wakeup=*
    write /sys/module/rockchip_pm_config/parameters/sleep_wakeup ${persist.andr36oid.sleep_wakeup}

# Settings > Display > Status light ("default" = the DTB's). A new colour table resets
# the other settings in the driver, so they are written again after it.
on property:persist.andr36oid.led.table=*
    write /sys/devices/platform/andr36oid-status-led/table ${persist.andr36oid.led.table}
    write /sys/devices/platform/andr36oid-status-led/battery ${persist.andr36oid.led.battery}
    write /sys/devices/platform/andr36oid-status-led/charging ${persist.andr36oid.led.charging}
    write /sys/devices/platform/andr36oid-status-led/full ${persist.andr36oid.led.full}
    write /sys/devices/platform/andr36oid-status-led/mode ${persist.andr36oid.led.mode}

on property:persist.andr36oid.led.battery=*
    write /sys/devices/platform/andr36oid-status-led/battery ${persist.andr36oid.led.battery}

on property:persist.andr36oid.led.charging=*
    write /sys/devices/platform/andr36oid-status-led/charging ${persist.andr36oid.led.charging}

on property:persist.andr36oid.led.full=*
    write /sys/devices/platform/andr36oid-status-led/full ${persist.andr36oid.led.full}

on property:persist.andr36oid.led.mode=*
    write /sys/devices/platform/andr36oid-status-led/mode ${persist.andr36oid.led.mode}

# Deep sleep page: switch the cores' idle states off while running ("1" = off).
# state1 is core power-down, state2 cluster power-down (px30.dtsi).
on property:persist.andr36oid.idle_core_off=*
    write /sys/devices/system/cpu/cpu0/cpuidle/state1/disable ${persist.andr36oid.idle_core_off}
    write /sys/devices/system/cpu/cpu1/cpuidle/state1/disable ${persist.andr36oid.idle_core_off}
    write /sys/devices/system/cpu/cpu2/cpuidle/state1/disable ${persist.andr36oid.idle_core_off}
    write /sys/devices/system/cpu/cpu3/cpuidle/state1/disable ${persist.andr36oid.idle_core_off}

on property:persist.andr36oid.idle_cluster_off=*
    write /sys/devices/system/cpu/cpu0/cpuidle/state2/disable ${persist.andr36oid.idle_cluster_off}
    write /sys/devices/system/cpu/cpu1/cpuidle/state2/disable ${persist.andr36oid.idle_cluster_off}
    write /sys/devices/system/cpu/cpu2/cpuidle/state2/disable ${persist.andr36oid.idle_cluster_off}
    write /sys/devices/system/cpu/cpu3/cpuidle/state2/disable ${persist.andr36oid.idle_cluster_off}

on property:persist.vendor.logger.enable=1
    start logger

# Settings > Battery > Battery details > Battery capacity, in mAh; 0 is the device tree's value.
# Also runs at boot when the saved value is loaded. Kernels without the knob just log a failed write.
on property:persist.andr36oid.battery_capacity=*
    write /sys/class/power_supply/battery/device/design_capacity_mah ${persist.andr36oid.battery_capacity}

# Settings > Battery > Battery details > Charge limit, in %; 0 is off (charge to 100 %).
# The kernel stops charging at the limit and starts again 5 points below it.
on property:persist.andr36oid.charge_limit=*
    write /sys/class/power_supply/battery/device/charge_limit_percent ${persist.andr36oid.charge_limit}

# Settings > Battery > Battery details > Charging speed, in mA; 0 is the console's default
# from its device tree. Above the default the kernel lets the charger input draw more too.
on property:persist.andr36oid.charge_current=*
    write /sys/class/power_supply/ac/device/charge_current_ma ${persist.andr36oid.charge_current}

# Settings > Battery > Battery details > Deep sleep. Off: the console only idles with the
# screen off (s2idle) instead of powering down through the firmware, for consoles that
# sometimes don't wake up. Unset is the kernel's default, deep.
on property:persist.andr36oid.deep_sleep=0
    write /sys/power/mem_sleep s2idle

on property:persist.andr36oid.deep_sleep=1
    write /sys/power/mem_sleep deep

# Keep logging to the saved kernel log (pstore) through sleep and note each device's suspend
# and resume, so the log after a console that didn't wake up shows the step it hung in
on boot
    write /sys/module/printk/parameters/console_suspend N
    write /sys/power/pm_print_times 1

service logger /system/bin/logcat -b all -D -f /boot/logcat.txt
	class main
	user root
    group root system
    disabled
    oneshot

# RGB lights (RgbLights app, R36 Ultra only). The LEDs exist only in that DTB;
# elsewhere the property is never set, and the writes would fail harmlessly.
on property:persist.sys.rgb_lights=off
    write /sys/class/leds/red:status/brightness 0
    write /sys/class/leds/green:status/brightness 0
    write /sys/class/leds/blue:status/brightness 0

on property:persist.sys.rgb_lights=red
    write /sys/class/leds/red:status/brightness 1
    write /sys/class/leds/green:status/brightness 0
    write /sys/class/leds/blue:status/brightness 0

on property:persist.sys.rgb_lights=green
    write /sys/class/leds/red:status/brightness 0
    write /sys/class/leds/green:status/brightness 1
    write /sys/class/leds/blue:status/brightness 0

on property:persist.sys.rgb_lights=blue
    write /sys/class/leds/red:status/brightness 0
    write /sys/class/leds/green:status/brightness 0
    write /sys/class/leds/blue:status/brightness 1

on property:persist.sys.rgb_lights=yellow
    write /sys/class/leds/red:status/brightness 1
    write /sys/class/leds/green:status/brightness 1
    write /sys/class/leds/blue:status/brightness 0

on property:persist.sys.rgb_lights=cyan
    write /sys/class/leds/red:status/brightness 0
    write /sys/class/leds/green:status/brightness 1
    write /sys/class/leds/blue:status/brightness 1

on property:persist.sys.rgb_lights=purple
    write /sys/class/leds/red:status/brightness 1
    write /sys/class/leds/green:status/brightness 0
    write /sys/class/leds/blue:status/brightness 1

on property:persist.sys.rgb_lights=white
    write /sys/class/leds/red:status/brightness 1
    write /sys/class/leds/green:status/brightness 1
    write /sys/class/leds/blue:status/brightness 1
# Screen density of the console's BOOT profile (e.g. R46H), the Android default otherwise
on property:ro.boot.lcd_density=*
    setprop ro.sf.lcd_density ${ro.boot.lcd_density}

# andr36oid: the sleep watchdog also watches the shutdown. One that hangs (black screen,
# console still on) dumps the cores to the crash log and restarts instead of staying on
# until the battery is flat. See andr36oid_sleep_wdt.c.
on shutdown
    write /sys/module/andr36oid_sleep_wdt/parameters/shutdown_watch 1

# Kernel Tweaks > Storage layer set to FUSE (androidboot.storage_fuse=1 from
# kernel-tweaks.txt): Android's own FUSE storage again. Runs after the action above.
on post-fs-data && property:ro.boot.storage_fuse=1
    setprop persist.sys.fuse true
    setprop persist.sys.fflag.override.settings_fuse true
